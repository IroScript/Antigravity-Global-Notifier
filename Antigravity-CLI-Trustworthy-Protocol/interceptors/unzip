#!/usr/bin/env python3
"""
Python-based unzip compatibility wrapper for Flutter
"""
import sys
import os
import zipfile

def main():
    args = sys.argv[1:]
    dest = "."
    zip_file = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-o", "-q", "-v", "-l", "-u"):
            i += 1
        elif arg == "-d" and i + 1 < len(args):
            dest = args[i + 1]
            i += 2
        elif not zip_file and not arg.startswith("-"):
            zip_file = arg
            i += 1
        else:
            i += 1

    if not zip_file or not os.path.exists(zip_file):
        sys.stderr.write(f"unzip: cannot find or open {zip_file}\n")
        sys.exit(1)

    os.makedirs(dest, exist_ok=True)
    with zipfile.ZipFile(zip_file, "r") as zf:
        for member in zf.infolist():
            zf.extract(member, dest)
            mode = (member.external_attr >> 16) & 0o777
            if mode:
                out_path = os.path.join(dest, member.filename)
                if os.path.exists(out_path) and not os.path.islink(out_path):
                    try:
                        os.chmod(out_path, mode)
                    except Exception:
                        pass

    sys.exit(0)

if __name__ == "__main__":
    main()
