[Unit]
Description=Cloudflare Tunnel for Windows 11 Azure File Explorer
After=network.target azure-file-explorer.service

[Service]
Type=simple
WorkingDirectory=/home/azureuser/IrakIroan/azure_file_explorer
ExecStart=/bin/bash /home/azureuser/IrakIroan/azure_file_explorer/start_tunnel.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
