[Unit]
Description=Cloudflare Tunnel for Windows 11 Azure File Explorer
After=network.target azure-file-explorer.service

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/IroScript_Projects/Whatsapp_Agy_Agents/Antigravity-Global-Notifier/Cloud_VM_Live_Preview
ExecStart=/bin/bash /home/azureuser/IroScript_Projects/Whatsapp_Agy_Agents/Antigravity-Global-Notifier/Cloud_VM_Live_Preview/start_tunnel.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
