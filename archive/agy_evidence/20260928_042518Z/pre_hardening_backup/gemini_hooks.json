{
  "boundary-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/azureuser/AGY-MASTER/POLICIES/delete_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "completion-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "/usr/bin/python3 /home/azureuser/.agents/hooks/completion_gate_stop_hook.py",
        "timeout": 10
      }
    ]
  }
}