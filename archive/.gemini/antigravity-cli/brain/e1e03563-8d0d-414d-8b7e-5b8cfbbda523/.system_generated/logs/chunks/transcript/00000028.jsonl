✅ Saved: {s_path.name} ({s_cnt} rows)\")\n96:     \n97:     kw_path = EXPORTS_DIR / f\"seo_keywords_{TS}.csv\"\n98:     kw_cnt = export_query_to_csv(cur, \"SELECT * FROM seo_keyword_metrics\", kw_path)\n99:     print(f\"  ✅ Saved: {kw_path.name} ({kw_cnt} rows)\")\n100:     \n101:     comp_path = EXPORTS_DIR / f\"seo_competitors_{TS}.csv\"\n102:     comp_cnt = export_query_to_csv(cur, \"SELECT * FROM seo_competitors\", comp_path)\n103:     print(f\"  ✅ Saved: {comp_path.name} ({comp_cnt} rows)\")\n104:     \n105:     # 4. Master Dashboard CSV (One row per idea)\n106:     print(\">>> [4/4] Generating Master Dashboard CSV...\")\n107:     dashboard_query = \"\"\"\n108:     SELECT \n109:         i.id AS idea_id,\n110:         i.title AS idea_title,\n111:         e.id AS element_id,\n112:         e.name AS element_name,\n113:         e.group_type AS element_group,\n114:         i.status AS idea_status,\n115:         COUNT(DISTINCT p.id) AS prompt_count,\n116:         MAX(CASE WHEN p.prompt_type = 'video_prompt' AND p.level = 10 THEN 1 ELSE 0 END) AS has_level_10_video,\n117:         CASE WHEN ym.id IS NOT NULL THEN 1 ELSE 0 END AS has_seo,\n118:         ym.title AS seo_title,\n119:         ym.tags AS seo_tags,\n120:         i.created_at AS idea_created_at\n121:     FROM ideas i\n122:     LEFT JOIN idea_elements ie ON ie.idea_id = i.id\n123:     LEFT JOIN elements e ON e.id = ie.element_id\n124:     LEFT JOIN prompts p ON p.idea_id = i.id\n125:     LEFT JOIN youtube_metadata ym ON ym.idea_id = i.id\n126:     GROUP BY i.id\n127:     ORDER BY i.id ASC\n128:     \"\"\"\n129:     d_path = EXPORTS_DIR / f\"master_dashboard_{TS}.csv\"\n130:     d_cnt = export_query_to_csv(cur, dashboard_query, d_path)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
