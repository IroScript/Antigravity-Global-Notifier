CT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'\")\n38:     tables = [r[0] for r in cur.fetchall()]\n39:     for t in tables:\n40:         export_query_to_csv(cur, f\"SELECT * FROM `{t}`\", CSV_TABLES_DIR / f\"\n<truncated 410 bytes>\ne,\n52:         e.group_type AS element_group,\n53:         p.prompt_type,\n54:         p.level,\n55:         p.level_name,\n56:         p.structure_type,\n57:         p.version,\n58:         p.status AS prompt_status,\n59:         p.created_at AS prompt_created_at,\n60:         p.prompt_text\n61:     FROM prompts p\n62:     LEFT JOIN ideas i ON i.id = p.idea_id\n63:     LEFT JOIN idea_elements ie ON ie.idea_id = p.idea_id\n64:     LEFT JOIN elements e ON e.id = ie.element_id\n65:     ORDER BY p.id ASC\n66:     \"\"\"\n67:     p_path = EXPORTS_DIR / f\"master_prompts_from_db_{TS}.csv\"\n68:     p_cnt = export_query_to_csv(cur, prompts_query, p_path)\n69:     print(f\"  ✅ Saved: {p_path.name} ({p_cnt} rows)\")\n70:     \n71:     # 3. SEO Master, Keywords, Competitors\n72:     print(\">>> [3/4] Generating Real SEO Master, Keywords & Competitors CSVs...\")\n73:     seo_query = \"\"\"\n74:     SELECT \n75:         ym.id AS seo_id,\n76:         ym.idea_id,\n77:         i.title AS idea_title,\n78:         ym.element_id,\n79:         e.name AS element_name,\n80:         ym.title AS seo_title,\n81:         ym.seo_description,\n82:         ym.tags AS seo_tags,\n83:         ym.category AS seo_category,\n84:         ym.status AS seo_status,\n85:         ym.upload_status,\n86:         ym.created_at,\n87:         ym.updated_at\n88:     FROM youtube_metadata ym\n89:     LEFT JOIN ideas i ON i.id = ym.idea_id\n90:     LEFT JOIN elements e ON e.id = ym.element_id\n91:     ORDER BY ym.id ASC\n92:     \"\"\"\n93:     s_path = EXPORTS_DIR / f\"seo_master_{TS}.csv\"\n94:     s_cnt = export_query_to_csv(cur, seo_query, s_path)\n95:     print(f\"  ✅ Saved: {s_path.name} ({s_cnt} rows)\")\n96:     \n97:     kw_path = EXPORTS_DIR / f\"seo_keywords_{TS}.csv\"\n98:     kw_cnt = export_query_to_csv(cur, \"SELECT * FROM seo_keyword_metrics\", kw_path)\n99:     print(f\"  ✅ Saved: {kw_path.name} ({kw_cnt} rows)\")\n100:     \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
