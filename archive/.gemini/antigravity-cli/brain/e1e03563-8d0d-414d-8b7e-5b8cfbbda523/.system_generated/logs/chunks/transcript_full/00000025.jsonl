{"step_index":11167,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-26T03:31:01Z","content":"Created At: 2026-09-26T03:31:01Z\nCompleted At: 2026-09-26T03:31:01Z\nFile Path: `file:///home/azureuser/.openclaw/workspace/IROSCRIPT-CEO/social-media/youtube/Youtube%20Automation/PromptDatabase/generate_all_csvs.py`\nTotal Lines: 159\nTotal Bytes: 5762\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: import os\n3: import sys\n4: import csv\n5: import sqlite3\n6: from pathlib import Path\n7: \n8: BASE_DIR = Path(__file__).resolve().parent\n9: DB_PATH = BASE_DIR / \"database\" / \"youtube_pipeline.db\"\n10: EXPORTS_DIR = BASE_DIR / \"exports\"\n11: EXPORTS_DIR.mkdir(parents=True, exist_ok=True)\n12: CSV_TABLES_DIR = EXPORTS_DIR / \"csv_tables\"\n13: CSV_TABLES_DIR.mkdir(parents=True, exist_ok=True)\n14: \n15: TS = \"26_sept_03.30_am\"\n16: \n17: def export_query_to_csv(cur, query, target_path):\n18:     cur.execute(query)\n19:     headers = [col[0] for col in cur.description]\n20:     rows = cur.fetchall()\n21:     with open(target_path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n22:         writer = csv.writer(f)\n23:         writer.writerow(headers)\n24:         writer.writerows(rows)\n25:     return len(rows)\n26: \n27: def main():\n28:     print(\"============================================================================\")\n29:     print(f\"        📊 MASTER UNIFIED CSV EXPORT GENERATOR [{TS}]\")\n30:     print(\"============================================================================\")\n31:     \n32:     conn = sqlite3.connect(DB_PATH)\n33:     cur = conn.cursor()\n34:     \n35:     # 1. Export raw tables\n36:     print(\">>> [1/4] Generating Raw Table CSVs...\")\n37:     cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'\")\n38:     tables = [r[0] for r in cur.fetchall()]\n39:     for t in tables:\n40:         export_query_to_csv(cur, f\"SELECT * FROM `{t}`\", CSV_TABLES_DIR / f\"{t}.csv\")\n41:     print(f\"  ✅ Saved {len(tables)} raw tables into: exports/csv_tables/\")\n42:     \n43:     # 2. Master Prompts Hierarchy CSV\n44:     print(\">>> [2/4] Generating Master Prompts Hierarchy CSV...\")\n45:     prompts_query = \"\"\"\n46:     SELECT \n47:         p.id AS prompt_id,\n48:         p.idea_id,\n49:         i.title AS idea_title,\n50:         e.id AS element_id,\n51:         e.name AS element_name,\n52:         e.group_type AS element_group,\n53:         p.prompt_type,\n54:         p.level,\n55:         p.level_name,\n56:         p.structure_type,\n57:         p.version,\n58:         p.status AS prompt_status,\n59:         p.created_at AS prompt_created_at,\n60:         p.prompt_text\n61:     FROM prompts p\n62:     LEFT JOIN ideas i ON i.id = p.idea_id\n63:     LEFT JOIN idea_elements ie ON ie.idea_id = p.idea_id\n64:     LEFT JOIN elements e ON e.id = ie.element_id\n65:     ORDER BY p.id ASC\n66:     \"\"\"\n67:     p_path = EXPORTS_DIR / f\"master_prompts_from_db_{TS}.csv\"\n68:     p_cnt = export_query_to_csv(cur, prompts_query, p_path)\n69:     print(f\"  ✅ Saved: {p_path.name} ({p_cnt} rows)\")\n70:     \n71:     # 3. SEO Master, Keywords, Competitors\n72:     print(\">>> [3/4] Generating Real SEO Master, Keywords & Competitors CSVs...\")\n73:     seo_query = \"\"\"\n74:     SELECT \n75:         ym.id AS seo_id,\n76:         ym.idea_id,\n77:         i.title AS idea_title,\n78:         ym.element_id,\n79:         e.name AS element_name,\n80:         ym.title AS seo_title,\n81:         ym.seo_description,\n82:         ym.tags AS seo_tags,\n83:         ym.category AS seo_category,\n84:         ym.status AS seo_status,\n85:         ym.upload_status,\n86:         ym.created_at,\n87:         ym.updated_at\n88:     FROM youtube_metadata ym\n89:     LEFT JOIN ideas i ON i.id = ym.idea_id\n90:     LEFT JOIN elements e ON e.id = ym.element_id\n91:     ORDER BY ym.id ASC\n92:     \"\"\"\n93:     s_path = EXPORTS_DIR / f\"seo_master_{TS}.csv\"\n94:     s_cnt = export_query_to_csv(cur, seo_query, s_path)\n95:     print(f\"  ✅ Saved: {s_path.name} ({s_cnt} rows)\")\n96:     \n97:     kw_path = EXPORTS_DIR / f\"seo_keywords_{TS}.csv\"\n98:     kw_cnt = export_query_to_csv(cur, \"SELECT * FROM seo_keyword_metrics\", kw_path)\n99:     print(f\"  ✅ Saved: {kw_path.name} ({kw_cnt} rows)\")\n100:     \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
