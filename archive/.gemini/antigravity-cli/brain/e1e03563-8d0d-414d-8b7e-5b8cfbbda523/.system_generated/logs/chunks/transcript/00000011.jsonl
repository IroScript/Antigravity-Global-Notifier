oard_{TS}.csv\"\n130:     d_cnt = export_query_to_csv(cur, dashboard_query, d_path)\n131:     print(f\"  ✅ Saved: {d_path.name} ({d_cnt} ideas)\")\n132:     \n133:     # Pipeline Progress\n134:     prog_query = \"\"\"\n135:     SELECT \n136:         e.id AS element_id,\n137:         e.name AS element_name,\n138:         COUNT(DISTINCT i.id) AS ideas_count,\n139:         COUNT(DISTINCT p.id) AS prompts_count,\n140:         COUNT(DISTINCT ym.id) AS seo_count\n141:     FROM elements e\n142:     LEFT JOIN idea_elements ie ON ie.element_id = e.id\n143:     LEFT JOIN ideas i ON i.id = ie.idea_id\n144:     LEFT JOIN prompts p ON p.idea_id = i.id\n145:     LEFT JOIN youtube_metadata ym ON ym.idea_id = i.id\n146:     GROUP BY e.id\n147:     ORDER BY e.id ASC\n148:     \"\"\"\n149:     export_query_to_csv(cur, prog_query, EXPORTS_DIR / f\"pipeline_hierarchy_progress_{TS}.csv\")\n150:     export_query_to_csv(cur, \"SELECT * FROM prompting_style_master\", EXPORTS_DIR / f\"prompting_style_master_{TS}.csv\")\n151:     \n152:     conn.close()\n153:     print(\"============================================================================\")\n154:     print(f\"🎉 ALL CSV FILES SUCCESSFULLY GENERATED FOR {TS}!\")\n155:     print(\"============================================================================\")\n156: \n157: if __name__ == \"__main__\":\n158:     main()\n159: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
