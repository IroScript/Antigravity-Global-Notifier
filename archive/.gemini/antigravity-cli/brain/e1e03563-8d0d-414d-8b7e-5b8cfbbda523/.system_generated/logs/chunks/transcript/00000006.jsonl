               await safe_click(new_btn, active_page)\n438:                 await asyncio.sleep(1.5)\n439:             elif active_page.url != CHATGPT_URL and active_page.url != f\"{CHATGPT_URL}/\":\n440:                 await active_page.goto(CHATGPT_URL, wait_until=\"domcontentloaded\", timeout=45000)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
