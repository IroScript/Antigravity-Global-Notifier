               desc = idea.get(\"description\", \"\").strip()\n230:                     if not title:\n231:                         continue\n232:                     cur.execute(\n233:                         \"\"\"INSERT INTO ide\n<truncated 48 bytes>\ne, short_title, raw_idea, description, category, topic,\n235:                             language, status, priority, version, is_deleted, created_at, updated_at\n236:                         ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n237:                         (\n238:                             str(uuid.uuid4()),\n239:                             title,\n240:                             title[:50],\n241:                             desc,\n242:                             desc,\n243:                             elem_group or \"Impossible Giant Machine\",\n244:                             elem_name,\n245:                             \"en\",\n246:                             \"active\",\n247:                             10,\n248:                             1,\n249:                             0,\n250:                             now_iso,\n251:                             now_iso\n252:                         )\n253:                     )\n254:                     idea_id = cur.lastrowid\n255:                     cur.execute(\n256:                         \"INSERT INTO idea_elements (idea_id, element_id, is_primary) VALUES (?, ?, ?)\",\n257:                         (idea_id, elem_id, 1)\n258:                     )\n259:                     cnt += 1\n260:                 return cnt\n261: \n262:             inserted = execute_db_write(do_insert_ideas)\n263:             logger.info(f\"[{worker_id}] ✅ Successfully inserted {inserted} ideas for Element #{elem_id} ({elem_name})\")\n264:             return True\n265:         except Exception as e:\n266:             logger.warning(f\"[{worker_id}] Retry {attempt}/{retries} for Ideas for Element #{elem_id} ({elem_name}) via port {port}: {e}. Waiting 15s...\")\n267:             time.sleep(15)\n268: \n269:     logger.error(f\"[{worker_id}] Worker {worker_id} failed generating ideas for {elem_name}\")\n270:     return False\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
