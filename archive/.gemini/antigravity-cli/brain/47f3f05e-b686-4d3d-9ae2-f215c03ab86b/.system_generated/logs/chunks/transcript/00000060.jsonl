{"step_index":10640,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-26T13:46:36Z","content":"Created At: 2026-09-26T13:46:36Z\nCompleted At: 2026-09-26T13:46:36Z\n\nThe command exited with code 0.\nOutput:\n<truncated 1 lines>\n        pointHoverRadius: 4\r\n      }\r\n    ];\r\n  } else if (currentMode === 'ram') {\r\n    return [\r\n      {\r\n        label: 'সার্বিক RAM (GB)',\r\n        data: historyData.map(p => p.ram_gb),\r\n        borderColor: '#58a6ff',\r\n        backgroundColor: 'rgba(88, 166, 255, 0.12)',\r\n        borderWidth: 2.2,\r\n        tension: 0.3,\r\n        fill: true,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 5\r\n      },\r\n      {\r\n        label: 'শীর্ষ ১ অ্যাপ RAM (GB)',\r\n        data: historyData.map(p => p.app1 ? p.app1.ram_gb : 0),\r\n        borderColor: '#f0883e',\r\n        borderWidth: 1.6,\r\n        borderDash: [4, 4],\r\n        tension: 0.3,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 4\r\n      },\r\n      {\r\n        label: 'শীর্ষ ২ অ্যাপ RAM (GB)',\r\n        data: historyData.map(p => p.app2 ? p.app2.ram_gb : 0),\r\n        borderColor: '#2ea043',\r\n        borderWidth: 1.4,\r\n        borderDash: [2, 2],\r\n        tension: 0.3,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 4\r\n      }\r\n    ];\r\n  } else {\r\n    // Both CPU and RAM\r\n    return [\r\n      {\r\n        label: 'সার্বিক CPU %',\r\n        data: historyData.map(p => p.cpu),\r\n        borderColor: '#f0883e',\r\n        borderWidth: 2,\r\n        tension: 0.3,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 5\r\n      },\r\n      {\r\n        label: 'সার্বিক RAM %',\r\n        data: historyData.map(p => p.ram_pct),\r\n        borderColor: '#58a6ff',\r\n        borderWidth: 2,\r\n        tension: 0.3,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 5\r\n      }\r\n    ];\r\n  }\r\n}\r\n\r\nfunction renderChart() {\r\n  const ctx = document.getElementById('resourceChart').getContext('2d');\r\n  const labels = historyData.map(p => p.t);\r\n  const datasets = getDatasetsForCurrentMode();\r\n\r\n  if (chartInstance) {\r\n    chartInstance.data.labels = labels;\r\n    chartInstance.data.datasets = \n<truncated 4205 bytes>\n<span class=\"col-hdr\">২য় · RAM</span>\r\n            <span class=\"col-val-ram\">${a.ram_gb >= 1.0 ? a.ram_gb + ' GB' : a.ram_mb + ' MB'}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    `).join('');\r\n    \r\n    renderProcs();\r\n  } catch (e) {\r\n    console.error(e);\r\n  }\r\n}\r\n\r\nfunction renderProcs() {\r\n  if (!currentStats) return;\r\n  const q = document.getElementById('search-box').value.toLowerCase();\r\n  let list = [...currentStats.top_procs];\r\n  \r\n  if (q) {\r\n    list = list.filter(p => p.app.toLowerCase().includes(q) || p.name.toLowerCase().includes(q) || p.cmd.toLowerCase().includes(q));\r\n  }\r\n  \r\n  if (currentSort === 'cpu') {\r\n    list.sort((a, b) => b.cpu - a.cpu);\r\n  } else {\r\n    list.sort((a, b) => b.ram_mb - a.ram_mb);\r\n  }\r\n  \r\n  const container = document.getElementById('proc-list');\r\n  if (list.length === 0) {\r\n    container.innerHTML = '<div style=\"text-align: center; color: #8b949e; padding: 20px;\">কোনো প্রসেস পাওয়া যায়নি</div>';\r\n    return;\r\n  }\r\n  \r\n  container.innerHTML = list.map(p => `\r\n    <div class=\"proc-card\">\r\n      <div class=\"proc-top\">\r\n        <span>${p.name} <span style=\"font-size: 0.7rem; color: #8b949e;\">(PID: ${p.pid})</span></span>\r\n        <span class=\"proc-tag\">${p.app}</span>\r\n      </div>\r\n      <div class=\"proc-cmd\">${p.cmd}</div>\r\n      <div class=\"proc-metrics\">\r\n        <span>১ম কলাম · CPU: <span class=\"val-badge val-cpu\">${p.cpu}%</span></span>\r\n        <span>২য় কলাম · RAM: <span class=\"val-badge val-ram\">${p.ram_mb >= 1024 ? (p.ram_mb/1024).toFixed(2) + ' GB' : p.ram_mb + ' MB'}</span></span>\r\n      </div>\r\n    </div>\r\n  `).join('');\r\n}\r\n\r\n// Initial calls\r\nfetchStats();\r\nfetchHistory();\r\nsetInterval(fetchStats, 1500);\r\n// Refresh history graph every 5 seconds for live animation\r\nsetInterval(() => {\r\n  if (!isScrubbing && (currentRange === '1m' || currentRange === '5m' || currentRange === '15m' || currentRange === '30m')) {\r\n    fetchHistory();\r\n  }\r\n}, 3000);\r\n</script>\r\n\r\n</body>\r\n</html>\r\n\n","truncated_fields":["content"]}
