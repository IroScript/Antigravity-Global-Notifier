q = urllib.request.Request(sa['token_uri'], data=data)\n    resp = json.loads(urllib.request.urlopen(req).read())\n    return resp['access_token']\n\ndef upload_file(local_path, destination_name):\n    token = get_access_token()\n    size = os.path.getsize(local_path)\n    url = f\"https://storage.googleapis.com/upload/storage/v1/b/{BUCKET_NAME}/o?uploadType=media&name={urllib.parse.quote(destination_name, safe='')}\"\n    \n    print(f\"Uploading: {destination_name} ({size:,} bytes)...\", end=\" \", flush=True)\n    with open(local_path, \"rb\") as f:\n        data = f.read()\n    \n    req = urllib.request.Request(url, data=data, headers={\n        'Authorization': f'Bearer {token}',\n        'Content-Type': 'application/octet-stream'\n    }, method='POST')\n    \n    resp = urllib.request.urlopen(req)\n    res_json = json.loads(resp.read().decode())\n    print(f\"DONE (HTTP {resp.status}, ID: {res_json.get('id')})\")\n    return res_json\n\nif __name__ == \"__main__\":\n    import sys\n    if len(sys.argv) < 3:\n        print(\"Usage: gcs_vault_uploader.py <local_path> <destination_name>\")\n        sys.exit(1)\n    upload_file(sys.argv[1], sys.argv[2])\n","Description":"Direct REST uploader for GCS objectCreator SA","Overwrite":true,"TargetFile":"/home/azureuser/gcs_vault_uploader.py","toolAction":"Writing GCS uploader","toolSummary":"Create gcs_vault_uploader.py"}}]}
