{"step_index":9428,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-26T07:55:14Z","thinking":"Defining the core features for the live synchronization script. The script will load configuration settings and then use a utility to copy data with specific update parameters, exclusions, and transfer settings. Critically, it will operate in a safe mode, preventing data deletion. The script will run in a continuous loop with a configurable interval, logging its operations.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"#!/usr/bin/env python3\n\"\"\"\nGoogle Drive Live Sync Engine (Daemon)\nAuthor: Antigravity AI (Pair Programming with Iraq Bhai)\nTarget: Azure VM 'FatehAli'\nPurpose: Continuous, safe, real-time synchronization of VM workspaces to Google Drive.\n\"\"\"\n\nimport sys\nimport os\nimport time\nimport json\nimport subprocess\nimport signal\nfrom datetime import datetime, timezone\n\nBASE_DIR = os.path.dirname(os.path.abspath(__file__))\nCONFIG_FILE = os.path.join(BASE_DIR, \"sync_config.json\")\nLOG_FILE = os.path.join(BASE_DIR, \"live_sync.log\")\nSTATE_FILE = os.path.join(BASE_DIR, \"sync_state.json\")\nRCLONE_BIN = \"/usr/bin/rclone\"\n\nrunning = True\n\ndef signal_handler(signum, frame):\n    global running\n    log(\"Termination signal received. Shutting down gracefully...\")\n    running = False\n\nsignal.signal(signal.SIGINT, signal_handler)\nsignal.signal(signal.SIGTERM, signal_handler)\n\ndef log(msg):\n    now = datetime.now(timezone.utc).strftime(\"%Y-%m-%d %H:%M:%S UTC\")\n    line = f\"[{now}] {msg}\"\n    print(line, flush=True)\n    try:\n        with open(LOG_FILE, \"a\", encoding=\"utf-8\") as f:\n            f.write(line + \"\\n\")\n    except Exception:\n        pass\n\ndef load_config():\n    if not os.path.exists(CONFIG_FILE):\n        log(f\"Error: Config file not found at {CONFIG_FILE}\")\n        return None\n    try:\n        with open(CONFIG_FILE, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    except Exception as e:\n        log(f\"Error reading config: {e}\")\n        return None\n\ndef save_state(state):\n    try:\n        with open(STATE_FILE, \"w\", encoding=\"utf-8\") as f:\n            json.dump(state, f, indent=2)\n    except Exception as e:\n        log(f\"Failed to save state: {e}\")\n\ndef run_sync_target(target, config):\n    name = target.get(\"name\")\n    local_path = target.get(\"local_path\")\n    remote_subpath = target.get(\"remote_subpath\")\n    remote_name = config.get(\"remote_name\", \"gdrive\")\n    remote_base = config.get(\"remote_base_dir\", \"Azure_VM_LiveSync\")\n\n    if not os.path.exists(local_path):\n        log(f\"[-] Target '{name}': Local path does not exist ({local_path}). Skipping.\")\n        return False, \"Path does not exist\"\n\n    remote_dest = f\"{remote_name}:{remote_base}/{remote_subpath}\"\n\n    cmd = [\n        RCLONE_BIN,\n        \"copy\",\n        local_path,\n        remote_dest,\n        \"--update\",\n        \"--use-mtime\",\n        \"--transfers\", \"4\",\n        \"--checkers\", \"8\",\n        \"--stats-one-line\",\n        \"--log-level\", \"NOTICE\"\n    ]\n\n    for excl in config.get(\"global_excludes\", []):\n        cmd.extend([\"--exclude\", excl])\n\n    start_t = time.time()\n    try:\n        res = subprocess.run(cmd, capture_output=True, text=True, timeout=300)\n        dur = round(time.time() - start_t, 2)\n        if res.returncode == 0:\n            log(f\"[+] Target '{name}' synced successfully to {remote_dest} in {dur}s\")\n            return True, \"Success\"\n        else:\n            err = res.stderr.strip() or res.stdout.strip()\n            log(f\"[!] Target '{name}' sync returned error (code {res.returncode}): {err}\")\n            return False, err\n    except subprocess.TimeoutExpired:\n        log(f\"[!] Target '{name}' sync timed out after 300s\")\n        return False, \"Timeout\"\n    except Exception as e:\n        log(f\"[!] Target '{name}' sync execution error: {e}\")\n        return False, str(e)\n\ndef sync_cycle(config):\n    targets = [t for t in config.get(\"sync_targets\", []) if t.get(\"enabled\", True)]\n    log(f\"--- Starting Sync Cycle: {len(targets)} targets enabled ---\")\n    \n    state = {\n        \"last_cycle_start\": datetime.now(timezone.utc).isoformat(),\n        \"targets\": {}\n    }\n\n    for t in targets:\n        if not running:\n            break\n        success, info = run_sync_target(t, config)\n        state[\"targets\"][t.get(\"name\")] = {\n            \"success\": success,\n            \"status\": info,\n            \"timestamp\": datetime.now(timezone.utc).isoformat()\n        }\n\n    state[\"last_cycle_end\"] = datetime.now(timezone.utc).isoformat()\n    save_state(state)\n    log(\"--- Sync Cycle Completed ---\")\n\ndef main():\n    once = \"--once\" in sys.argv\n    log(\"Google Drive Live Sync Engine started.\")\n    \n    config = load_config()\n    if not config:\n        log(\"Fatal: Invalid or missing configuration. Exiting.\")\n        sys.exit(1)\n\n    interval = config.get(\"sync_interval_seconds\", 60)\n\n    if once:\n        sync_cycle(config)\n        log(\"Single cycle execution finished.\")\n        sys.exit(0)\n\n    log(f\"Entering continuous live sync loop (Interval: {interval} seconds).\")\n    while running:\n        config = load_config() or config\n        sync_cycle(config)\n        \n        # Sleep in small increments to respond quickly to shutdown signals\n        for _ in range(interval):\n            if not running:\n                break\n            time.sleep(1)\n\n    log(\"Live Sync Engine stopped cleanly.\")\n\nif __name__ == \"__main__\":\n    main()\n","Description":"Core Python live sync engine with multi-target syncing, excludes, robust error handling, and state logging","Overwrite":true,"TargetFile":"/home/azureuser/gdrive_sync/gdrive_live_sync.py","toolAction":"Creating live sync engine script","toolSummary":"Create gdrive_live_sync.py"}}]}
