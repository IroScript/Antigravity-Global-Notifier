{"step_index":10117,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-26T10:10:19Z","thinking":"Begin a file-by-file comparison between the Google Cloud VM backup and the active Azure VM environment. The objective is to identify files present in the backup but missing on the running system, and vice versa. Create a detailed listing documenting any discrepancies found.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"#!/usr/bin/env python3\n\"\"\"\nReconcile Google Cloud VM Backup vs Azure VM Live Files\nCompares /home/azureuser/IrakIroan/Google_Drive_Backup/Extracted files/mdkamruzzamanirak_gmail_com\nagainst /home/azureuser\n\"\"\"\n\nimport os\nimport sys\nimport hashlib\nfrom collections import defaultdict\n\nGCP_ROOT = \"/home/azureuser/IrakIroan/Google_Drive_Backup/Extracted files/mdkamruzzamanirak_gmail_com\"\nAZURE_ROOT = \"/home/azureuser\"\n\n# Folders on Azure that are Azure-specific or backup destinations (skip comparing against GCP)\nSKIP_ON_AZURE = {\n    \"IrakIroan\", \"irakiroan\", \"RESTORE_VERIFY_TEMP\", \"GDRIVE_RESTORE_TEST\",\n    \"gdrive_sync\", \"tmp\", \".cache\", \"GLOBAL-ARCHIVE\"\n}\n\ndef scan_dir(base_dir, skip_dirs=set()):\n    file_map = {} # rel_path -> size\n    for root, dirs, files in os.walk(base_dir):\n        # Filter skip dirs at top level\n        rel_root = os.path.relpath(root, base_dir)\n        top = rel_root.split(os.sep)[0] if rel_root != \".\" else \"\"\n        if top in skip_dirs:\n            dirs.clear()\n            continue\n\n        for f in files:\n            fp = os.path.join(root, f)\n            rel = os.path.relpath(fp, base_dir)\n            try:\n                if os.path.isfile(fp) and not os.path.islink(fp):\n                    file_map[rel] = os.path.getsize(fp)\n            except OSError:\n                pass\n    return file_map\n\nprint(\"Scanning Google Cloud extracted files...\")\ngcp_files = scan_dir(GCP_ROOT)\nprint(f\"GCP Files: {len(gcp_files):,}\")\n\nprint(\"Scanning Azure VM files...\")\nazure_files = scan_dir(AZURE_ROOT, SKIP_ON_AZURE)\nprint(f\"Azure Files: {len(azure_files):,}\")\n\n# Group comparison by Project / Category\nprojects = defaultdict(lambda: {\n    \"gcp_total\": 0,\n    \"azure_total\": 0,\n    \"matched_exact_size\": 0,\n    \"size_diff\": 0,\n    \"only_in_gcp\": 0,\n    \"only_in_azure\": 0,\n    \"sample_diffs\": [],\n    \"sample_only_gcp\": [],\n    \"sample_only_azure\": []\n})\n\nall_rel_paths = set(gcp_files.keys()) | set(azure_files.keys())\n\nfor rel in all_rel_paths:\n    top_proj = rel.split(os.sep)[0]\n    p = projects[top_proj]\n\n    in_gcp = rel in gcp_files\n    in_azure = rel in azure_files\n\n    if in_gcp:\n        p[\"gcp_total\"] += 1\n    if in_azure:\n        p[\"azure_total\"] += 1\n\n    if in_gcp and in_azure:\n        gcp_sz = gcp_files[rel]\n        az_sz = azure_files[rel]\n        if gcp_sz == az_sz:\n            p[\"matched_exact_size\"] += 1\n        else:\n            p[\"size_diff\"] += 1\n            if len(p[\"sample_diffs\"]) < 3:\n                p[\"sample_diffs\"].append(f\"{rel} (GCP: {gcp_sz}B vs Azure: {az_sz}B)\")\n    elif in_gcp and not in_azure:\n        p[\"only_in_gcp\"] += 1\n        if len(p[\"sample_only_gcp\"]) < 3:\n            p[\"sample_only_gcp\"].append(rel)\n    elif in_azure and not in_gcp:\n        p[\"only_in_azure\"] += 1\n        if len(p[\"sample_only_azure\"]) < 3:\n            p[\"sample_only_azure\"].append(rel)\n\n# Write report\nout_path = \"/home/azureuser/IrakIroan/GCP_VS_AZURE_RECONCILIATION_REPORT.md\"\nwith open(out_path, \"w\", encoding=\"utf-8\") as f:\n    f.write(\"# Google Cloud VM vs Azure VM File Reconciliation Report\\n\\n\")\n    f.write(f\"- **GCP Source Path:** `{GCP_ROOT}`\\n\")\n    f.write(f\"- **Azure Target Path:** `{AZURE_ROOT}`\\n\")\n    f.write(f\"- **Total GCP Files Evaluated:** {len(gcp_files):,}\\n\")\n    f.write(f\"- **Total Azure Files Evaluated:** {len(azure_files):,}\\n\\n\")\n    \n    f.write(\"## 1. Project-by-Project Summary Table\\n\\n\")\n    f.write(\"| Component / Project | GCP Files | Azure Files | Exact Match | Modified/Diff | Only in GCP | Only in Azure | Status |\\n\")\n    f.write(\"| :--- | :---: | :---: | :---: | :---: | :---: | :---: | :---: |\\n\")\n\n    sorted_projs = sorted(projects.keys(), key=lambda x: (projects[x][\"gcp_total\"] + projects[x][\"azure_total\"]), reverse=True)\n    \n    for pr in sorted_projs:\n        d = projects[pr]\n        status = \"✅ 100% MATCH\" if (d[\"only_in_gcp\"] == 0 and d[\"size_diff\"] == 0) else (\"⚠️ MINOR DIFF\" if d[\"matched_exact_size\"] > 0 else \"❌ NOT ON AZURE\")\n        f.write(f\"| `{pr}` | {d['gcp_total']} | {d['azure_total']} | {d['matched_exact_size']} | {d['size_diff']} | {d['only_in_gcp']} | {d['only_in_azure']} | {status} |\\n\")\n\n    f.write(\"\\n## 2. Granular Breakdown: What Matched & What Diverged\\n\\n\")\n    for pr in sorted_projs:\n        d = projects[pr]\n        if d[\"size_diff\"] > 0 or d[\"only_in_gcp\"] > 0 or d[\"only_in_azure\"] > 0:\n            f.write(f\"### `{pr}`\\n\")\n            f.write(f\"- Exact matches: {d['matched_exact_size']}\\n\")\n            if d[\"size_diff\"] > 0:\n                f.write(f\"- Files with modified sizes ({d['size_diff']}):\\n\")\n                for s in d[\"sample_diffs\"]:\n                    f.write(f\"  - `{s}`\\n\")\n            if d[\"only_in_gcp\"] > 0:\n                f.write(f\"- Files in GCP not copied to Azure ({d['only_in_gcp']}):\\n\")\n                for s in d[\"sample_only_gcp\"]:\n                    f.write(f\"  - `{s}`\\n\")\n            if d[\"only_in_azure\"] > 0:\n                f.write(f\"- New files created on Azure ({d['only_in_azure']}):\\n\")\n                for s in d[\"sample_only_azure\"]:\n                    f.write(f\"  - `{s}`\\n\")\n            f.write(\"\\n\")\n\nprint(f\"Reconciliation finished. Report saved to: {out_path}\")\n","Description":"Create python reconciliation script comparing GCP backup vs Azure files","Overwrite":true,"TargetFile":"/home/azureuser/IrakIroan/reconcile_gcp_vs_azure.py","toolAction":"Writing reconciliation script","toolSummary":"Create reconciliation script"}}]}
