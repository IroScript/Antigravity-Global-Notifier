 res = subprocess.run(cmd, capture_output=True, text=True, timeout=300)\n92:         dur = round(time.time() - start_t, 2)\n93:         if res.returncode == 0:\n94:             log(f\"[+] Target '{name}' synced successfully to {remote_dest} in {dur}s\")\n95:             return True, \"Success\"\n96:         else:\n97:             err = res.stderr.strip() or res.stdout.strip()\n98:             log(f\"[!] Target '{name}' sync returned error (code {res.returncode}): {err}\")\n99:             return False, err\n100:     except subprocess.TimeoutExpired:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
