eDisplay').textContent = '📄 ' + fileName;\n            document.title = '📖 ' + fileName + ' - Azure Reader';\n\n            fetch(filePath)\n                .then(res => {\n                    if (!res.ok) throw new Error('File not found or inaccessible (' + res.status + ')');\n                    return res.text();\n                })\n                .then(text => {\n                    document.getElementById('content').innerHTML = marked.parse(text);\n                })\n                .catch(err => {\n                    document.getElementById('content').innerHTML = '<p style=\\\"color: #f87171;\\\">❌ Error loading document: ' + err.message + '</p>';\n                });\n        }\n    </script>\n</body>\n</html>\n'''\n\nwith open(os.path.join(exports_dir, 'reader.html'), 'w', encoding='utf-8') as f:\n    f.write(reader_html)\nprint('reader.html created successfully!')\n\n# 2. Convert markdown files to pre-rendered HTML files\ndef md_to_html(md_text, title):\n    # simple clean HTML generator with embedded marked.js\n    escaped_md = json.dumps(md_text)\n    return f'''<!DOCTYPE html>\n<html lang=\\\"en\\\">\n<head>\n    <meta charset=\\\"UTF-8\\\">\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\n    <title>📖 {html.escape(title)}</title>\n    <script src=\\\"https://cdn.jsdelivr.net/npm/marked/marked.min.js\\\"></script>\n    <link rel=\\\"stylesheet\\\" href=\\\"https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.5.1/github-markdown-dark.min.css\\\">\n    <style>\n        body {{ background-color: #0b1120; color: #f1f5f9; margin: 0; padding: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }}\n        .wrapper {{ max-width: 960px; margin: 0 auto; }}\n        .top-nav {{ display: flex; justify-content: space-between; align-items: center; background: #1e293b; border: 1px solid #334155; padding: 12px 20px; border-radius: 10px; margin-bottom: 20px; }}\n        .top-nav a {{ c