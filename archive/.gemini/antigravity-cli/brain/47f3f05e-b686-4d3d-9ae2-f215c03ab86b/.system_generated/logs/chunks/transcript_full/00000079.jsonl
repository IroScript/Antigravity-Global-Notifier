labelMap = {\n      '1m': 'গত ১ মিনিট', '5m': 'গত ৫ মিনিট', '15m': 'গত ১৫ মিনিট', '30m': 'গত ৩০ মিনিট',\n      '1h': 'গত ১ ঘণ্টা', '5h': 'গত ৫ ঘণ্টা', '10h': 'গত ১০ ঘণ্টা', '24h': 'গত ২৪ ঘণ্টা', 'all': 'সমগ্র হিস্ট্রি'\n    };\n    document.getElementById('chart-range-label').innerText = labelMap[range] || range;\n    fetchHistory();\n  }\n\n  function setChartMode(mode) {\n    currentMode = mode;\n    document.querySelectorAll('.mode-pills .mode-pill').forEach(b => b.classList.remove('active'));\n    document.getElementById('mode-' + mode).classList.add('active');\n    updateChartDatasets();\n  }\n\n  function setSort(type) {\n    currentSort = type;\n    document.getElementById('btn-sort-cpu').classList.toggle('active', type === 'cpu');\n    document.getElementById('btn-sort-ram').classList.toggle('active', type === 'ram');\n    renderProcs();\n  }\n\n  function updateChartDatasets() {\n    if (!chartInstance) {\n      renderChart();\n      return;\n    }\n    const datasets = getDatasetsForCurrentMode();\n    chartInstance.data.labels = historyData.map(p => p.t);\n    chartInstance.data.datasets = datasets;\n    chartInstance.update();\n  }\n\n  function getDatasetsForCurrentMode() {\n    if (currentMode === 'cpu') {\n      return [\n        {\n          label: 'সার্বিক CPU %',\n          data: historyData.map(p => p.cpu),\n          borderColor: '#f0883e',\n          backgroundColor: 'rgba(240, 136, 62, 0.12)',\n          borderWidth: 2.2,\n          tension: 0.3,\n          fill: true,\n          pointRadius: 0,\n          pointHoverRadius: 5\n        },\n        {\n          label: 'শীর্ষ ১ অ্যাপ CPU %',\n          data: historyData.map(p => p.app1 ? p.app1.cpu : 0),\n          borderColor: '#58a6ff',\n          borderWidth: 1.6,\n          borderDash: [4, 4],\n          tension: 0.3,\n          pointRadius: 0,\n          pointHoverRadius: 4\n        }\n      ];\n    } else if (currentMode === 'ram') {\n      return [\n        {\n          label: 'সার্বিক RAM (GB)',\n          data: historyData.map(p => p.ram_gb),\n          borderColor: '#58a6ff',\n          backgroundColor: 'rgba(88, 166, 255, 0.12)',\n          borderWidth: 2.2,\n          tension: 0.3,\n          fill: true,\n          pointRadius: 0,\n          pointHoverRadius: 5\n        }\n      ];\n    } else {\n      return [\n        {\n          label: 'সার্বিক CPU %',\n          data: historyData.map(p => p.cpu),\n          borderColor: '#f0883e',\n          borderWidth: 2,\n          tension: 0.3,\n          pointRadius: 0,\n          pointHoverRadius: 5\n        },\n        {\n          label: 'সার্বিক RAM %',\n          data: historyData.map(p => p.ram_pct),\n          borderColor: '#58a6ff',\n          borderWidth: 2,\n          tension: 0.3,\n          pointRadius: 0,\n          pointHoverRadius: 5\n        }\n      ];\n    }\n  }\n\n  function renderChart() {\n    if (typeof Chart === 'undefined') {\n      setTimeout(renderChart, 300);\n      return;\n    }\n    const chartEl = document.getElementById('resourceChart');\n    if (!chartEl) return;\n    const ctx = chartEl.getContext('2d');\n    if (!historyData || historyData.length === 0) return;\n\n    const labels = historyData.map(p => p.t);\n    const datasets = getDatasetsForCurrentMode();\n\n    if (chartInstance) {\n      chartInstance.data.labels = labels;\n      chartInstance.data.datasets = datasets;\n      chartInstance.update();\n      return;\n    }\n\n    chartInstance = new Chart(ctx, {\n      type: 'line',\n      data: { labels: labels, datasets: datasets },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        interaction: { mode: 'index', intersect: false },\n        plugins: {\n          legend: {\n            display: true,\n            position: 'top',\n            labels: { color: '#8b949e', boxWidth: 10, font: { size: 10 } }\n          },\n          tooltip: {\n            enabled: false,\n            external: function(context) {\n              const tooltipModel = context.tooltip;\n              if (!tooltipModel || tooltipModel.opacity === 0) return;\n              if (tooltipModel.dataPoints && tooltipModel.dataPoints.length > 0) {\n                const idx = tooltipModel.dataPoints[0].dataIndex;\n                const pt = historyData[idx];\n                if (pt) updateGraphReport(pt, true);\n              }\n            }\n          }\n        },\n        scales: {\n          x: {\n            grid: { color: 'rgba(48, 54, 61, 0.4)' },\n            ticks: { color: '#8b949e', maxTicksLimit: 6, font: { size: 9 } }\n          },\n          y: {\n            grid: { color: 'rgba(48, 54, 61, 0.4)' },\n            ticks: { color: '#8b949e', font: { size: 9 } },\n            beginAtZero: true\n          }\n        }\n      }\n    });\n  }\n\n  function updateGraphReport(pt, isTouching) {\n    if (!pt) return;\n    const statusEl = document.getElementById('graph-report-status');\n    const dotEl = document.getElementById('graph-report-dot');\n    const timeEl = document.getElementById('graph-report-time');\n    const cpuEl = document.getElementById('graph-cpu-val');\n    const ramEl = document.getElementById('graph-ram-val');\n    const app1Name = document.getElementById('graph-app1-name');\n    const app1Cpu = document.getElementById('graph-app1-cpu');\n    const app1Ram = document.getElementById('graph-app1-ram');\n    const app2Name = document.getElementById('graph-app2-name');\n    const app2Cpu = document.getElementById('graph-app2-cpu');\n    const app2Ram = document.getElementById('graph-app2-ram');\n\n    if (isTouching) {\n      if (statusEl) statusEl.innerText = 'সিলেক্টেড পয়েন্ট';\n      if (dotEl) dotEl.style.background = 'var(--yellow)';\n    } else {\n      if (statusEl) statusEl.innerText = 'সর্বশেষ ডাটা পয়েন্ট';\n      if (dotEl) dotEl.style.background = 'var(--green)';\n    }\n\n    if (timeEl) timeEl.innerText = pt.dt || pt.t;\n    if (cpuEl) cpuEl.innerText = pt.cpu + '%';\n    if (ramEl) ramEl.innerHTML = `${pt.ram_gb} GB (${pt.ram_pct}%)`;\n\n    if (pt.app1) {\n      if (app1Name) app1Name.innerText = pt.app1.name || 'N/A';\n      if (app1Cpu) app1Cpu.innerText = `${pt.app1.cpu}% CPU`;\n      if (app1Ram) app1Ram.innerText = `${pt.app1.ram_gb >= 1.0 ? pt.app1.ram_gb + ' GB' : (pt.app1.ram_mb || 0) + ' MB'} RAM`;\n    }\n    if (pt.app2) {\n      if (app2Name) app2Name.innerText = pt.app2.name || 'N/A';\n      if (app2Cpu) app2Cpu.innerText = `${pt.app2.cpu}% CPU`;\n      if (app2Ram) app2Ram.innerText = `${pt.app2.ram_gb >= 1.0 ? pt.app2.ram_gb + ' GB' : (pt.app2.ram_mb || 0) + ' MB'} RAM`;\n    }\n  }\n\n  async function fetchStats() {\n    try {\n      const res = await fetch('/api/stats');\n      if (!res.ok) return;\n      const data = await res.json();\n      currentStats = data;\n\n      // Header time\n      const timeBadge = document.getElementById('last-update');\n      if (timeBadge) timeBadge.innerText = new Date().toLocaleTimeString('en-US');\n\n      // CPU\n      const cpuVal = document.getElementById('cpu-val');\n      if (cpuVal) cpuVal.innerText = data.cpu_overall + '%';\n      const cpuBar = document.getElementById('cpu-bar');\n      if (cpuBar) {\n        cpuBar.style.width = Math.min(data.cpu_overall, 100) + '%';\n        cpuBar.style.background = getBarColor(data.cpu_overall);\n      }\n\n      // Update Header Button Badge\n      const headerBadge = document.getElementById('headerCpuBadge');\n      if (headerBadge) {\n        headerBadge.innerText = data.cpu_overall.toFixed(1) + '%';\n        headerBadge.style.color = getBarColor(data.cpu_overall);\n      }\n\n      // Cores\n      const coreContainer = document.getElementById('core-bars');\n      if (coreContainer && data.cpu_cores) {\n        coreContainer.innerHTML = data.cpu_cores.map((c, i) => `\n          <div class=\"mon-core-item\">\n            <div class=\"mon-core-lbl\">C${i+1}</div>\n            <div class=\"mon-core-val\" style=\"color: ${getBarColor(c)}\">${c}%</div>\n          </div>\n        `).join('');\n      }\n\n      // RAM\n      const ramVal = document.getElementById('ram-val');\n      if (ramVal && data.ram) {\n        ramVal.innerHTML = `${data.ram.used_gb} GB <span style=\"font-size: 0.9rem; font-weight: 400; color: #8b949e;\">/ ${data.ram.total_gb} GB</span>`;\n        document.getElementById('ram-avail-text').innerText = `ফ্রি: ${data.ram.avail_gb} GB`;\n        const ramBar = document.getElementById('ram-bar');\n        ramBar.style.width = data.ram.percent + '%';\n        ramBar.style.background = getBarColor(data.ram.percent);\n        document.getElementById('ram-sub').innerText = `ব্যবহৃত: ${data.ram.percent}% · ফিজিক্যাল মেমোরি`;\n      }\n\n      // Swap\n      const swapVal = document.getElementById('swap-val');\n      if (swapVal && data.swap) {\n        swapVal.innerHTML = `${data.swap.used_gb} GB <span style=\"font-size: 0.9rem; font-weight: 400; color: #8b949e;\">/ ${data.swap.total_gb} GB</span>`;\n        document.getElementById('swap-bar').style.width = data.swap.percent + '%';\n      }\n\n      // Apps Rollup\n      const appList = document.getElementById('app-list');\n      if (appList && data.apps) {\n        appList.innerHTML = data.apps.map(a => `\n          <div class=\"mon-app-card\">\n            <div class=\"mon-app-info\">\n              <div class=\"mon-app-name\">${a.app}</div>\n              <div class=\"mon-app-count\">${a.count} টি প্রসেস সক্রিয়</div>\n            </div>\n            <div class=\"mon-app-cols\">\n              <div class=\"mon-col-item\">\n                <span class=\"mon-col-hdr\">১ম · CPU</span>\n                <span style=\"font-size:0.95rem; font-weight:700; color:var(--yellow);\">${a.cpu}%</span>\n              </div>\n              <div class=\"mon-col-item\">\n                <span class=\"mon-col-hdr\">২য় · RAM</span>\n                <span style=\"font-size:0.95rem; font-weight:700; color:var(--accent-blue);\">${a.ram_gb >= 1.0 ? a.ram_gb + ' GB' : a.ram_mb + ' MB'}</span>\n              </div>\n            </div>\n          </div>\n        `).join('');\n      }\n\n      renderProcs();\n    } catch (e) {\n      console.error(e);\n    }\n  }\n\n  async function fetchHistory() {\n    try {\n      const res = await fetch(`/api/history?range=${currentRange}`);\n      if (!res.ok) return;\n      historyData = await res.json();\n      renderChart();\n      if (!isScrubbing && historyData && historyData.length > 0) {\n        updateGraphReport(historyData[historyData.length - 1], false);\n      }\n    } catch (e) {\n      console.error(e);\n    }\n  }\n\n  function renderProcs() {\n    if (!currentStats || !currentStats.top_procs) return;\n    const q = (document.getElementById('search-box')?.value || '').toLowerCase();\n    let list = [...currentStats.top_procs];\n\n    if (q) {\n      list = list.filter(p => p.app.toLowerCase().includes(q) || p.name.toLowerCase().includes(q) || p.cmd.toLowerCase().includes(q));\n    }\n\n    if (currentSort === 'cpu') {\n      list.sort((a, b) => b.cpu - a.cpu);\n    } else {\n      list.sort((a, b) => b.ram_mb - a.ram_mb);\n    }\n\n    const container = document.getElementById('proc-list');\n    if (!container) return;\n\n    if (list.length === 0) {\n      container.innerHTML = '<div style=\"text-align: center; color: #8b949e; padding: 20px;\">কোনো প্রসেস পাওয়া যায়নি</div>';\n      return;\n    }\n\n    container.innerHTML = list.slice(0, 40).map(p => `\n      <div class=\"mon-proc-card\">\n        <div class=\"mon-proc-top\">\n          <span>${p.name} <span style=\"font-size: 0.7rem; color: #8b949e;\">(PID: ${p.pid})</span></span>\n          <span class=\"mon-proc-tag\">${p.app}</span>\n        </div>\n        <div class=\"mon-proc-cmd\">${p.cmd}</div>\n        <div class=\"mon-proc-metrics\">\n          <span>১ম · CPU: <span style=\"font-weight:600; color:var(--yellow);\">${p.cpu}%</span></span>\n          <span>২য় · RAM: <span style=\"font-weight:600; color:var(--accent-blue);\">${p.ram_mb >= 1024 ? (p.ram_mb/1024).toFixed(2) + ' GB' : p.ram_mb + ' MB'}</span></span>\n        </div>\n      </div>\n    `).join('');\n  }\n\n  // Periodic Loops\n  setInterval(fetchStats, 1500);\n  setInterval(() => {\n    if (activeTab === 'monitor' && !isScrubbing) {\n      fetchHistory();\n    }\n  }, 3000);\n\n  // Initial Startup\n  window.addEventListener('DOMContentLoaded', () => {\n    openThisPC();\n    fetchStats();\n  });\n</script>\n\n</body>\n</html>\n","Description":"Embed Live Resource Monitor natively into Windows 11 Home without iframes, so clicking the CPU button immediately displays all charts, graphs, and processes seamlessly","Overwrite":true,"TargetFile":"/home/azureuser/IrakIroan/azure_file_explorer/static/index.html","toolAction":"Updating index.html","toolSummary":"Embed Live Monitor natively in index.html"}}]}
