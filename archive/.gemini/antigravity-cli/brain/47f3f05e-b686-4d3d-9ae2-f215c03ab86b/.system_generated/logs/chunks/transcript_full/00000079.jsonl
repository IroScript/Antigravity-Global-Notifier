{"step_index":10964,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-26T14:16:27Z","content":"Created At: 2026-09-26T14:16:27Z\nCompleted At: 2026-09-26T14:16:27Z\nFile Path: `file:///home/azureuser/IrakIroan/azure_file_explorer/static/index.html`\nTotal Lines: 2109\nTotal Bytes: 73062\nShowing lines 1955 to 2070\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1955:   async function fetchStats() {\n1956:     try {\n1957:       const res = await fetch('/api/stats');\n1958:       if (!res.ok) return;\n1959:       const data = await res.json();\n1960:       currentStats = data;\n1961: \n1962:       // Header time\n1963:       const timeBadge = document.getElementById('last-update');\n1964:       if (timeBadge) timeBadge.innerText = new Date().toLocaleTimeString('en-US');\n1965: \n1966:       // CPU\n1967:       const cpuVal = document.getElementById('cpu-val');\n1968:       if (cpuVal) cpuVal.innerText = data.cpu_overall + '%';\n1969:       const cpuBar = document.getElementById('cpu-bar');\n1970:       if (cpuBar) {\n1971:         cpuBar.style.width = Math.min(data.cpu_overall, 100) + '%';\n1972:         cpuBar.style.background = getBarColor(data.cpu_overall);\n1973:       }\n1974: \n1975:       // Update Header Button Badge\n1976:       const headerBadge = document.getElementById('headerCpuBadge');\n1977:       if (headerBadge) {\n1978:         headerBadge.innerText = data.cpu_overall.toFixed(1) + '%';\n1979:         headerBadge.style.color = getBarColor(data.cpu_overall);\n1980:       }\n1981: \n1982:       // Cores\n1983:       const coreContainer = document.getElementById('core-bars');\n1984:       if (coreContainer && data.cpu_cores) {\n1985:         coreContainer.innerHTML = data.cpu_cores.map((c, i) => `\n1986:           <div class=\"mon-core-item\">\n1987:             <div class=\"mon-core-lbl\">C${i+1}</div>\n1988:             <div class=\"mon-core-val\" style=\"color: ${getBarColor(c)}\">${c}%</div>\n1989:           </div>\n1990:         `).join('');\n1991:       }\n1992: \n1993:       // RAM\n1994:       const ramVal = document.getElementById('ram-val');\n1995:       if (ramVal && data.ram) {\n1996:         ramVal.innerHTML = `${data.ram.used_gb} GB <span style=\"font-size: 0.9rem; font-weight: 400; color: #8b949e;\">/ ${data.ram.total_gb} GB</span>`;\n1997:         document.getElementById('ram-avail-text').innerText = `ফ্রি: ${data.ram.avail_gb} GB`;\n1998:         const ramBar = document.getElementById('ram-bar');\n1999:         ramBar.style.width = data.ram.percent + '%';\n2000:         ramBar.style.background = getBarColor(data.ram.percent);\n2001:         document.getElementById('ram-sub').innerText = `ব্যবহৃত: ${data.ram.percent}% · ফিজিক্যাল মেমোরি`;\n2002:       }\n2003: \n2004:       // Swap\n2005:       const swapVal = document.getElementById('swap-val');\n2006:       if (swapVal && data.swap) {\n2007:         swapVal.innerHTML = `${data.swap.used_gb} GB <span style=\"font-size: 0.9rem; font-weight: 400; color: #8b949e;\">/ ${data.swap.total_gb} GB</span>`;\n2008:         document.getElementById('swap-bar').style.width = data.swap.percent + '%';\n2009:       }\n2010: \n2011:       // Apps Rollup\n2012:       const appList = document.getElementById('app-list');\n2013:       if (appList && data.apps) {\n2014:         appList.innerHTML = data.apps.map(a => `\n2015:           <div class=\"mon-app-card\">\n2016:             <div class=\"mon-app-info\">\n2017:               <div class=\"mon-app-name\">${a.app}</div>\n2018:               <div class=\"mon-app-count\">${a.count} টি প্রসেস সক্রিয়</div>\n2019:             </div>\n2020:             <div class=\"mon-app-cols\">\n2021:               <div class=\"mon-col-item\">\n2022:                 <span class=\"mon-col-hdr\">১ম · CPU</span>\n2023:                 <span style=\"font-size:0.95rem; font-weight:700; color:var(--yellow);\">${a.cpu}%</span>\n2024:               </div>\n2025:               <div class=\"mon-col-item\">\n2026:                 <span class=\"mon-col-hdr\">২য় · RAM</span>\n2027:                 <span style=\"font-size:0.95rem; font-weight:700; color:var(--accent-blue);\">${a.ram_gb >= 1.0 ? a.ram_gb + ' GB' : a.ram_mb + ' MB'}</span>\n2028:               </div>\n2029:             </div>\n2030:           </div>\n2031:         `).join('');\n2032:       }\n2033: \n2034:       renderProcs();\n2035:     } catch (e) {\n2036:       console.error(e);\n2037:     }\n2038:   }\n2039: \n2040:   async function fetchHistory() {\n2041:     try {\n2042:       const res = await fetch(`/api/history?range=${currentRange}`);\n2043:       if (!res.ok) return;\n2044:       historyData = await res.json();\n2045:       renderChart();\n2046:       if (!isScrubbing && historyData && historyData.length > 0) {\n2047:         updateGraphReport(historyData[historyData.length - 1], false);\n2048:       }\n2049:     } catch (e) {\n2050:       console.error(e);\n2051:     }\n2052:   }\n2053: \n2054:   function renderProcs() {\n2055:     if (!currentStats || !currentStats.top_procs) return;\n2056:     const q = (document.getElementById('search-box')?.value || '').toLowerCase();\n2057:     let list = [...currentStats.top_procs];\n2058: \n2059:     if (q) {\n2060:       list = list.filter(p => p.app.toLowerCase().includes(q) || p.name.toLowerCase().includes(q) || p.cmd.toLowerCase().includes(q));\n2061:     }\n2062: \n2063:     if (currentSort === 'cpu') {\n2064:       list.sort((a, b) => b.cpu - a.cpu);\n2065:     } else {\n2066:       list.sort((a, b) => b.ram_mb - a.ram_mb);\n2067:     }\n2068: \n2069:     const container = document.getElementById('proc-list');\n2070:     if (!container) return;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
