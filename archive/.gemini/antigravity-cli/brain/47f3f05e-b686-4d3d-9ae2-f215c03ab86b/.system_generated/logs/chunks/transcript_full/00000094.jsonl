dth=\"13\" height=\"13\" fill=\"currentColor\"><path d=\"M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z\"/></svg>\n          </button>\n          <button class=\"grid-action-btn grid-info-btn\" data-path=\"${escapeAttr(item.path)}\" onclick=\"handlePropBtnClick(this, event)\" title=\"প্রোপার্টিজ (Properties)\">\n            <svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" fill=\"currentColor\"><path d=\"M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z\"/></svg>\n          </button>\n        </div>\n        ${getIcon(item)}\n        <div class=\"item-title\" title=\"${escapeHtml(item.name)}\">${escapeHtml(item.name)}</div>\n      `;\n      gridView.appendChild(card);\n    });\n  }\n\n  function handleItemClick(item, e) {\n    selectedItem = item;\n    document.querySelectorAll('.files-table tr, .grid-item').forEach(el => el.classList.remove('selected'));\n    if (e && e.currentTarget) e.currentTarget.classList.add('selected');\n    const info = item.is_dir ? 'Folder' : (item.size_str || 'File');\n    document.getElementById('statusLeft').textContent = `Selected: ${item.name} (${info})`;\n  }\n\n  function handleItemOpen(item) {\n    if (item.is_dir) {\n      navigateTo(item.path);\n    } else {\n      openFilePreview(item.path, item.name);\n    }\n  }\n\n  function handlePropBtnClick(btn, e) {\n    e.stopPropagation();\n    const p = btn.getAttribute('data-path');\n    if (p) showProperties(p);\n  }\n\n  function handleCopyPathBtnClick(btn, e) {\n    e.stopPropagation();\n    const p = btn.getAttribute('data-path');\n    if (p) copyPathToClipboard(p, btn);\n  }\n\n  function copyPathToClipboard(path, triggerBtn) {\n    if (!path) return;\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(path).then(() => {\n        onPathCopiedSuccess(path, triggerBtn);\n      }).catch(() => {\n        fallbackCopyPath(path, triggerBtn);\n      });\n    } else {\n      fallbackCopyPath(path, triggerBtn);\n    }\n  }\n\n  function fallbackCopyPath(path, triggerBtn) {\n    try {\n      const temp = document.createElement('textarea');\n      temp.value = path;\n      temp.style.position = 'fixed';\n      temp.style.opacity = '0';\n      document.body.appendChild(temp);\n      temp.focus();\n      temp.select();\n      const success = document.execCommand('copy');\n      document.body.removeChild(temp);\n      if (success) {\n        onPathCopiedSuccess(path, triggerBtn);\n      } else {\n        prompt('কপি করতে ব্যর্থ, ম্যানুয়ালি কপি করুন:', path);\n      }\n    } catch (err) {\n      prompt('কপি করতে ব্যর্থ, ম্যানুয়ালি কপি করুন:', path);\n    }\n  }\n\n  function onPathCopiedSuccess(path, btn) {\n    if (btn) {\n      btn.classList.add('copied');\n      const origHtml = btn.innerHTML;\n      btn.innerHTML = `<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"/></svg>`;\n      setTimeout(() => {\n        btn.classList.remove('copied');\n        btn.innerHTML = origHtml;\n      }, 1500);\n    }\n    showToast(`পাথ কপি হয়েছে: <span style=\"color:#7ee787; font-family:monospace; margin-left:4px;\">${escapeHtml(path)}</span>`);\n  }\n\n  let toastTimer = null;\n  function showToast(htmlMsg) {\n    let toast = document.getElementById('appToast');\n    if (!toast) {\n      toast = document.createElement('div');\n      toast.id = 'appToast';\n      toast.className = 'app-toast';\n      document.body.appendChild(toast);\n    }\n    toast.innerHTML = `\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"#2ea043\" style=\"flex-shrink:0;\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"/></svg>\n      <span>${htmlMsg}</span>\n    `;\n    toast.classList.add('show');\n    if (toastTimer) clearTimeout(toastTimer);