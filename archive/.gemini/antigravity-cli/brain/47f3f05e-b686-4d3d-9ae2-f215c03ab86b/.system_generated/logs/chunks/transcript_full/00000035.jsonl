es:\n                    src_inodes[st.st_ino] = []\n                src_inodes[st.st_ino].append(fp)\n        else:\n            src_special[fp] = f'mode_{st.st_mode}'\n\nprint(f'Source Regular Files:     {len(src_files):,}')\nprint(f'Source Symlinks:          {len(src_symlinks):,}')\nprint(f'Source Directories:       {len(src_dirs):,}')\nprint(f'Source Special (sockets): {len(src_special):,}')\nprint(f'Source Files with nlink>1:{src_hardlinks_count:,}')\nprint(f'Unique Inodes with nlink>1:{len(src_inodes):,}')\nprint(f'Source Total File Bytes:  {src_total_bytes:,} bytes')\n\n# Calculate missing files\nmissing_from_tar = set(src_files.keys()) - (set(tar_members.keys()) | set(tar_hardlinks.keys()))\nprint(f'\\nStep 3: Comparing Source vs Archive...')\nprint(f'Files in Source missing from Archive: {len(missing_from_tar)}')\nmissing_bytes = 0\nfor mf in missing_from_tar:\n    sz = src_files[mf]\n    missing_bytes += sz\n    print(f'  MISSING: {mf} ({sz:,} bytes)')\n\narchive_extra = (set(tar_members.keys()) | set(tar_hardlinks.keys())) - set(src_files.keys())\nprint(f'Files in Archive not in Source: {len(archive_extra)}')\n\"","Cwd":"/home/azureuser","RequestedTerminalID":"","RunPersistent":false,"WaitMsBeforeAsync":60000,"toolAction":"Forensic file reconciliation","toolSummary":"Reconcile source vs archive files"}}]}
