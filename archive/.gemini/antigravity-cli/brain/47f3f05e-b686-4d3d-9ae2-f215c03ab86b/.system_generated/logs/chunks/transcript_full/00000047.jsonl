DIR |\n               LANDLOCK_ACCESS_FS_MAKE_DIR |\n               LANDLOCK_ACCESS_FS_MAKE_REG |\n               LANDLOCK_ACCESS_FS_MAKE_SYM)\n\n    attr = LandlockRulesetAttr(handled)\n    ruleset_fd = libc.syscall(SYS_landlock_create_ruleset, ctypes.byref(attr), ctypes.sizeof(attr), 0)\n    root_fd = os.open('/', os.O_PATH | os.O_CLOEXEC)\n    pb = LandlockPathBeneathAttr(allowed, root_fd)\n    libc.syscall(SYS_landlock_add_rule, ruleset_fd, LANDLOCK_RULE_PATH_BENEATH, ctypes.byref(pb), 0)\n    os.close(root_fd)\n    libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)\n    libc.syscall(SYS_landlock_restrict_self, ruleset_fd, 0)\n    os.close(ruleset_fd)\n\n    # Test rmdir\n    try:\n        os.rmdir(test_dir)\n        print('rmdir: FAILED (dir removed)')\n    except PermissionError:\n        print('rmdir: BLOCKED by kernel Landlock (Permission denied)')\n\n    # Test truncate\n    try:\n        with open(test_file, 'r+') as f:\n            f.truncate(0)\n        print('truncate: FAILED (file truncated)')\n    except PermissionError:\n        print('truncate: BLOCKED by kernel Landlock (Permission denied)')\n\n    sys.exit(0)\n\nos.waitpid(pid, 0)\n\"","Cwd":"/home/azureuser","RunPersistent":false,"WaitMsBeforeAsync":5000,"toolAction":"Testing rmdir and truncate under Landlock","toolSummary":"Test Landlock rmdir & truncate"}}]}
