ard').disabled = (historyIndex >= historyStack.length - 1);\n1092:     document.getElementById('btnUp').disabled = (currentPath === '/' || currentPath === 'THIS_PC');\n1093:   }\n1094: \n1095:   function toggleSidebar() {\n1096:     document.getElementById('sidebar').classList.toggle('open');\n1097:   }\n1098: \n1099:   function handleSearch(e) {\n1100:     const query = e.target.value.toLowerCase().trim();\n1101:     if (!query) {\n1102:       renderFiles(currentItems);\n1103:       return;\n1104:     }\n1105:     const filtered = currentItems.filter(x => x.name.toLowerCase().includes(query));\n1106:     renderFiles(filtered);\n1107:   }\n1108: \n1109:   // Initial Load\n1110:   window.addEventListener('DOMContentLoaded', () => {\n1111:     openThisPC();\n1112:   });\n1113: </script>\n1114: \n1115: </body>\n1116: </html>\n1117: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
