{"step_index":12267,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-26T17:57:00Z","content":"Created At: 2026-09-26T17:57:00Z\nCompleted At: 2026-09-26T17:57:00Z\nFile Path: `file:///home/azureuser/IrakIroan/azure_file_explorer/static/monitor.html`\nTotal Lines: 858\nTotal Bytes: 37301\nShowing lines 300 to 440\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n300: \n301: <div id=\"proc-list\"></div>\n302: \n303: <script>\n304: let currentStats = null;\n305: let currentSort = 'cpu';\n306: let currentRange = '1h';\n307: let currentMode = 'cpu'; // 'cpu', 'ram', 'both'\n308: let chartInstance = null;\n309: let historyData = [];\n310: let isScrubbing = false;\n311: \n312: function setSort(s) {\n313:   currentSort = s;\n314:   document.getElementById('btn-sort-cpu').classList.toggle('active', s === 'cpu');\n315:   document.getElementById('btn-sort-ram').classList.toggle('active', s === 'ram');\n316:   renderProcs();\n317: }\n318: \n319: function setChartMode(mode) {\n320:   currentMode = mode;\n321:   document.getElementById('mode-cpu').classList.toggle('active', mode === 'cpu');\n322:   document.getElementById('mode-ram').classList.toggle('active', mode === 'ram');\n323:   document.getElementById('mode-both').classList.toggle('active', mode === 'both');\n324:   updateChartDatasets();\n325: }\n326: \n327: const RANGE_NAMES = {\n328:   '1m': 'গত ১ মিনিট', '5m': 'গত ৫ মিনিট', '15m': 'গত ১৫ মিনিট', '30m': 'গত ৩০ মিনিট',\n329:   '1h': 'গত ১ ঘণ্টা', '5h': 'গত ৫ ঘণ্টা', '10h': 'গত ১০ ঘণ্টা',\n330:   '24h': 'গত ২৪ ঘণ্টা (ঘণ্টা অনুযায়ী)', 'all': 'সমগ্র হিস্ট্রি (তারিখ অনুযায়ী)'\n331: };\n332: \n333: function changeRange(range, btn) {\n334:   currentRange = range;\n335:   document.querySelectorAll('.pills-scroll .pill').forEach(b => b.classList.remove('active'));\n336:   btn.classList.add('active');\n337:   const lbl = document.getElementById('chart-range-label');\n338:   if (lbl) lbl.innerText = RANGE_NAMES[range] || range;\n339:   fetchHistory();\n340: }\n341: \n342: function getBarColor(pct) {\n343:   if (pct >= 70) return 'var(--red)';\n344:   if (pct >= 40) return 'var(--yellow)';\n345:   return 'var(--green)';\n346: }\n347: \n348: let scrubTimeout = null;\n349: \n350: // Update the Dedicated Graph Point Report Card (Right Below the Graph)\n351: function updateGraphReport(pt, isTouching) {\n352:   if (!pt) return;\n353:   if (isTouching) {\n354:     isScrubbing = true;\n355:     clearTimeout(scrubTimeout);\n356:     scrubTimeout = setTimeout(() => { isScrubbing = false; }, 5000);\n357:   }\n358:   const statusEl = document.getElementById('graph-report-status');\n359:   const dotEl = document.getElementById('graph-report-dot');\n360:   const timeEl = document.getElementById('graph-report-time');\n361:   const cpuEl = document.getElementById('graph-cpu-val');\n362:   const ramEl = document.getElementById('graph-ram-val');\n363:   const app1Name = document.getElementById('graph-app1-name');\n364:   const app1Cpu = document.getElementById('graph-app1-cpu');\n365:   const app1Ram = document.getElementById('graph-app1-ram');\n366:   const app2Name = document.getElementById('graph-app2-name');\n367:   const app2Cpu = document.getElementById('graph-app2-cpu');\n368:   const app2Ram = document.getElementById('graph-app2-ram');\n369:   const footerEl = document.getElementById('graph-report-footer');\n370: \n371:   if (isTouching) {\n372:     if (statusEl) statusEl.innerText = 'সিলেক্টেড পয়েন্ট';\n373:     if (dotEl) dotEl.style.background = 'var(--yellow)';\n374:     if (footerEl) footerEl.innerText = '👆 স্ক্রাবার সক্রিয় — অন্য পয়েন্টে টানুন বা স্পর্শ করুন';\n375:   } else {\n376:     if (statusEl) statusEl.innerText = 'সর্বশেষ ডাটা পয়েন্ট';\n377:     if (dotEl) dotEl.style.background = 'var(--green)';\n378:     if (footerEl) footerEl.innerText = '💡 গ্রাফে টাচ করে আঙুল সরালে ঠিক ওই মুহূর্তের রিপোর্ট এখানে দেখা যাবে';\n379:   }\n380: \n381:   if (timeEl) timeEl.innerText = pt.dt || pt.t;\n382:   if (cpuEl) cpuEl.innerText = pt.cpu + '%';\n383:   if (ramEl) ramEl.innerHTML = `${pt.ram_gb} GB <span class=\"g-metric-sub\">(${pt.ram_pct}%)</span>`;\n384: \n385:   if (pt.app1) {\n386:     if (app1Name) app1Name.innerText = pt.app1.name || 'N/A';\n387:     if (app1Cpu) app1Cpu.innerText = `${pt.app1.cpu}% CPU`;\n388:     const r1 = (pt.app1.ram_gb !== undefined && pt.app1.ram_gb >= 1.0) ? (pt.app1.ram_gb + ' GB') : ((pt.app1.ram_mb || 0) + ' MB');\n389:     if (app1Ram) app1Ram.innerText = `${r1} RAM`;\n390:   } else {\n391:     if (app1Name) app1Name.innerText = '—';\n392:     if (app1Cpu) app1Cpu.innerText = '0% CPU';\n393:     if (app1Ram) app1Ram.innerText = '0 MB RAM';\n394:   }\n395: \n396:   if (pt.app2) {\n397:     if (app2Name) app2Name.innerText = pt.app2.name || 'N/A';\n398:     if (app2Cpu) app2Cpu.innerText = `${pt.app2.cpu}% CPU`;\n399:     const r2 = (pt.app2.ram_gb !== undefined && pt.app2.ram_gb >= 1.0) ? (pt.app2.ram_gb + ' GB') : ((pt.app2.ram_mb || 0) + ' MB');\n400:     if (app2Ram) app2Ram.innerText = `${r2} RAM`;\n401:   } else {\n402:     if (app2Name) app2Name.innerText = '—';\n403:     if (app2Cpu) app2Cpu.innerText = '0% CPU';\n404:     if (app2Ram) app2Ram.innerText = '0 MB RAM';\n405:   }\n406: }\n407: \n408: async function fetchHistory() {\n409:   try {\n410:     const res = await fetch(`/api/history?range=${currentRange}`);\n411:     if (!res.ok) return;\n412:     historyData = await res.json();\n413:     if (chartInstance) {\n414:       chartInstance.data.labels = historyData.map(p => p.t);\n415:       chartInstance.data.datasets = getDatasetsForCurrentMode();\n416:       applyMonitorScales();\n417:       chartInstance.update('none');\n418:     } else {\n419:       renderChart();\n420:     }\n421:     if (!isScrubbing && historyData && historyData.length > 0) {\n422:       updateGraphReport(historyData[historyData.length - 1], false);\n423:     }\n424:   } catch (e) {\n425:     console.error(e);\n426:   }\n427: }\n428: \n429: function updateChartDatasets() {\n430:   if (!chartInstance) {\n431:     renderChart();\n432:     return;\n433:   }\n434:   const datasets = getDatasetsForCurrentMode();\n435:   chartInstance.data.labels = historyData.map(p => p.t);\n436:   chartInstance.data.datasets = datasets;\n437:   applyMonitorScales();\n438:   chartInstance.update('none');\n439: }\n440: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
