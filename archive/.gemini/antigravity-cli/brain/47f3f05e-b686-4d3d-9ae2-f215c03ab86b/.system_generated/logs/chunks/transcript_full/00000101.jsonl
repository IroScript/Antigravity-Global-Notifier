    grid: { color: 'rgba(48, 54, 61, 0.4)' },\n489:       ticks: {\n490:         color: '#60cdff',\n491:         font: { size: 9, weight: '600' },\n492:         maxRotation: 0,\n493:         minRotation: 0,\n494:         callback: function(val, index) {\n495:           const pt = historyData[index];\n496:           if (!pt) return '';\n497:           const prevPt = index > 0 ? historyData[index - 1] : null;\n498:           if (!prevPt || prevPt.t !== pt.t) {\n499:             return pt.t;\n500:           }\n501:           return '';\n502:         }\n503:       }\n504:     };\n505:   }\n506:   return {\n507:     grid: { color: 'rgba(48, 54, 61, 0.4)' },\n508:     ticks: {\n509:       color: '#8b949e',\n510:       maxTicksLimit: 7,\n511:       font: { size: 9 },\n512:       maxRotation: 0\n513:     }\n514:   };\n515: }\n516: \n517: function applyMonitorScales() {\n518:   if (!chartInstance) return;\n519:   const cfg = getMonitorYAxisConfig();\n520:   chartInstance.options.scales.y.min = cfg.min;\n521:   chartInstance.options.scales.y.max = cfg.max;\n522:   if (chartInstance.options.scales.y.ticks) {\n523:     chartInstance.options.scales.y.ticks.callback = cfg.ticks.callback;\n524:   }\n525:   chartInstance.options.scales.x = getMonitorXAxisConfig();\n526: }\n527: \n528: function getDatasetsForCurrentMode() {\n529:   const pointRadiusFn = function(context) {\n530:     const len = context.dataset.data.length;\n531:     return context.dataIndex === len - 1 ? 4.5 : 0;\n532:   };\n533: \n534:   if (currentMode === 'cpu') {\n535:     return [\n536:       {\n537:         label: 'সার্বিক CPU %',\n538:         data: historyData.map(p => p.cpu),\n539:         borderColor: '#f0883e',\n540:         backgroundColor: 'rgba(240, 136, 62, 0.1)',\n541:         borderWidth: 2.2,\n542:         tension: 0.25,\n543:         fill: true,\n544:         pointRadius: pointRadiusFn,\n545:         pointBackgroundColor: '#f0883e',\n546:         pointBorderColor: '#ffffff',\n547:         pointBorderWidth: 1.5,\n548:         pointHoverRadius: 5\n549:       },\n550:       {\n551:         label: 'শীর্ষ ১ অ্যাপ CPU %',\n552:         data: historyData.map(p => p.app1 ? p.app1.cpu : 0),\n553:         borderColor: '#58a6ff',\n554:         borderWidth: 1.6,\n555:         borderDash: [4, 4],\n556:         tension: 0.25,\n557:         pointRadius: pointRadiusFn,\n558:         pointBackgroundColor: '#58a6ff',\n559:         pointBorderColor: '#ffffff',\n560:         pointBorderWidth: 1.5,\n561:         pointHoverRadius: 4\n562:       }\n563:     ];\n564:   } else if (currentMode === 'ram') {\n565:     return [\n566:       {\n567:         label: 'সার্বিক RAM (GB)',\n568:         data: historyData.map(p => p.ram_gb),\n569:         borderColor: '#58a6ff',\n570:         backgroundColor: 'rgba(88, 166, 255, 0.12)',\n571:         borderWidth: 2.2,\n572:         tension: 0.25,\n573:         fill: true,\n574:         pointRadius: pointRadiusFn,\n575:         pointBackgroundColor: '#58a6ff',\n576:         pointBorderColor: '#ffffff',\n577:         pointBorderWidth: 1.5,\n578:         pointHoverRadius: 5\n579:       }\n580:     ];\n581:   } else {\n582:     return [\n583:       {\n584:         label: 'সার্বিক CPU %',\n585:         data: historyData.map(p => p.cpu),\n586:         borderColor: '#f0883e',\n587:         borderWidth: 2,\n588:         tension: 0.25,\n589:         pointRadius: pointRadiusFn,\n590:         pointBackgroundColor: '#f0883e',\n591:         pointBorderColor: '#ffffff',\n592:         pointBorderWidth: 1.5,\n593:         pointHoverRadius: 5\n594:       },\n595:       {\n596:         label: 'সার্বিক RAM %',\n597:         data: historyData.map(p => p.ram_pct),\n598:         borderColor: '#58a6ff',\n599:         borderWidth: 2,\n600:         tension: 0.25,\n601:         pointRadius: pointRadiusFn,\n602:         pointBackgroundColor: '#58a6ff',\n603:         pointBorderColor: '#ffffff',\n604:         pointBorderWidth: 1.5,\n605:         pointHoverRadius: 5\n606:       }\n607:     ];\n608:   }\n609: }\n610: \n611: function renderChart() {\n612:   if (typeof Chart === 'undefined') {\n613:     setTimeout(renderChart, 300);\n614:     return;\n615:   }\n616:   const chartEl = document.getElementById('resourceChart');\n617:   if (!chartEl) return;\n618:   const ctx = chartEl.getContext('2d');\n619:   if (!historyData || historyData.length === 0) return;\n620:   const labels = historyData.map(p => p.t);\n621:   const datasets = getDatasetsForCurrentMode();\n622: \n623:   if (chartInstance) {\n624:     chartInstance.data.labels = labels;\n625:     chartInstance.data.datasets = datasets;\n626:     applyMonitorScales();\n627:     chartInstance.update('none');\n628:     return;\n629:   }\n630: \n631:   chartInstance = new Chart(ctx, {\n632:     type: 'line',\n633:     data: {\n634:       labels: labels,\n635:       datasets: datasets\n636:     },\n637:     options: {\n638:       responsive: true,\n639:       maintainAspectRatio: false,\n640:       animation: false,\n641:       animations: {\n642:         colors: false,\n643:         x: false\n644:       },\n645:       transitions: {\n646:         active: { animation: { duration: 0 } },\n647:         resize: { animation: { duration: 0 } }\n648:       },\n649:       interaction: {\n650:         mode: 'index',\n651:         intersect: false\n652:       },\n653:       plugins: {\n654:         legend: {\n655:           display: true,\n656:           position: 'top',\n657:           labels: {\n658:             color: '#8b949e',\n659:             boxWidth: 10,\n660:             font: { size: 10 }\n661:           }\n662:         },\n663:         tooltip: {\n664:           enabled: false,\n665:           external: function(context) {\n666:             const tooltipModel = context.tooltip;\n667:             if (!tooltipModel || tooltipModel.opacity === 0) {\n668:               return;\n669:             }\n670:             if (tooltipModel.dataPoints && tooltipModel.dataPoints.length > 0) {\n671:               const idx = tooltipModel.dataPoints[0].dataIndex;\n672:               const pt = historyData[idx];\n673:               if (pt) updateGraphReport(pt, true);\n674:             }\n675:           }\n676:         }\n677:       },\n678:       scales: {\n679:         x: getMonitorXAxisConfig(),\n680:         y: getMonitorYAxisConfig()\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":12270,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-26T17:57:03Z","thinking":"The relevant code for the update resides within a specific section of the `static/monitor.html` file, from lines 304 to 680. Preparation involves defining several variables for managing real-time system statistics and user interface configurations. These variables will govern display characteristics like sorting criteria, time range, visualization mode, and chart scale.\n\n\nInitialization includes `historyData` and `isScrubbing` variables. Functions are defined for scaling the CPU graph and locking/unlocking data points within the visualization. The scale function updates the visual representation of CPU usage, while the lock/unlock functions pinpoint specific data points. The locking action preserves data point information on the visualization.\n\n\nInitialization of the display includes setting up the initial graph report using the last available data point. This ensures the display starts in a consistent, meaningful state.  The graph is then updated to reflect the new state, and the report is updated whenever the range or CPU scale changes. A `changeRange` function handles updating the data range and displaying the correct label, while also fetching updated history data. A `updateGraphReport` function governs how the data is displayed and when a point on the graph is locked.\n\n\nThe UI elements need to reflect the state of the data point selection: locked, touched, or the latest. Conditional logic determines the text, dot color, unlock button visibility, and footer message based on the `isLocked` and `isTouching` flags. Date and time display is updated using the `pt.dt` or `pt.t` values.\n\n\nTime display updates were added using a variable `timeDisplay`. Calculated CPU usage is conditionally formatted based on the user-selected CPU scale, including an overall CPU percentage. RAM usage, and application-specific CPU and RAM usage are also displayed. Default values are used for applications if the corresponding data is not available.\n\n\nThe Y-axis configuration is set dynamically based on the current monitoring mode (RAM or CPU). Different scales and tick formats are applied for RAM (0-16 GB) and CPU modes. The CPU scale is further refined to handle 400% CPU usage with specific label formatting.\n\nData point styling (radius and background color) is conditional on whether a point is locked and/or is the latest point in the dataset. Locked points have a prominent visual indicator.\n\n\nCPU and RAM monitoring modes use different chart configurations.  CPU mode requires conditional data transformation depending on the selected scale (100% or 400%). The chart's data includes overall CPU usage and the top application's CPU consumption, with appropriate labels and visual styling for each scale. RAM mode will be handled next.\n\n\nRAM monitoring mode displays overall RAM usage in GB. CPU monitoring mode calculates and displays either the overall CPU percentage or a 4-vCPU load percentage, along with overall RAM percentage, dependent on the selected CPU scale. The conditional logic ensures correct data transformation and labels based on the CPU scale setting.\n\n\n","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Update monitor.html script variables, scale and locking methods","EndLine":440,"Instruction":"Add currentCpuScale, isPointLocked, lockedPointIndex, lockGraphPoint, unlockGraphPoint, setCpuScale and update updateGraphReport","ReplacementContent":"let currentStats = null;\nlet currentSort = 'cpu';\nlet currentRange = '1h';\nlet currentMode = 'cpu'; // 'cpu', 'ram', 'both'\nlet currentCpuScale = '400'; // '400' (default for 4 vCPUs) or '100'\nlet isPointLocked = false;\nlet lockedPointIndex = -1;\nlet chartInstance = null;\nlet historyData = [];\nlet isScrubbing = false;\n\nfunction setSort(s) {\n  currentSort = s;\n  document.getElementById('btn-sort-cpu').classList.toggle('active', s === 'cpu');\n  document.getElementById('btn-sort-ram').classList.toggle('active', s === 'ram');\n  renderProcs();\n}\n\nfunction setChartMode(mode) {\n  currentMode = mode;\n  document.getElementById('mode-cpu').classList.toggle('active', mode === 'cpu');\n  document.getElementById('mode-ram').classList.toggle('active', mode === 'ram');\n  document.getElementById('mode-both').classList.toggle('active', mode === 'both');\n  updateChartDatasets();\n}\n\nfunction setCpuScale(scale) {\n  currentCpuScale = scale;\n  const btn400 = document.getElementById('scale-400');\n  const btn100 = document.getElementById('scale-100');\n  if (btn400 && btn100) {\n    btn400.classList.toggle('active', scale === '400');\n    btn100.classList.toggle('active', scale === '100');\n  }\n  const tagEl = document.getElementById('chart-range-label');\n  if (tagEl && currentMode === 'cpu') {\n    tagEl.innerText = (RANGE_NAMES[currentRange] || currentRange) + (scale === '400' ? ' · ৪০০% স্কেল' : ' · ১০০% স্কেল');\n  }\n  if (chartInstance && historyData && historyData.length > 0) {\n    chartInstance.data.datasets = getDatasetsForCurrentMode();\n    applyMonitorScales();\n    chartInstance.update('none');\n    const pt = (isPointLocked && lockedPointIndex >= 0) ? historyData[lockedPointIndex] : historyData[historyData.length - 1];\n    updateGraphReport(pt, false, isPointLocked);\n  }\n}\n\nfunction lockGraphPoint(idx) {\n  if (!historyData || idx < 0 || idx >= historyData.length) return;\n  isPointLocked = true;\n  lockedPointIndex = idx;\n  const pt = historyData[idx];\n  updateGraphReport(pt, false, true);\n  if (chartInstance) {\n    chartInstance.update('none');\n  }\n}\n\nfunction unlockGraphPoint() {\n  isPointLocked = false;\n  lockedPointIndex = -1;\n  const btnUnlock = document.getElementById('btn-unlock-point');\n  if (btnUnlock) btnUnlock.style.display = 'none';\n  if (historyData && historyData.length > 0) {\n    updateGraphReport(historyData[historyData.length - 1], false, false);\n  }\n  if (chartInstance) {\n    chartInstance.update('none');\n  }\n}\n\nconst RANGE_NAMES = {\n  '1m': 'গত ১ মিনিট', '5m': 'গত ৫ মিনিট', '15m': 'গত ১৫ মিনিট', '30m': 'গত ৩০ মিনিট',\n  '1h': 'গত ১ ঘণ্টা', '5h': 'গত ৫ ঘণ্টা', '10h': 'গত ১০ ঘণ্টা',\n  '24h': 'গত ২৪ ঘণ্টা (ঘণ্টা অনুযায়ী)', 'all': 'সমগ্র হিস্ট্রি (তারিখ অনুযায়ী)'\n};\n\nfunction changeRange(range, btn) {\n  unlockGraphPoint();\n  currentRange = range;\n  document.querySelectorAll('.pills-scroll .pill').forEach(b => b.classList.remove('active'));\n  btn.classList.add('active');\n  const lbl = document.getElementById('chart-range-label');\n  if (lbl) {\n    const scaleNote = currentMode === 'cpu' ? (currentCpuScale === '400' ? ' · ৪০০% স্কেল' : ' · ১০০% স্কেল') : '';\n    lbl.innerText = (RANGE_NAMES[range] || range) + scaleNote;\n  }\n  fetchHistory();\n}\n\nfunction getBarColor(pct) {\n  if (pct >= 70) return 'var(--red)';\n  if (pct >= 40) return 'var(--yellow)';\n  return 'var(--green)';\n}\n\nlet scrubTimeout = null;\n\n// Update the Dedicated Graph Point Report Card (Right Below the Graph)\nfunction updateGraphReport(pt, isTouching, isLocked) {\n  if (!pt) return;\n  if (!isLocked && isPointLocked) {\n    return; // Point is locked by click, don't overwrite with background updates!\n  }\n  if (isTouching && !isPointLocked) {\n    isScrubbing = true;\n    clearTimeout(scrubTimeout);\n    scrubTimeout = setTimeout(() => { isScrubbing = false; }, 5000);\n  }\n  const statusEl = document.getElementById('graph-report-status');\n  const dotEl = document.getElementById('graph-report-dot');\n  const timeEl = document.getElementById('graph-report-time');\n  const cpuEl = document.getElementById('graph-cpu-val');\n  const ramEl = document.getElementById('graph-ram-val');\n  const app1Name = document.getElementById('graph-app1-name');\n  const app1Cpu = document.getElementById('graph-app1-cpu');\n  const app1Ram = document.getElementById('graph-app1-ram');\n  const app2Name = document.getElementById('graph-app2-name');\n  const app2Cpu = document.getElementById('graph-app2-cpu');\n  const app2Ram = document.getElementById('graph-app2-ram');\n  const footerEl = document.getElementById('graph-report-footer');\n  const btnUnlock = document.getElementById('btn-unlock-point');\n\n  if (isLocked) {\n    if (statusEl) statusEl.innerText = 'সিলেক্টেড পয়েন্ট (ক্লিক করে লক)';\n    if (dotEl) dotEl.style.background = 'var(--yellow)';\n    if (btnUnlock) btnUnlock.style.display = 'inline-block';\n    if (footerEl) footerEl.innerHTML = '🔒 <b>পয়েন্ট লক করা আছে</b> — অন্য পয়েন্টে ক্লিক করুন অথবা লাইভ ভিউতে ফিরুন';\n  } else if (isTouching) {\n    if (statusEl) statusEl.innerText = 'টাচ করা পয়েন্ট';\n    if (dotEl) dotEl.style.background = 'var(--accent)';\n    if (btnUnlock) btnUnlock.style.display = 'none';\n    if (footerEl) footerEl.innerText = '👆 স্ক্রাবার সক্রিয় — অন্য পয়েন্টে টানুন বা স্পর্শ করুন';\n  } else {\n    if (statusEl) statusEl.innerText = 'সর্বশেষ ডাটা পয়েন্ট';\n    if (dotEl) dotEl.style.background = 'var(--green)';\n    if (btnUnlock) btnUnlock.style.display = 'none';\n    if (footerEl) footerEl.innerText = '💡 গ্রাফের যেকোনো পয়েন্টে ক্লিক বা স্পর্শ করলে তারিখ, সময় ও মেট্রিক্স লক হয়ে থাকবে';\n  }\n\n  // Exact Date and Time\n  const timeDisplay = pt.dt ? `📅 ${pt.dt}` : `🕒 ${pt.t}`;\n  if (timeEl) timeEl.innerText = timeDisplay;\n\n  // CPU Display with 400% scale awareness\n  const cpu400 = (pt.cpu_400 !== undefined ? pt.cpu_400 : (pt.cpu * 4.0)).toFixed(1);\n  if (cpuEl) {\n    if (currentCpuScale === '400') {\n      cpuEl.innerHTML = `${cpu400}% <span class=\"g-metric-sub\">/ ৪০০% (${pt.cpu}% সার্বিক)</span>`;\n    } else {\n      cpuEl.innerHTML = `${pt.cpu}% <span class=\"g-metric-sub\">(৪-vCPU মোট: ${cpu400}%)</span>`;\n    }\n  }\n\n  if (ramEl) ramEl.innerHTML = `${pt.ram_gb} GB <span class=\"g-metric-sub\">(${pt.ram_pct}%)</span>`;\n\n  if (pt.app1) {\n    if (app1Name) app1Name.innerText = pt.app1.name || 'N/A';\n    if (app1Cpu) app1Cpu.innerText = `${pt.app1.cpu}% CPU`;\n    const r1 = (pt.app1.ram_gb !== undefined && pt.app1.ram_gb >= 1.0) ? (pt.app1.ram_gb + ' GB') : ((pt.app1.ram_mb || 0) + ' MB');\n    if (app1Ram) app1Ram.innerText = `${r1} RAM`;\n  } else {\n    if (app1Name) app1Name.innerText = '—';\n    if (app1Cpu) app1Cpu.innerText = '0% CPU';\n    if (app1Ram) app1Ram.innerText = '0 MB RAM';\n  }\n\n  if (pt.app2) {\n    if (app2Name) app2Name.innerText = pt.app2.name || 'N/A';\n    if (app2Cpu) app2Cpu.innerText = `${pt.app2.cpu}% CPU`;\n    const r2 = (pt.app2.ram_gb !== undefined && pt.app2.ram_gb >= 1.0) ? (pt.app2.ram_gb + ' GB') : ((pt.app2.ram_mb || 0) + ' MB');\n    if (app2Ram) app2Ram.innerText = `${r2} RAM`;\n  } else {\n    if (app2Name) app2Name.innerText = '—';\n    if (app2Cpu) app2Cpu.innerText = '0% CPU';\n    if (app2Ram) app2Ram.innerText = '0 MB RAM';\n  }\n}\n\nasync function fetchHistory() {\n  try {\n    const res = await fetch(`/api/history?range=${currentRange}`);\n    if (!res.ok) return;\n    historyData = await res.json();\n    if (chartInstance) {\n      chartInstance.data.labels = historyData.map(p => p.t);\n      chartInstance.data.datasets = getDatasetsForCurrentMode();\n      applyMonitorScales();\n      chartInstance.update('none');\n    } else {\n      renderChart();\n    }\n    if (!isScrubbing && !isPointLocked && historyData && historyData.length > 0) {\n      updateGraphReport(historyData[historyData.length - 1], false, false);\n    }\n  } catch (e) {\n    console.error(e);\n  }\n}\n\nfunction updateChartDatasets() {\n  if (!chartInstance) {\n    renderChart();\n    return;\n  }\n  const datasets = getDatasetsForCurrentMode();\n  chartInstance.data.labels = historyData.map(p => p.t);\n  chartInstance.data.datasets = datasets;\n  applyMonitorScales();\n  chartInstance.update('none');\n}","StartLine":304,"TargetContent":"let currentStats = null;\nlet currentSort = 'cpu';\nlet currentRange = '1h';\nlet currentMode = 'cpu'; // 'cpu', 'ram', 'both'\nlet chartInstance = null;\nlet historyData = [];\nlet isScrubbing = false;\n\nfunction setSort(s) {\n  currentSort = s;\n  document.getElementById('btn-sort-cpu').classList.toggle('active', s === 'cpu');\n  document.getElementById('btn-sort-ram').classList.toggle('active', s === 'ram');\n  renderProcs();\n}\n\nfunction setChartMode(mode) {\n  currentMode = mode;\n  document.getElementById('mode-cpu').classList.toggle('active', mode === 'cpu');\n  document.getElementById('mode-ram').classList.toggle('active', mode === 'ram');\n  document.getElementById('mode-both').classList.toggle('active', mode === 'both');\n  updateChartDatasets();\n}\n\nconst RANGE_NAMES = {\n  '1m': 'গত ১ মিনিট', '5m': 'গত ৫ মিনিট', '15m': 'গত ১৫ মিনিট', '30m': 'গত ৩০ মিনিট',\n  '1h': 'গত ১ ঘণ্টা', '5h': 'গত ৫ ঘণ্টা', '10h': 'গত ১০ ঘণ্টা',\n  '24h': 'গত ২৪ ঘণ্টা (ঘণ্টা অনুযায়ী)', 'all': 'সমগ্র হিস্ট্রি (তারিখ অনুযায়ী)'\n};\n\nfunction changeRange(range, btn) {\n  currentRange = range;\n  document.querySelectorAll('.pills-scroll .pill').forEach(b => b.classList.remove('active'));\n  btn.classList.add('active');\n  const lbl = document.getElementById('chart-range-label');\n  if (lbl) lbl.innerText = RANGE_NAMES[range] || range;\n  fetchHistory();\n}\n\nfunction getBarColor(pct) {\n  if (pct >= 70) return 'var(--red)';\n  if (pct >= 40) return 'var(--yellow)';\n  return 'var(--green)';\n}\n\nlet scrubTimeout = null;\n\n// Update the Dedicated Graph Point Report Card (Right Below the Graph)\nfunction updateGraphReport(pt, isTouching) {\n  if (!pt) return;\n  if (isTouching) {\n    isScrubbing = true;\n    clearTimeout(scrubTimeout);\n    scrubTimeout = setTimeout(() => { isScrubbing = false; }, 5000);\n  }\n  const statusEl = document.getElementById('graph-report-status');\n  const dotEl = document.getElementById('graph-report-dot');\n  const timeEl = document.getElementById('graph-report-time');\n  const cpuEl = document.getElementById('graph-cpu-val');\n  const ramEl = document.getElementById('graph-ram-val');\n  const app1Name = document.getElementById('graph-app1-name');\n  const app1Cpu = document.getElementById('graph-app1-cpu');\n  const app1Ram = document.getElementById('graph-app1-ram');\n  const app2Name = document.getElementById('graph-app2-name');\n  const app2Cpu = document.getElementById('graph-app2-cpu');\n  const app2Ram = document.getElementById('graph-app2-ram');\n  const footerEl = document.getElementById('graph-report-footer');\n\n  if (isTouching) {\n    if (statusEl) statusEl.innerText = 'সিলেক্টেড পয়েন্ট';\n    if (dotEl) dotEl.style.background = 'var(--yellow)';\n    if (footerEl) footerEl.innerText = '👆 স্ক্রাবার সক্রিয় — অন্য পয়েন্টে টানুন বা স্পর্শ করুন';\n  } else {\n    if (statusEl) statusEl.innerText = 'সর্বশেষ ডাটা পয়েন্ট';\n    if (dotEl) dotEl.style.background = 'var(--green)';\n    if (footerEl) footerEl.innerText = '💡 গ্রাফে টাচ করে আঙুল সরালে ঠিক ওই মুহূর্তের রিপোর্ট এখানে দেখা যাবে';\n  }\n\n  if (timeEl) timeEl.innerText = pt.dt || pt.t;\n  if (cpuEl) cpuEl.innerText = pt.cpu + '%';\n  if (ramEl) ramEl.innerHTML = `${pt.ram_gb} GB <span class=\"g-metric-sub\">(${pt.ram_pct}%)</span>`;\n\n  if (pt.app1) {\n    if (app1Name) app1Name.innerText = pt.app1.name || 'N/A';\n    if (app1Cpu) app1Cpu.innerText = `${pt.app1.cpu}% CPU`;\n    const r1 = (pt.app1.ram_gb !== undefined && pt.app1.ram_gb >= 1.0) ? (pt.app1.ram_gb + ' GB') : ((pt.app1.ram_mb || 0) + ' MB');\n    if (app1Ram) app1Ram.innerText = `${r1} RAM`;\n  } else {\n    if (app1Name) app1Name.innerText = '—';\n    if (app1Cpu) app1Cpu.innerText = '0% CPU';\n    if (app1Ram) app1Ram.innerText = '0 MB RAM';\n  }\n\n  if (pt.app2) {\n    if (app2Name) app2Name.innerText = pt.app2.name || 'N/A';\n    if (app2Cpu) app2Cpu.innerText = `${pt.app2.cpu}% CPU`;\n    const r2 = (pt.app2.ram_gb !== undefined && pt.app2.ram_gb >= 1.0) ? (pt.app2.ram_gb + ' GB') : ((pt.app2.ram_mb || 0) + ' MB');\n    if (app2Ram) app2Ram.innerText = `${r2} RAM`;\n  } else {\n    if (app2Name) app2Name.innerText = '—';\n    if (app2Cpu) app2Cpu.innerText = '0% CPU';\n    if (app2Ram) app2Ram.innerText = '0 MB RAM';\n  }\n}\n\nasync function fetchHistory() {\n  try {\n    const res = await fetch(`/api/history?range=${currentRange}`);\n    if (!res.ok) return;\n    historyData = await res.json();\n    if (chartInstance) {\n      chartInstance.data.labels = historyData.map(p => p.t);\n      chartInstance.data.datasets = getDatasetsForCurrentMode();\n      applyMonitorScales();\n      chartInstance.update('none');\n    } else {\n      renderChart();\n    }\n    if (!isScrubbing && historyData && historyData.length > 0) {\n      updateGraphReport(historyData[historyData.length - 1], false);\n    }\n  } catch (e) {\n    console.error(e);\n  }\n}\n\nfunction updateChartDatasets() {\n  if (!chartInstance) {\n    renderChart();\n    return;\n  }\n  const datasets = getDatasetsForCurrentMode();\n  chartInstance.data.labels = historyData.map(p => p.t);\n  chartInstance.data.datasets = datasets;\n  applyMonitorScales();\n  chartInstance.update('none');\n}","TargetFile":"/home/azureuser/IrakIroan/azure_file_explorer/static/monitor.html","toolAction":"Updating monitor.html state and report functions","toolSummary":"Update monitor.html locking and scale logic"}}]}
