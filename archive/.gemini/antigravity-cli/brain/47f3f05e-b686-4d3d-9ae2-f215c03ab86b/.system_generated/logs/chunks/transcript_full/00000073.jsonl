ionError:\n213:             self.send_json({\n214:                 \"error\": \"Permission Denied\",\n215:                 \"path\": target_path,\n216:                 \"current_path\": target_path,\n217:                 \"breadcrumbs\": breadcrumbs,\n218:                 \"parent_path\": parent_path,\n219:                 \"items\": []\n220:             })\n221:             return\n222:         except Exception as e:\n223:             self.send_json({\"error\": str(e), \"path\": target_path}, status=500)\n224:             return\n225: \n226:         # Sort: directories first, then alphabetical\n227:         items.sort(key=lambda x: (not x[\"is_dir\"], x[\"name\"].lower()))\n228: \n229:         total_files = sum(1 for x in items if not x[\"is_dir\"])\n230:         total_folders = sum(1 for x in items if x[\"is_dir\"])\n231:         total_bytes = sum(x[\"size\"] or 0 for x in items if not x[\"is_dir\"])\n232: \n233:         self.send_json({\n234:             \"current_path\": target_path,\n235:             \"parent_path\": parent_path,\n236:             \"breadcrumbs\": breadcrumbs,\n237:             \"items\": items,\n238:             \"total_items\": len(items),\n239:             \"total_files\": total_files,\n240:             \"total_folders\": total_folders,\n241:             \"total_size_str\": format_size(total_bytes)\n242:         })\n243: \n244:     def handle_content(self, target_path):\n245:         target_path = os.path.abspath(target_path)\n246:         if not os.path.exists(target_path) or os.path.isdir(target_path):\n247:             self.send_json({\"error\": \"File not found\"}, status=404)\n248:             return\n249: \n250:         stat = os.stat(target_path)\n251:         if stat.st_size > 5 * 1024 * 1024:\n252:             self.send_json({\n253:                 \"name\": os.path.basename(target_path),\n254:                 \"path\": target_path,\n255:                 \"size_str\": format_size(stat.st_size),\n256:                 \"is_too_large\": True,\n257:                 \"content\": f\"[File is {format_size(stat.st_size)}, too large to display directly. Use download.]\"\n258:             })\n259:             return\n260: \n261:         try:\n262:             with open(target_path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n263:                 content = f.read()\n264:             self.send_json({\n265:                 \"name\": os.path.basename(target_path),\n266:                 \"path\": target_path,\n267:                 \"size_str\": format_size(stat.st_size),\n268:                 \"ext\": os.path.splitext(target_path)[1].lower().lstrip(\".\"),\n269:                 \"content\": content\n270:             })\n271:         except Exception as e:\n272:             self.send_json({\"error\": str(e)}, status=500)\n273: \n274:     def handle_raw(self, target_path, download):\n275:         target_path = os.path.abspath(target_path)\n276:         if not os.path.exists(target_path) or os.path.isdir(target_path):\n277:             self.send_error(404, \"File not found\")\n278:             return\n279: \n280:         mime, _ = mimetypes.guess_type(target_path)\n281:         mime = mime or \"application/octet-stream\"\n282:         filename = os.path.basename(target_path)\n283:         stat = os.stat(target_path)\n284: \n285:         self.send_response(200)\n286:         self.send_header(\"Content-Type\", mime)\n287:         self.send_header(\"Content-Length\", str(stat.st_size))\n288:         if download:\n289:             self.send_header(\"Content-Disposition\", f'attachment; filename=\"{filename}\"')\n290:         else:\n291:             self.send_header(\"Content-Disposition\", f'inline; filename=\"{filename}\"')\n292:         self.end_headers()\n293: \n294:         try:\n295:             with open(target_path, \"rb\") as f:\n296:                 while chunk := f.read(65536):\n297:                     self.wfile.write(chunk)\n298:         except Exception:\n299:             pass\n300: \n301:     def handle_search(self, base_path, query):\n302:         base_path = os.path.abspath(base_path)\n303:         query = query.lower().strip()\n304:         if not query:\n305:             self.send_json({\"results\": []})\n306:             return\n307: \n308:         results = []\n309:         try:\n310:             for root, dirs, files in os.walk(base_path):\n311:                 # Don't recurse into .git or node_modules\n312:                 dirs[:] = [d for d in dirs if d not in (\".git\", \"node_modules\", \".cache\")]\n313:                 for d in dirs:\n314:                     if query in d.lower():\n315:                         p = os.path.join(root, d)\n316:                         results.append({\n317:                             \"name\": d,\n318:                             \"path\": p,\n319:                             \"is_dir\": True,\n320:                             \"type_name\": \"File folder\",\n321:                             \"size_str\": \"\"\n322:                         })\n323:                         if len(results) >= 100:\n324:                             break\n325:                 for f in files:\n326:                     if query in f.lower():\n327:                         p = os.path.join(root, f)\n328:                         try:\n329:                             sz = os.path.getsize(p)\n330:                         except Exception:\n331:                             sz = 0\n332:                         results.append({\n333:                             \"name\": f,\n334:                             \"path\": p,\n335:                             \"is_dir\": False,\n336:                             \"type_name\": \"File\",\n337:                             \"size_str\": format_size(sz)\n338:                         })\n339:                         if len(results) >= 100:\n340:                             break\n341:                 if len(results) >= 100:\n342:                     break\n343:         except Exception as e:\n344:             pass\n345: \n346:         self.send_json({\"query\": query, \"results\": results})\n347: \n348:     def send_json(self, data, status=200):\n349:         body = json.dumps(data).encode(\"utf-8\")\n350:         self.send_response(status)\n351:         self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n352:         self.send_header(\"Content-Length\", str(len(body)))\n353:         self.end_headers()\n354:         self.wfile.write(body)\n355: \n356: def run():\n357:     server_address = (\"0.0.0.0\", PORT)\n358:     httpd = HTTPServer(server_address, Windows11ExplorerHandler)\n359:     print(f\"Windows 11 Azure File Explorer running on http://0.0.0.0:{PORT}\")\n360:     try:\n361:         httpd.serve_forever()\n362:     except KeyboardInterrupt:\n363:         pass\n364:     finally:\n365:         httpd.server_close()\n366: \n367: if __name__ == \"__main__\":\n368:     run()\n369: \nThe above content shows the entire, complete file contents of the requested file.\n"}
