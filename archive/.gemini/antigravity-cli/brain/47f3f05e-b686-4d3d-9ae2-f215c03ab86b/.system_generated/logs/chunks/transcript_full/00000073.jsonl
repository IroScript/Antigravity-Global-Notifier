{"step_index":10640,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-26T13:46:36Z","content":"Created At: 2026-09-26T13:46:36Z\nCompleted At: 2026-09-26T13:46:36Z\n\nThe command exited with code 0.\nOutput:\n<truncated 1 lines>\n        pointHoverRadius: 4\r\n      }\r\n    ];\r\n  } else if (currentMode === 'ram') {\r\n    return [\r\n      {\r\n        label: 'সার্বিক RAM (GB)',\r\n        data: historyData.map(p => p.ram_gb),\r\n        borderColor: '#58a6ff',\r\n        backgroundColor: 'rgba(88, 166, 255, 0.12)',\r\n        borderWidth: 2.2,\r\n        tension: 0.3,\r\n        fill: true,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 5\r\n      },\r\n      {\r\n        label: 'শীর্ষ ১ অ্যাপ RAM (GB)',\r\n        data: historyData.map(p => p.app1 ? p.app1.ram_gb : 0),\r\n        borderColor: '#f0883e',\r\n        borderWidth: 1.6,\r\n        borderDash: [4, 4],\r\n        tension: 0.3,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 4\r\n      },\r\n      {\r\n        label: 'শীর্ষ ২ অ্যাপ RAM (GB)',\r\n        data: historyData.map(p => p.app2 ? p.app2.ram_gb : 0),\r\n        borderColor: '#2ea043',\r\n        borderWidth: 1.4,\r\n        borderDash: [2, 2],\r\n        tension: 0.3,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 4\r\n      }\r\n    ];\r\n  } else {\r\n    // Both CPU and RAM\r\n    return [\r\n      {\r\n        label: 'সার্বিক CPU %',\r\n        data: historyData.map(p => p.cpu),\r\n        borderColor: '#f0883e',\r\n        borderWidth: 2,\r\n        tension: 0.3,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 5\r\n      },\r\n      {\r\n        label: 'সার্বিক RAM %',\r\n        data: historyData.map(p => p.ram_pct),\r\n        borderColor: '#58a6ff',\r\n        borderWidth: 2,\r\n        tension: 0.3,\r\n        pointRadius: 0,\r\n        pointHoverRadius: 5\r\n      }\r\n    ];\r\n  }\r\n}\r\n\r\nfunction renderChart() {\r\n  const ctx = document.getElementById('resourceChart').getContext('2d');\r\n  const labels = historyData.map(p => p.t);\r\n  const datasets = getDatasetsForCurrentMode();\r\n\r\n  if (chartInstance) {\r\n    chartInstance.data.labels = labels;\r\n    chartInstance.data.datasets = datasets;\r\n    chartInstance.update();\r\n    return;\r\n  }\r\n\r\n  chartInstance = new Chart(ctx, {\r\n    type: 'line',\r\n    data: {\r\n      labels: labels,\r\n      datasets: datasets\r\n    },\r\n    options: {\r\n      responsive: true,\r\n      maintainAspectRatio: false,\r\n      interaction: {\r\n        mode: 'index',\r\n        intersect: false\r\n      },\r\n      plugins: {\r\n        legend: {\r\n          display: true,\r\n          position: 'top',\r\n          labels: {\r\n            color: '#8b949e',\r\n            boxWidth: 10,\r\n            font: { size: 10 }\r\n          }\r\n        },\r\n        tooltip: {\r\n          enabled: false,\r\n          external: function(context) {\r\n            const tooltipModel = context.tooltip;\r\n            if (!tooltipModel || tooltipModel.opacity === 0) {\r\n              return;\r\n            }\r\n            if (tooltipModel.dataPoints && tooltipModel.dataPoints.length > 0) {\r\n              const idx = tooltipModel.dataPoints[0].dataIndex;\r\n              const pt = historyData[idx];\r\n              if (pt) updateGraphReport(pt, true);\r\n            }\r\n          }\r\n        }\r\n      },\r\n      scales: {\r\n        x: {\r\n          grid: { color: 'rgba(48, 54, 61, 0.4)' },\r\n          ticks: {\r\n            color: '#8b949e',\r\n            maxTicksLimit: 6,\r\n            font: { size: 9 }\r\n          }\r\n        },\r\n        y: {\r\n          grid: { color: 'rgba(48, 54, 61, 0.4)' },\r\n          ticks: {\r\n            color: '#8b949e',\r\n            font: { size: 9 }\r\n          },\r\n          beginAtZero: true\r\n        }\r\n      },\r\n      events: ['mousemove', 'mouseout', 'click', 'touchstart', 'touchmove', 'touchend']\r\n    }\r\n  });\r\n}\r\n\r\nasync function fetchStats() {\r\n  try {\r\n    const res = await fetch('/api/stats');\r\n    if (!res.ok) return;\r\n    const data = await res.json();\r\n    currentStats = data;\r\n    \r\n    // Header time\r\n    document.getElementById('last-update').innerText = new Date().toLocaleTimeString('en-US');\r\n    \r\n    // CPU\r\n    document.getElementById('cpu-val').innerText = data.cpu_overall + '%';\r\n    const cpuBar = document.getElementById('cpu-bar');\r\n    cpuBar.style.width = Math.min(data.cpu_overall, 100) + '%';\r\n    cpuBar.style.background = getBarColor(data.cpu_overall);\r\n    \r\n    // Cores\r\n    const coreContainer = document.getElementById('core-bars');\r\n    coreContainer.innerHTML = data.cpu_cores.map((c, i) => `\r\n      <div class=\"core-item\">\r\n        <div class=\"core-lbl\">C${i+1}</div>\r\n        <div class=\"core-val\" style=\"color: ${getBarColor(c)}\">${c}%</div>\r\n      </div>\r\n    `).join('');\r\n    \r\n    // RAM\r\n    document.getElementById('ram-val').innerHTML = `${data.ram.used_gb} GB <span style=\"font-size: 0.9rem; font-weight: 400; color: #8b949e;\">/ ${data.ram.total_gb} GB</span>`;\r\n    document.getElementById('ram-avail-text').innerText = `ফ্রি: ${data.ram.avail_gb} GB`;\r\n    const ramBar = document.getElementById('ram-bar');\r\n    ramBar.style.width = data.ram.percent + '%';\r\n    ramBar.style.background = getBarColor(data.ram.percent);\r\n    document.getElementById('ram-sub').innerText = `ব্যবহৃত: ${data.ram.percent}% · ফিজিক্যাল মেমোরি`;\r\n    \r\n    // Swap\r\n    document.getElementById('swap-val').innerHTML = `${data.swap.used_gb} GB <span style=\"font-size: 0.9rem; font-weight: 400; color: #8b949e;\">/ ${data.swap.total_gb} GB</span>`;\r\n    const swapBar = document.getElementById('swap-bar');\r\n    swapBar.style.width = data.swap.percent + '%';\r\n    \r\n    // App Rollup (CPU ১ম কলাম, RAM ২য় কলাম)\r\n    const appList = document.getElementById('app-list');\r\n    appList.innerHTML = data.apps.map(a => `\r\n      <div class=\"app-card\">\r\n        <div class=\"app-info\">\r\n          <div class=\"app-name\">${a.app}</div>\r\n          <div class=\"app-count\">${a.count} টি প্রসেস সক্রিয়</div>\r\n        </div>\r\n        <div class=\"app-cols\">\r\n          <!-- ১ম কলাম: CPU -->\r\n          <div class=\"col-item\">\r\n            <span class=\"col-hdr\">১ম · CPU</span>\r\n            <span class=\"col-val-cpu\">${a.cpu}%</span>\r\n          </div>\r\n          <!-- ২য় কলাম: RAM -->\r\n          <div class=\"col-item\">\r\n            <span class=\"col-hdr\">২য় · RAM</span>\r\n            <span class=\"col-val-ram\">${a.ram_gb >= 1.0 ? a.ram_gb + ' GB' : a.ram_mb + ' MB'}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    `).join('');\r\n    \r\n    renderProcs();\r\n  } catch (e) {\r\n    console.error(e);\r\n  }\r\n}\r\n\r\nfunction renderProcs() {\r\n  if (!currentStats) return;\r\n  const q = document.getElementById('search-box').value.toLowerCase();\r\n  let list = [...currentStats.top_procs];\r\n  \r\n  if (q) {\r\n    list = list.filter(p => p.app.toLowerCase().includes(q) || p.name.toLowerCase().includes(q) || p.cmd.toLowerCase().includes(q));\r\n  }\r\n  \r\n  if (currentSort === 'cpu') {\r\n    list.sort((a, b) => b.cpu - a.cpu);\r\n  } else {\r\n    list.sort((a, b) => b.ram_mb - a.ram_mb);\r\n  }\r\n  \r\n  const container = document.getElementById('proc-list');\r\n  if (list.length === 0) {\r\n    container.innerHTML = '<div style=\"text-align: center; color: #8b949e; padding: 20px;\">কোনো প্রসেস পাওয়া যায়নি</div>';\r\n    return;\r\n  }\r\n  \r\n  container.innerHTML = list.map(p => `\r\n    <div class=\"proc-card\">\r\n      <div class=\"proc-top\">\r\n        <span>${p.name} <span style=\"font-size: 0.7rem; color: #8b949e;\">(PID: ${p.pid})</span></span>\r\n        <span class=\"proc-tag\">${p.app}</span>\r\n      </div>\r\n      <div class=\"proc-cmd\">${p.cmd}</div>\r\n      <div class=\"proc-metrics\">\r\n        <span>১ম কলাম · CPU: <span class=\"val-badge val-cpu\">${p.cpu}%</span></span>\r\n        <span>২য় কলাম · RAM: <span class=\"val-badge val-ram\">${p.ram_mb >= 1024 ? (p.ram_mb/1024).toFixed(2) + ' GB' : p.ram_mb + ' MB'}</span></span>\r\n      </div>\r\n    </div>\r\n  `).join('');\r\n}\r\n\r\n// Initial calls\r\nfetchStats();\r\nfetchHistory();\r\nsetInterval(fetchStats, 1500);\r\n// Refresh history graph every 5 seconds for live animation\r\nsetInterval(() => {\r\n  if (!isScrubbing && (currentRange === '1m' || currentRange === '5m' || currentRange === '15m' || currentRange === '30m')) {\r\n    fetchHistory();\r\n  }\r\n}, 3000);\r\n</script>\r\n\r\n</body>\r\n</html>\r\n\n"}
