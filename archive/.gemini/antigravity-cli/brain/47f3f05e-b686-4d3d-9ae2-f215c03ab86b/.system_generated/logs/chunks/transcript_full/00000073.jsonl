pct, 1)\n42:         }\n43:     except Exception as e:\n44:         return {\n45:             \"letter\": drive_letter,\n46:             \"label\": label,\n47:             \"path\": mount_point,\n48:             \"error\": str(e)\n49:         }\n50: \n51: class Windows11ExplorerHandler(BaseHTTPRequestHandler):\n52:     def end_headers(self):\n53:         self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n54:         self.send_header(\"Cache-Control\", \"no-cache, no-store, must-revalidate\")\n55:         super().end_headers()\n56: \n57:     def do_OPTIONS(self):\n58:         self.send_response(200)\n59:         self.send_header(\"Access-Control-Allow-Methods\", \"GET, HEAD, OPTIONS\")\n60:         self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n61:         self.end_headers()\n62: \n63:     def do_HEAD(self):\n64:         self.send_response(200)\n65:         self.send_header(\"Content-Type\", \"text/html; charset=utf-8\")\n66:         self.end_headers()\n67: \n68: \n69:     def do_GET(self):\n70:         parsed = urllib.parse.urlparse(self.path)\n71:         path = parsed.path\n72:         params = urllib.parse.parse_qs(parsed.query)\n73: \n74:         if path == \"/\" or path == \"/index.html\":\n75:             self.serve_file(os.path.join(STATIC_DIR, \"index.html\"), \"text/html; charset=utf-8\")\n76:         elif path.startswith(\"/static/\"):\n77:             rel_path = path[len(\"/static/\"):]\n78:             file_path = os.path.join(STATIC_DIR, rel_path)\n79:             mime, _ = mimetypes.guess_type(file_path)\n80:             self.serve_file(file_path, mime or \"application/octet-stream\")\n81:         elif path == \"/api/drives\":\n82:             self.handle_drives()\n83:         elif path == \"/api/browse\":\n84:             target_path = params.get(\"path\", [\"/home/azureuser\"])[0]\n85:             self.handle_browse(target_path)\n86:         elif path == \"/api/content\":\n87:             target_path = params.get(\"path\", [\"\"])[0]\n88:             self.handle_content(target_path)\n89:         elif path == \"/api/raw\":\n90:             target_path = params.get(\"path\", [\"\"])[0]\n91:             download = params.get(\"download\", [\"0\"])[0] == \"1\"\n92:             self.handle_raw(target_path, download)\n93:         elif path == \"/api/search\":\n94:             base = params.get(\"path\", [\"/home/azureuser\"])[0]\n95:             q = params.get(\"q\", [\"\"])[0]\n96:             self.handle_search(base, q)\n97:         else:\n98:             self.send_error(404, \"Not Found\")\n99: \n100:     def serve_file(self, file_path, content_type):\n101:         if not os.path.exists(file_path):\n102:             self.send_error(404, \"File not found\")\n103:             return\n104:         try:\n105:             with open(file_path, \"rb\") as f:\n106:                 data = f.read()\n107:             self.send_response(200)\n108:             self.send_header(\"Content-Type\", content_type)\n109:             self.send_header(\"Content-Length\", str(len(data)))\n110:             self.end_headers()\n111:             self.wfile.write(data)\n112:         except Exception as e:\n113:             self.send_error(500, str(e))\n114: \n115:     def handle_drives(self):\n116:         drives = [\n117:             get_drive_info(\"/\", \"Local Disk (C: OS Root)\", \"C\"),\n118:             get_drive_info(\"/home\", \"Data Disk (D: NVMe Home)\", \"D\"),\n119:             {\n120:                 \"letter\": \"E\",\n121:                 \"label\": \"IrakIroan Vault (E: Workspace)\",\n122:                 \"path\": \"/home/azureuser/IrakIroan\",\n123:                 \"total_str\": \"54.0 GB\",\n124:                 \"used_str\": \"54.0 GB\",\n125:                 \"free_str\": \"104.0 GB Free\",\n126:                 \"percent\": 50.0\n127:             },\n128:             {\n129:                 \"letter\": \"F\",\n130:                 \"label\": \"Google Cloud Full Backup (F:)\",\n131:                 \"path\": \"/home/azureuser/GCP_FULL_BACKUP\",\n132:                 \"total_str\": \"33.0 GB\",\n133:                 \"used_str\": \"33.0 GB\",\n134:                 \"free_str\": \"Archived\",\n135:                 \"percent\": 100.0\n136:             },\n137:             {\n138:                 \"letter\": \"G\",\n139:                 \"label\": \"GCP Extracted Live Files (G:)\",\n140:                 \"path\": \"/home/azureuser/IrakIroan/Google_Drive_Backup/Extracted files/mdkamruzzamanirak_gmail_com\",\n141:                 \"total_str\": \"38.2 GB\",\n142:                 \"used_str\": \"38.2 GB\",\n143:                 \"free_str\": \"577,045 Files\",\n144:                 \"percent\": 100.0\n145:             }\n146:         ]\n147:         self.send_json({\"drives\": drives})\n148: \n149:     def handle_browse(self, target_path):\n150:         target_path = os.path.abspath(target_path)\n151:         if not os.path.exists(target_path):\n152:             self.send_json({\"error\": \"Path does not exist\", \"path\": target_path}, status=404)\n153:             return\n154: \n155:         if not os.path.isdir(target_path):\n156:             self.send_json({\"error\": \"Path is not a directory\", \"path\": target_path}, status=400)\n157:             return\n158: \n159:         breadcrumbs = []\n160:         parts = target_path.strip(\"/\").split(\"/\")\n161:         accum = \"\"\n162:         breadcrumbs.append({\"name\": \"Root (/)\", \"path\": \"/\"})\n163:         if target_path != \"/\":\n164:             for p in parts:\n165:                 accum += \"/\" + p\n166:                 breadcrumbs.append({\"name\": p, \"path\": accum})\n167: \n168:         parent_path = os.path.dirname(target_path) if target_path != \"/\" else None\n169: \n170:         items = []\n171:         try:\n172:             with os.scandir(target_path) as it:\n173:                 for entry in it:\n174:                     try:\n175:                         is_dir = entry.is_d