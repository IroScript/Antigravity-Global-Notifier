42:             \"percent\": round(pct, 1)\n43:         }\n44:     except Exception as e:\n45:         return {\n46:             \"letter\": drive_letter,\n47:             \"label\": label,\n48:             \"path\": mount_point,\n49:             \"error\": str(e)\n50:         }\n51: \n52: _stats_cache = {\"time\": 0, \"data\": None}\n53: def get_system_stats():\n54:     now = time.time()\n55:     if _stats_cache[\"data\"] and (now - _stats_cache[\"time\"] < 1.0):\n56:         return _stats_cache[\"data\"]\n57:     try:\n58:         req = urllib.request.Request(\"http://127.0.0.1:8090/api/stats\")\n59:         with urllib.request.urlopen(req, timeout=1.5) as resp:\n60:             data = json.loads(resp.read().decode(\"utf-8\"))\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
