e = stat.st_mtime\n    mtime_str = time.strftime('%Y-%m-%d %I:%M:%S %p', time.localtime(mtime))\n    ctime = stat.st_ctime\n    ctime_str = time.strftime('%Y-%m-%d %I:%M:%S %p', time.localtime(ctime))\n\n    if not is_dir:\n        ext = os.path.splitext(name)[1].lower().lstrip('.')\n        type_name = f'{ext.upper()} File (.{ext})' if ext else 'File'\n        size = stat.st_size\n        return {\n            'name': name,\n            'path': target_path,\n            'location': location,\n            'is_dir': False,\n            'type_name': type_name,\n            'size_bytes': size,\n            'size_str': format_size(size),\n            'size_bytes_formatted': f'{size:,} bytes',\n            'files_count': 1,\n            'folders_count': 0,\n            'contains_str': '1 File',\n            'modified_str': mtime_str,\n            'created_str': ctime_str\n        }\n\n    type_name = 'File folder'\n    size_bytes = None\n    files_count = 0\n    folders_count = 0\n    size_str = 'Calculating...'\n    size_bytes_formatted = ''\n\n    try:\n        du_res = subprocess.run(['du', '-sb', target_path], capture_output=True, text=True, timeout=3.5)\n        if du_res.returncode == 0 and du_res.stdout:\n            size_bytes = int(du_res.stdout.split()[0])\n            size_str = format_size(size_bytes)\n            size_bytes_formatted = f'{size_bytes:,} bytes'\n    except subprocess.TimeoutExpired:\n        size_str = 'Large folder'\n        size_bytes_formatted = 'Scan timeout'\n    except Exception as e:\n        size_str = 'Unknown'\n        size_bytes_formatted = str(e)\n\n    try:\n        f_res = subprocess.run(['find', target_path, '-mindepth', '1', '-printf', '%y\\n'], capture_output=True, text=True, timeout=3.5)\n        if f_res.returncode == 0:\n            lines = f_res.stdout.splitlines()\n            for line in lines:\n                if line == 'f':\n                    files_count += 1\n                elif line == 'd':\n                    f