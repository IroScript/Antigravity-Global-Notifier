om/storage/v1/b/{BUCKET_NAME}/o/{urllib.parse.quote(TEST_OBJECT_NAME, safe='')}?alt=media\"\n    req_read = urllib.request.Request(url_read, headers={'Authorization': f'Bearer {token}'}, method='GET')\n    try:\n        resp = urllib.request.urlopen(req_read)\n        print(f\"Status: UNEXPECTED SUCCESS (HTTP {resp.status})\")\n        print(\"Verdict: READ = FAILED (Object should NOT be readable!)\")\n    except urllib.error.HTTPError as e:\n        print(f\"Status: DENIED AS EXPECTED (HTTP {e.code})\")\n        print(f\"Error Message: {e.read().decode().strip()}\")\n        print(\"Verdict: READ = DENIED (PASSED BOUNDARY)\")\n\n    # 3. DELETE TEST\n    print(\"\\n[TEST 3: DELETE CAPABILITY (Expect 403 Forbidden)]\")\n    url_delete = f\"https://storage.googleapis.com/storage/v1/b/{BUCKET_NAME}/o/{urllib.parse.quote(TEST_OBJECT_NAME, safe='')}\"\n    req_delete = urllib.request.Request(url_delete, headers={'Authorization': f'Bearer {token}'}, method='DELETE')\n    try:\n        resp = urllib.request.urlopen(req_delete)\n        print(f\"Status: UNEXPECTED SUCCESS (HTTP {resp.status})\")\n        print(\"Verdict: DELETE = FAILED (Object should NOT be deletable!)\")\n    except urllib.error.HTTPError as e:\n        print(f\"Status: DENIED AS EXPECTED (HTTP {e.code})\")\n        print(f\"Error Message: {e.read().decode().strip()}\")\n        print(\"Verdict: DELETE = DENIED (PASSED BOUNDARY)\")\n\n    # 4. OVERWRITE TEST\n    print(\"\\n[TEST 4: OVERWRITE CAPABILITY (Expect 403 Forbidden)]\")\n    url_overwrite = f\"https://storage.googleapis.com/upload/storage/v1/b/{BUCKET_NAME}/o?uploadType=media&name={TEST_OBJECT_NAME}\"\n    req_overwrite = urllib.request.Request(url_overwrite, data=b\"OVERWRITE_ATTEMPT_PAYLOAD_CORRUPT\", headers={\n        'Authorization': f'Bearer {token}',\n        'Content-Type': 'text/plain'\n    }, method='POST')\n    try:\n        resp = urllib.request.urlopen(req_overwrite)\n        print(f\"Status: UNEXPECTED SUCCESS (HTTP {resp.status})