ix Standard\", \"/bin/rm /tmp/test_50_del/f2.txt\", \"f2.txt\")\n41: add_test(3, \"Absolute /usr/bin/rm -f\", \"Unix Standard\", \"/usr/bin/rm -f /tmp/test_50_del/f3.txt\", \"f3.txt\")\n42: add_test(4, \"Standard unlink\", \"Unix Standard\", \"unlink /tmp/test_50_del/f4.txt\", \"f4.txt\")\n43: add_test(5, \"Absolute /usr/bin/unlink\", \"Unix Standard\", \"/usr/bin/unlink /tmp/test_50_del/f5.txt\", \"f5.txt\")\n44: add_test(6, \"Standard rmdir\", \"Unix Standard\", \"rmdir /tmp/test_50_del/d6\", \"d6\", is_dir=True)\n45: add_test(7, \"Absolute /bin/rmdir\", \"Unix Standard\", \"/bin/rmdir /tmp/test_50_del/d7\", \"d7\", is_dir=True)\n46: add_test(8, \"find -delete\", \"Unix Standard\", \"find /tmp/test_50_del -name f8.txt -delete\", \"f8.txt\")\n47: add_test(9, \"find -exec rm\", \"Unix Standard\", \"find /tmp/test_50_del -name f9.txt -exec rm {} \\\\;\", \"f9.txt\")\n48: add_test(10, \"find -exec /bin/rm\", \"Unix Standard\", \"find /tmp/test_50_del -name f10.txt -exec /bin/rm {} \\\\;\", \"f10.txt\")\n49: add_test(11, \"xargs rm\", \"Unix Standard\", \"echo /tmp/test_50_del/f11.txt | xargs rm\", \"f11.txt\")\n50: add_test(12, \"bash -c 'rm ...'\", \"Unix Wrapper\", \"bash -c 'rm /tmp/test_50_del/f12.txt'\", \"f12.txt\")\n51: add_test(13, \"sh -c 'rm ...'\", \"Unix Wrapper\", \"sh -c 'rm /tmp/test_50_del/f13.txt'\", \"f13.txt\")\n52: add_test(14, \"eval 'rm ...'\", \"Unix Wrapper\", \"eval 'rm /tmp/test_50_del/f14.txt'\", \"f14.txt\")\n53: add_test(15, \"$(echo rm) ...\", \"Unix Subst\", \"$(echo rm) /tmp/test_50_del/f15.txt\", \"f15.txt\")\n54: \n55: # --- Category 2: Python Deletion APIs (Rule 3) ---\n56: add_test(16, \"Python os.remove()\", \"Python API\", \"python3 -c \\\"import os; os.remove('/tmp/test_50_del/f16.txt')\\\"\", \"f16.txt\")\n57: add_test(17, \"Python os.unlink()\", \"Python API\", \"python3 -c \\\"import os; os.unlink('/tmp/test_50_del/f17.txt')\\\"\", \"f17.txt\")\n58: add_test(18, \"Python os.rmdir()\", \"Python API\", \"python3 -c \\\"import os; os.rmdir('/tmp/test_50_del/d18')\\\"\", \"d18\", is_dir=True)\n59: add_test(19, \"Python shutil.rmtree()\", \"Python API\", \"python3 -c \\\"import shutil; shutil.rmtree('/tmp/test_50_del/d19')\\\"\", \"d19\", is_dir=True)\n60: add_test(20, \"Python Path.unlink()\", \"Python API\", \"python3 -c \\\"from pathlib import Path; Path('/tmp/test_50_del/f20.txt').unlink()\\\"\", \"f20.txt\")\n61: add_test(21, \"Python Path.rmdir()\", \"Python API\", \"python3 -c \\\"from pathlib import Path; Path('/tmp/test_50_del/d21').rmdir()\\\"\", \"d21\", is_dir=True)\n62: \n63: # --- Category 3: Git & Truncation Guardrails (Rules 9, 10, 11, 12, 13, 23, 26) ---\n64: add_test(22, \"git clean -f\", \"Git Guard\", \"git clean -fd\", \"f22.txt\")\n65: add_test(23, \"git reset --hard\", \"Git Guard\", \"git reset --hard HEAD\", \"f23.txt\")\n66: add_test(24, \"git checkout --\", \"Git Guard\", \"git checkout -- f24.txt\", \"f24.txt\")\n67: add_test(25, \"git restore\", \"Git Guard\", \"git restore f25.txt\", \"f25.txt\")\n68: add_test(26, \"rsync --delete\", \"Sync Guard\", \"rsync -av --delete /tmp/empty/ /tmp/test_50_del/d26/\", \"d26\", is_dir=True)\n69: add_test(27, \"truncate -s 0\", \"Truncate Guard\", \"truncate -s 0 /tmp/test_50_del/f27.txt\", \"f27.txt\")\n70: add_test(28, \"fallocate -l 0\", \"Truncate Guard\", \"fallocate -l 0 /tmp/test_50_del/f28.txt\", \"f28.txt\")\n71: add_test(29, \"sudo rm\", \"Sudo Guard\", \"sudo rm /tmp/test_50_del/f29.txt\", \"f29.txt\")\n72: \n73: # --- Category 4: Alternative Unix Utilities (Bypasses) ---\n74: add_test(30, \"shred -u (secure delete)\", \"Unix Utility\", \"shred -u /tmp/test_50_del/f30.txt\", \"f30.txt\")\n75: add_test(31, \"shred -z -u -n 1\", \"Unix Utility\", \"shred -z -u -n 1 /tmp/test_50_del/f31.txt\", \"f31.txt\")\n76: add_test(32, \"dd if=/dev/null of=...\", \"Block Overwrite\", \"dd if=/dev/null of=/tmp/test_50_del/f32.txt\", \"f32.txt\")\n77: add_test(33, \"cp /dev/null ...\", \"File Overwrite\", \"cp /dev/null /tmp/test_50_del/f33.txt\", \"f33.txt\")\n78: add_test(34, \"tee < /dev/null\", \"Pipe Truncate\", \"tee /tmp/test_50_del/f34.txt < /dev/null\", \"f34.txt\")\n79: add_test(35, \"cat /dev/null > ...\", \"Redirection Wipe\", \"cat /dev/null > /tmp/test_50_del/f35.txt\", \"f35.txt\")\n80: add_test(36, \"sed -i 'd' ...\", \"Stream Wipe\", \"sed -i 'd' /tmp/test_50_del/f36.txt\", \"f36.txt\")\n81: add_test(37, \"tar --remove-files\", \"Archive Removal\", \"tar -czf /tmp/test_50_del/f37.tar.gz --remove-files -C /tmp/test_50_del f37.txt\", \"f37.txt\")\n82: add_test(38, \"bzip2 (deletes source)\", \"Compress Deletion\", \"bzip2 /tmp/test_50_del/f38.txt\", \"f38.txt\")\n83: add_test(39, \"gzip (deletes source)\", \"Compress Deletion\", \"gzip /tmp/test_50_del/f39.txt\", \"f39.txt\")\n84: add_test(40, \"head -c 0 > ...\", \"Truncate Redir\", \"head -c 0 /dev/zero > /tmp/test_50_del/f40.txt\", \"f40.txt\")\n85: \n86: # --- Category 5: Scripting Interpreters & Syscalls (Bypasses) ---\n87: add_test(41, \"Perl unlink()\", \"Perl Interpreter\", \"perl -e \\\"unlink('/tmp/test_50_del/f41.txt')\\\"\", \"f41.txt\")\n88: add_test(42, \"Direct Syscall 87 (unlink)\", \"Kernel Syscall\", \"python3 -c \\\"import ctypes; ctypes.CDLL(None).syscall(87, b'/tmp/test_50_del/f42.txt')\\\"\", \"f42.txt\")\n89: add_test(43, \"Direct Syscall 263 (unlinkat)\", \"Kernel Syscall\", \"python3 -c \\\"import ctypes; ctypes.CDLL(None).syscall(263, -100, b'/tmp/test_50_del/f43.txt', 0)\\\"\", \"f43.txt\")\n90: add_test(44, \"Python getattr(os, 'unlink')\", \"Dynamic Python\", \"python3 -c \\\"getattr(__import__('os'), 'un' + 'link')('/tmp/test_50_del/f44.txt')\\\"\", \"f44.txt\")\n91: add_test(45, \"Python open(..., 'w').close()\", \"Python Truncate\", \"python3 -c \\\"open('/tmp/test_50_del/f45.txt', 'w').close()\\\"\", \"f45.txt\")\n92: add_test(46, \"Python f.truncate(0)\", \"Python Truncate\", \"python3 -c \\\"f=open('/tmp/test_50_del/f46.txt', 'r+'); f.truncate(0); f.close()\\\"\", \"f46.txt\")\n93: add_test(47,