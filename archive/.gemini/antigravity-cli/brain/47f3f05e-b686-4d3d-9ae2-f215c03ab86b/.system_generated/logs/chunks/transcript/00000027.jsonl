:     print(f\"Uploading: {destination_name} ({size:,} bytes)...\", end=\" \", flush=True)\n40:     with open(local_path, \"rb\") as f:\n41:         data = f.read()\n42:     \n43:     req = urllib.request.Request(url, data=data, headers={\n44:         'Authorization': f'Bearer {token}',\n45:         'Content-Type': 'application/octet-stream'\n46:     }, method='POST')\n47:     \n48:     resp = urllib.request.urlopen(req)\n49:     res_json = json.loads(resp.read().decode())\n50:     print(f\"DONE (HTTP {resp.status}, ID: {res_json.get('id')})\")\n51:     return res_json\n52: \n53: if __name__ == \"__main__\":\n54:     import sys\n55:     if len(sys.argv) < 3:\n56:         print(\"Usage: gcs_vault_uploader.py <local_path> <destination_name>\")\n57:         sys.exit(1)\n58:     upload_file(sys.argv[1], sys.argv[2])\n59: \nThe above content shows the entire, complete file contents of the requested file.\n"}
