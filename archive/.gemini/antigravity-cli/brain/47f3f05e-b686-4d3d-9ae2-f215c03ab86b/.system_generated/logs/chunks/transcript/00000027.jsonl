ders={'Authorization': f'Bearer {token}'})\\ntry:\\n    resp = urllib.request.urlopen(req_check)\\n    print('Machine Image ALREADY EXISTS:', resp.read().decode()[:300])\\nexcept urllib.error.HTTPError as e:\\n    print('Check Machine Image HTTP:', e.code)\\n    if e.code == 404:\\n        print('Machine image does not exist yet. Attempting creation...')\\n        url_create = 'https://compute.googleapis.com/compute/v1/projects/irak-mahmud-project/global/machineImages'\\n        body = {\\n            'name': 'gcp-vm-full-backup-20260925',\\n            'sourceInstance': 'projects/irak-mahmud-project/zones/us-central1-a/instances/instance-20260925-131309'\\n        }\\n        req_create = urllib.request.Request(\\n            url_create,\\n            data=json.dumps(body).encode(),\\n            headers={'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'},\\n            method='POST'\\n        )\\n        try:\\n            r = urllib.request.urlopen(req_create)\\n            print('Creation triggered successfully:', r.read().decode())\\n        exce\n<truncated 177 bytes>","Cwd":"\"/home/azureuser\"","RequestedTerminalID":"\"\"","RunPersistent":"false","WaitMsBeforeAsync":"10000","toolAction":"\"Testing GCP Machine Image creation\"","toolSummary":"\"Check and create GCP Machine Image\""}}],"truncated_fields":["tool_calls"]}
