sPointLocked);\n    }\n  }\n\n  function lockGraphPoint(idx) {\n    if (!historyData || idx < 0 || idx >= historyData.length) return;\n    isPointLocked = true;\n    lockedPointIndex = idx;\n    const pt = historyData[idx];\n    updateGraphReport(pt, false, true);\n    if (chartInstance) {\n      chartInstance.update('none');\n    }\n  }\n\n  function unlockGraphPoint() {\n    isPointLocked = false;\n    lockedPointIndex = -1;\n    const btnUnlock = document.getElementById('btn-unlock-point');\n    if (btnUnlock) btnUnlock.style.display = 'none';\n    if (historyData && historyData.length > 0) {\n      updateGraphReport(historyData[historyData.length - 1], false, false);\n    }\n    if (chartInstance) {\n      chartInstance.update('none');\n    }\n  }\n\n  function changeRange(range, el) {\n    unlockGraphPoint();\n    currentRange = range;\n    document.querySelectorAll('.pills-scroll .pill').forEach(p => p.classList.remove('active'));\n    if (el) el.classList.add('active');\n    const labelMap = {\n      '1m': 'গত ১ মিনিট', '5m': 'গত ৫ মিনিট', '15m': 'গত ১৫ মিনিট', '30m': 'গত ৩০ মিনিট',\n      '1h': 'গত ১ ঘণ্টা', '5h': 'গত ৫ ঘণ্টা', '10h': 'গত ১০ ঘণ্টা',\n      '24h': 'গত ২৪ ঘণ্টা (ঘণ্টা অনুযায়ী)', 'all': 'সমগ্র হিস্ট্রি (তারিখ অনুযায়ী)'\n    };\n    const lbl = document.getElementById('chart-range-label');\n    if (lbl) {\n      const scaleNote = currentMode === 'cpu' ? (currentCpuScale === '400' ? ' · ৪০০% স্কেল' : ' · ১০০% স্কেল') : '';\n      lbl.innerText = (labelMap[range] || range) + scaleNote;\n    }\n    fetchHistory();\n  }\n\n  function setChartMode(mode) {\n    currentMode = mode;\n    document.querySelectorAll('.mode-pills .mode-pill').forEach(b => b.classList.remove('active'));\n    document.getElementById('mode-' + mode).classList.add('active');\n    updateChartDatasets();\n  }\n\n  function setSort(type) {\n    currentSort = type;\n    document.getElementById('btn-sort-cpu').classList.toggle('active', type === 'cpu');\n    document.getElementById('btn-sort-ram').classList.toggle('active', type === 'ram');\n    renderProcs();\n  }\n\n  function getYAxisConfig() {\n    if (currentMode === 'ram') {\n      return {\n        min: 0,\n        max: 16,\n        grid: { color: 'rgba(48, 54, 61, 0.4)' },\n        ticks: {\n          color: '#8b949e',\n          font: { size: 9 },\n          callback: function(v) { return v + ' GB'; }\n        }\n      };\n    }\n    if (currentMode === 'cpu' && currentCpuScale === '400') {\n      return {\n        min: 0,\n        max: 400,\n        grid: { color: 'rgba(48, 54, 61, 0.4)' },\n        ticks: {\n          color: '#f0883e',\n          font: { size: 9 },\n          stepSize: 100,\n          callback: function(v) {\n            if (v === 400) return '400% (৪ vCPU)';\n            if (v === 300) return '300% (৩য়)';\n            if (v === 200) return '200% (২য়)';\n            if (v === 100) return '100% (১ম)';\n            if (v === 0) return '0%';\n            return v + '%';\n          }\n        }\n      };\n    }\n    return {\n      min: 0,\n      max: 100,\n      grid: { color: 'rgba(48, 54, 61, 0.4)' },\n      ticks: {\n        color: '#8b949e',\n        font: { size: 9 },\n        callback: function(v) { return v + '%'; }\n      }\n    };\n  }\n\n  function getXAxisConfig() {\n    if (currentRange === 'all') {\n      return {\n        grid: { color: 'rgba(48, 54, 61, 0.4)' },\n        ticks: {\n          color: '#a6e3a1',\n          font: { size: 10, weight: '600' },\n          maxRotation: 0,\n          minRotation: 0,\n          callback: function(val, index) {\n            const pt = historyData[index];\n            if (!pt) return '';\n            const prevPt = index > 0 ? historyData[index - 1] : null;\n            if (!prevPt || prevPt.t !== pt.t) {\n              return pt.t;\n            }\n            return '';\n          }\n        }\n      };\n    } else if (currentRange === '24h') {\n      return {\n        grid: { color: 'rgba(48, 54, 61, 0.4)' },\n        ticks: {\n          color: '#60cdff',\n          font: { size: 9, weight: '600' },\n          maxRotation: 0,\n          minRotation: 0,\n          callback: function(val, index) {\n            const pt = historyData[index];\n            if (!pt) return '';\n            const prevPt = index > 0 ? historyData[index - 1] : null;\n            if (!prevPt || prevPt.t !== pt.t) {\n              return pt.t;\n            }\n            return '';\n          }\n        }\n      };\n    }\n    return {\n      grid: { color: 'rgba(48, 54, 61, 0.4)' },\n      ticks: {\n        color: '#8b949e',\n        maxTicksLimit: 7,\n        font: { size: 9 },\n        maxRotation: 0\n      }\n    };\n  }\n\n  function applyScales() {\n    if (!chartInstance) return;\n    const yCfg = getYAxisConfig();\n    chartInstance.options.scales.y.min = yCfg.min;\n    chartInstance.options.scales.y.max = yCfg.max;\n    if (chartInstance.options.scales.y.ticks) {\n      chartInstance.options.scales.y.ticks.callback = yCfg.ticks.callback;\n      if (yCfg.ticks.stepSize) chartInstance.options.scales.y.ticks.stepSize = yCfg.ticks.stepSize;\n    }\n    chartInstance.options.scales.x = getXAxisConfig();\n  }\n\n  function updateChartDatasets() {\n    if (!chartInstance) {\n      renderChart();\n      return;\n    }\n    const datasets = getDatasetsForCurrentMode();\n    chartInstance.data.labels = historyData.map(p => p.t);\n    chartInstance.data.datasets = datasets;\n    applyScales();\n    chartInstance.update('none');\n  }\n\n  function getDatasetsForCurrentMode() {\n    const pointRadiusFn = function(context) {\n      if (isPointLocked && context.dataIndex === lockedPointIndex) {\n        return 7.5; // High-visibility pulse radius for clicked point!\n      }\n      const len = context.dataset.data.length;\n      return context.dataIndex === len - 1 ? 4.5 : 0;\n    };\n\n    const pointBgFn = function(context) {\n      if (isPointLocked && context.dataIndex === lockedPointIndex) {\n        return '#f0883e';\n      }\n      return context.dataset.borderColor;\n    };\n\n    if (currentMode === 'cpu') {\n      const is400 = (currentCpuScale === '400');\n      return [\n        {\n          label: is400 ? 'মোট ৪-vCPU লোড % (সর্বোচ্চ ৪০০%)' : 'সার্বিক CPU % (১০০% স্কেল)',\n          data: historyData.map(p => is400 ? (p.cpu_400 !== undefined ? p.cpu_400 : Math.min(400, Math.round(p.cpu * 4.0 * 10) / 10)) : p.cpu),\n          borderColor: '#f0883e',\n          backgroundColor: 'rgba(240, 136, 62, 0.12)',\n          borderWidth: 2.2,\n          tension: 0.25,\n          fill: true,\n          pointRadius: pointRadiusFn,\n          pointBackgroundColor: pointBgFn,\n          pointBorderColor: '#ffffff',\n          pointBorderWidth: 1.5,\n          pointHoverRadius: 6\n        },\n        {\n          label: is400 ? 'শীর্ষ ১ অ্যাপ CPU %' : 'শীর্ষ ১ অ্যাপ CPU (১০০% স্কেলে)',\n          data: historyData.map(p => {\n            const appVal = p.app1 ? p.app1.cpu : 0;\n            return is400 ? appVal : Math.min(100, Math.round((appVal / 4.0) * 10) / 10);\n          }),\n          borderColor: '#58a6ff',\n          borderWidth: 1.6,\n          borderDash: [4, 4],\n          tension: 0.25,\n          pointRadius: pointRadiusFn,\n          pointBackgroundColor: pointBgFn,\n          pointBorderColor: '#ffffff',\n          pointBorderWidth: 1.5,\n          pointHoverRadius: 5\n        }\n      ];\n    } else if (currentMode === 'ram') {\n      return [\n        {\n          label: 'সার্বিক RAM (GB)',\n          data: historyData.map(p => p.ram_gb),\n          borderColor: '#58a6ff',\n          backgroundColor: 'rgba(88, 166, 255, 0.12)',\n          borderWidth: 2.2,\n          tension: 0.25,\n          fill: true,\n          pointRadius: pointRadiusFn,\n          pointBackgroundColor: pointBgFn,\n          pointBorderColor: '#ffffff',\n          pointBorderWidth: 1.5,\n          pointHoverRadius: 6\n        }\n      ];\n    } else {\n      const is400 = (currentCpuScale === '400');\n      return [\n        {\n          label: is400 ? 'মোট ৪-vCPU লোড %' : 'সার্বিক CPU %',\n          data: historyData.map(p => is400 ? (p.cpu_400 !== undefined ? p.cpu_400 : Math.min(400, Math.round(p.cpu * 4.0 * 10) / 10)) : p.cpu),\n          borderColor: '#f0883e',\n          borderWidth: 2,\n          tension: 0.25,\n          pointRadius: pointRadiusFn,\n          pointBackgroundColor: pointBgFn,\n          pointBorderColor: '#ffffff',\n          pointBorderWidth: 1.5,\n          pointHoverRadius: 6\n        },\n        {\n          label: 'সার্বিক RAM %',\n          data: historyData.map(p => p.ram_pct),\n          borderColor: '#58a6ff',\n          borderWidth: 2,\n          tension: 0.25,\n          pointRadius: pointRadiusFn,\n          pointBackgroundColor: pointBgFn,\n          pointBorderColor: '#ffffff',\n          pointBorderWidth: 1.5,\n          pointHoverRadius: 6\n        }\n      ];\n    }\n  }\n\n  function handleChartElementClick(e) {\n    if (!chartInstance || !historyData || historyData.length === 0) return;\n    const elements = chartInstance.getElementsAtEventForMode(e, 'index', { intersect: false }, true);\n    if (elements && elements.length > 0) {\n      lockGraphPoint(elements[0].index);\n    } else {\n      const canvas = chartInstance.canvas;\n      const rect = canvas.getBoundingClientRect();\n      const clientX = e.clientX || (e.touches && e.touches[0] ? e.touches[0].clientX : null);\n      if (clientX !== null) {\n        const xPos = clientX - rect.left;\n        const dataX = chartInstance.scales.x.getValueForPixel(xPos);\n        if (dataX !== undefined && dataX >= 0 && dataX < historyData.length) {\n          lockGraphPoint(Math.round(dataX));\n        }\n      }\n    }\n  }\n\n  function renderChart() {\n    if (typeof Chart === 'undefined') {\n      setTimeout(renderChart, 300);\n      return;\n    }\n    const chartEl = document.getElementById('resourceChart');\n    if (!chartEl) return;\n    const ctx = chartEl.getContext('2d');\n    if (!historyData || historyData.length === 0) return;\n\n    const labels = historyData.map(p => p.t);\n    const datasets = getDatasetsForCurrentMode();\n\n    if (chartInstance) {\n      chartInstance.data.labels = labels;\n      chartInstance.data.datasets = datasets;\n      applyScales();\n      chartInstance.update('none'); // NO ANIMATION / ZERO JUMPING!\n      return;\n    }\n\n    chartInstance = new Chart(ctx, {\n      type: 'line',\n      data: { labels: labels, datasets: datasets },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        animation: false,\n        animations: {\n          colors: false,\n          x: false\n        },\n        transitions: {\n          active: { animation: { duration: 0 } },\n          resize: { animation: { duration: 0 } }\n        },\n        interaction: { mode: 'index', intersect: false },\n        onClick: function(event, elements) {\n          if (elements && elements.length > 0) {\n            lockGraphPoint(elements[0].index);\n          } else if (event.native) {\n            handleChartElementClick(event.native);\n          }\n        },\n        plugins: {\n          legend: {\n            display: true,\n            position: 'top',\n            labels: { color: '#8b949e', boxWidth: 10, font: { size: 10 } }\n          },\n          tooltip: {\n            enabled: false,\n            external: function(context) {\n              const tooltipModel = context.tooltip;\n              if (!tooltipModel || tooltipModel.opacity === 0) return;\n              if (tooltipModel.dataPoints && tooltipModel.dataPoints.length > 0) {\n                const idx = tooltipModel.dataPoints[0].dataIndex;\n                const pt = historyData[idx];\n                if (pt && !isPointLocked) updateGraphReport(pt, true, false);\n              }\n            }\n          }\n        },\n        scales: {\n          x: getXAxisConfig(),\n          y: getYAxisConfig()\n        }\n      }\n    });\n\n    if (!chartEl.dataset.clickBound) {\n      chartEl.dataset.clickBound = \"true\";\n      chartEl.addEventListener('click', handleChartElementClick);\n      chartEl.addEventListener('touchend', function(e) {\n        if (e.changedTouches && e.changedTouches.length > 0) {\n          handleChartElementClick(e.changedTouches[0]);\n        }\n      });\n    }\n  }\n\n  function updateGraphReport(pt, isTouching, isLocked) {\n    if (!pt) return;\n    if (!isLocked && isPointLocked) {\n      return; // Point is locked by click, don't overwrite with background updates!\n    }\n    const statusEl = document.getElementById('graph-report-status');\n    const dotEl = document.getElementById('graph-report-dot');\n    const timeEl = document.getElementById('graph-report-time');\n    const cpuEl = document.getElementById('graph-cpu-val');\n    const ramEl = document.getElementById('graph-ram-val');\n    const app1Name = document.getElementById('graph-app1-name');\n    const app1Cpu = document.getElementById('graph-app1-cpu');\n    const app1Ram = document.getElementById('graph-app1-ram');\n    const app2Name = document.getElementById('graph-app2-name');\n    const app2Cpu = document.getElementById('graph-app2-cpu');\n    const app2Ram = document.getElementById('graph-app2-ram');\n    const btnUnlock = document.getElementById('btn-unlock-point');\n\n    if (isLocked) {\n      if (statusEl) statusEl.innerText = 'সিলেক্টেড পয়েন্ট (ক্লিক করে লক)';\n      if (dotEl) dotEl.style.background = 'var(--yellow)';\n      if (btnUnlock) btnUnlock.style.display = 'inline-block';\n    } else if (isTouching) {\n      if (statusEl) statusEl.innerText = 'টাচ করা পয়েন্ট';\n      if (dotEl) dotEl.style.background = 'var(--accent-blue)';\n      if (btnUnlock) btnUnlock.style.display = 'none';\n    } else {\n      if (statusEl) statusEl.innerText = 'সর্বশেষ ডাটা পয়েন্ট';\n      if (dotEl) dotEl.style.background = 'var(--green)';\n      if (btnUnlock) btnUnlock.style.display = 'none';\n    }\n\n    // Exact Date and Time\n    const timeDisplay = pt.dt ? `📅 ${pt.dt}` : `🕒 ${pt.t}`;\n    if (timeEl) timeEl.innerText = timeDisplay;\n\n    // CPU with 400% scale awareness\n    const cpu400 = (pt.cpu_400 !== undefined ? pt.cpu_400 : (pt.cpu * 4.0)).toFixed(1);\n    if (cpuEl) {\n      if (currentCpuScale === '400') {\n        cpuEl.innerHTML = `${cpu400}% <span class=\"g-metric-sub\">/ ৪০০% (${pt.cpu}% সার্বিক)</span>`;\n      } else {\n        cpuEl.innerHTML = `${pt.cpu}% <span class=\"g-metric-sub\">(৪-vCPU মোট: ${cpu400}%)</span>`;\n      }\n    }\n\n    if (ramEl) ramEl.innerHTML = `${pt.ram_gb} GB (${pt.ram_pct}%)`;\n\n    if (pt.app1) {\n      if (app1Name) app1Name.innerText = pt.app1.name || 'N/A';\n      if (app1Cpu) app1Cpu.innerText = `${pt.app1.cpu}% CPU`;\n      if (app1Ram) app1Ram.innerText = `${pt.app1.ram_gb >= 1.0 ? pt.app1.ram_gb + ' GB' : (pt.app1.ram_mb || 0) + ' MB'} RAM`;\n    }\n    if (pt.app2) {\n      if (app2Name) app2Name.innerText = pt.app2.name || 'N/A';\n      if (app2Cpu) app2Cpu.innerText = `${pt.app2.cpu}% CPU`;\n      if (app2Ram) app2Ram.innerText = `${pt.app2.ram_gb >= 1.0 ? pt.app2.ram_gb + ' GB' : (pt.app2.ram_mb || 0) + ' MB'} RAM`;\n    }\n  }","StartLine":2749,"TargetContent":"  function changeRange(range, el) {\n    currentRange = range;\n    document.querySelectorAll('.pills-scroll .pill').forEach(p => p.classList.remove('active'));\n    if (el) el.classList.add('active');\n    const labelMap = {\n      '1m': 'গত ১ মিনিট', '5m': 'গত ৫ মিনিট', '15m': 'গত ১৫ মিনিট', '30m': 'গত ৩০ মিনিট',\n      '1h': 'গত ১ ঘণ্টা', '5h': 'গত ৫ ঘণ্টা', '10h': 'গত ১০ ঘণ্টা',\n      '24h': 'গত ২৪ ঘণ্টা (ঘণ্টা অনুযায়ী)', 'all': 'সমগ্র হিস্ট্রি (তারিখ অনুযায়ী)'\n    };\n    const lbl = document.getElementById('chart-range-label');\n    if (lbl) lbl.innerText = labelMap[range] || range;\n    fetchHistory();\n  }\n\n  function setChartMode(mode) {\n    currentMode = mode;\n    document.querySelectorAll('.mode-pills .mo