sk-and-research' in c_lower or 'ask_and_research' in c_lower or tty == '/dev/pts/13':\n        return '🔍 agy:ask (Ask & Research)'\n    if 'reporting-agent' in c_lower or 'watchdog' in c_lower or 'sentinel' in c_lower:\n        return '🛡️ agy:report (Sentinel Watchdog)'\n    if 'action-agent' in c_lower:\n        return '🔧 agy:action (Action Fixer)'\n    if tty == '/dev/pts/0' or (cwd == '/home/azureuser' and 'agy' in cmd):\n        return '🧠 agy:0 (Master Agent)'\n    if 'agy' in cmd:\n        return '🤖 AGY Agent'\n    return None\n\nfor pid_dir in sorted(glob.glob('/proc/[0-9]*'), key=lambda x: int(os.path.basename(x))):\n    pid = os.path.basename(pid_dir)\n    try:\n        with open(f'{pid_dir}/cmdline', 'rb') as f:\n            cmd = f.read().decode('utf-8', errors='ignore').replace('\\0', ' ')\n        tty = ''\n        try:\n            tty = os.readlink(f'{pid_dir}/fd/0')\n        except:\n            pass\n        cwd = ''\n        try:\n            cwd = os.readlink(f'{pid_dir}/cwd')\n        except:\n            pass\n        agent = identify_agent(pid, cmd, tty, cwd)\n        if agent:\n            print(f'PID {pid:7s} -> {agent:32s} (tty: {tty})')\n    except:\n        pass\n\"","Cwd":"/home/azureuser/IrakIroan/azure_file_explorer","RunPersistent":false,"WaitMsBeforeAsync":5000,"toolAction":"Testing agent identification on all processes","toolSummary":"Test agent identification mapping"}}]}
