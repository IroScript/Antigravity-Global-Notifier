zureuser' and 'agy' in cmd):\n        return ('🧠 agy:0 (Master Agent)', 'agy:0')\n    if 'whatsapp' in full_txt or 'baileys' in full_txt:\n        return ('💬 WhatsApp Bridge', 'whatsapp')\n    if 'agy' in cmd:\n        return ('🤖 AGY Agent', 'agy')\n    return None\n\nreq = urllib.request.Request('http://127.0.0.1:8090/api/stats')\nwith urllib.request.urlopen(req, timeout=1.5) as resp:\n    data = json.loads(resp.read().decode('utf-8'))\n\napp_map = {}\nfor p in data.get('top_procs', []):\n    agent_info = resolve_agent_identity(p.get('pid'), p.get('cmd', ''))\n    if agent_info:\n        p['app'] = agent_info[0]\n        p['name'] = agent_info[1]\n    \n    app_name = p['app']\n    if app_name not in app_map:\n        app_map[app_name] = {'app': app_name, 'cpu': 0.0, 'ram_mb': 0.0, 'count': 0}\n    app_map[app_name]['cpu'] += p.get('cpu', 0.0)\n    app_map[app_name]['ram_mb'] += p.get('ram_mb', 0.0)\n    app_map[app_name]['count'] += 1\n\n# Merge other apps from 8090 if not in top_procs\nfor orig_app in data.get('apps', []):\n    a_name = orig_app.get('app', '')\n    if a_name != '🤖 AGY Coding Agent' and a_name not in app_map:\n        app_map[a_name] = orig_app\n\napps_list = []\nfor a in app_map.values():\n    a['cpu'] = round(a['cpu'], 1)\n    a['ram_mb'] = round(a['ram_mb'], 1)\n    a['ram_gb'] = round(a['ram_mb'] / 1024.0, 2)\n    apps_list.append(a)\n\napps_list.sort(key=lambda x: x['cpu'], reverse=True)\n\nprint('Enriched Apps List:')\nfor a in apps_list:\n    print(f\\\"  {a['app']}: CPU={a['cpu']}%, RAM={a['ram_gb']}GB ({a['ram_mb']}MB), Procs={a['count']}\\\")\n\"","Cwd":"/home/azureuser/IrakIroan/azure_file_explorer","RunPersistent":false,"WaitMsBeforeAsync":5000,"toolAction":"Testing enriched apps list output","toolSummary":"Test enriched apps breakdown"}}]}
