ps'],\n    ['size', 'personaldrive:Youtube_Automation'],\n    ['check', '/home/azureuser/test', 'personaldrive:test'],\n    ['cat', 'personaldrive:file.txt'],\n    ['link', 'personaldrive:Youtube_Automation'],\n    ['copy', 'personaldrive:Youtube_Automation/test.mp4', '/tmp/local/'], # download (safe)\n    ['copy', '/tmp/local.txt', 'personaldrive:Youtube_Automation/'], # upload (blocked)\n    ['sync', '/tmp/local', 'personaldrive:Youtube_Automation'], # sync (blocked)\n    ['move', '/tmp/local', 'personaldrive:Youtube_Automation'], # move (blocked)\n    ['delete', 'personaldrive:Youtube_Automation/test.mp4'], # delete (blocked)\n    ['purge', 'personaldrive:Youtube_Automation'], # purge (blocked)\n    ['rmdir', 'personaldrive:Youtube_Automation/sub'], # rmdir (blocked)\n    ['mkdir', 'personaldrive:Youtube_Automation/newdir'], # mkdir (blocked)\n    ['touch', 'personaldrive:Youtube_Automation/file.txt'] # touch (blocked)\n]\n\nfor t in tests:\n    allowed, msg = check_rclone_cmd(t)\n    status = 'ALLOWED' if allowed else 'DENIED'\n    print(f'[{status:7}] rclone {\\\" \\\".join(t)} -> {msg}')\n\"","Cwd":"/home/azureuser","RunPersistent":false,"WaitMsBeforeAsync":5000,"toolAction":"Testing rclone command filter","toolSummary":"Test rclone read-only rules"}}]}
