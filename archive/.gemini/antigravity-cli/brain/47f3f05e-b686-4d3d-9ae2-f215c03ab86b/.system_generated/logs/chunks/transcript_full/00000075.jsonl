table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 12px;\n    }\n\n    .files-table th {\n      text-align: left;\n      padding: 8px 12px;\n      background: rgba(0, 0, 0, 0.2);\n      color: var(--text-muted);\n      font-weight: 500;\n      border-bottom: 1px solid var(--border-color);\n      position: sticky;\n      top: 0;\n      z-index: 2;\n    }\n\n    .files-table tr {\n      cursor: pointer;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.02);\n      transition: background 0.1s;\n    }\n    .files-table tr:hover { background: var(--bg-hover); }\n    .files-table tr.selected { background: var(--bg-selected); }\n\n    .files-table td {\n      padding: 7px 12px;\n      white-space: nowrap;\n      color: var(--text-main);\n    }\n\n    .col-name {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-weight: 500;\n    }\n\n    .file-icon {\n      width: 18px;\n      height: 18px;\n      flex-shrink: 0;\n    }\n\n    /* Grid View Option */\n    .files-grid-view {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));\n      gap: 12px;\n      padding: 14px;\n      overflow-y: auto;\n      flex: 1;\n    }\n\n    .grid-item {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 10px 6px;\n      border-radius: var(--radius-md);\n      cursor: pointer;\n      text-align: center;\n      border: 1px solid transparent;\n      transition: all 0.12s;\n    }\n    .grid-item:hover { background: var(--bg-hover); border-color: var(--border-color); }\n    .grid-item.selected { background: var(--bg-selected); border-color: var(--accent-blue); }\n\n    .grid-item .file-icon {\n      width: 44px;\n      height: 44px;\n      margin-bottom: 8px;\n    }\n\n    .grid-item .item-title {\n      font-size: 11px;\n      color: var(--text-main);\n      word-break: break-all;\n      display: -webkit-box;\n      -webkit-line-clamp: 2;\n      -webkit-box-orient: vertical;\n      overflow: hidden;\n      line-height: 1.3;\n    }\n\n    /* Task Manager & Resource Monitor View Area */\n    .taskmgr-area {\n      flex: 1;\n      background: var(--bg-base);\n      display: flex;\n      flex-direction: column;\n      overflow-y: auto;\n      padding: 16px;\n      gap: 16px;\n    }\n\n    .taskmgr-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding-bottom: 12px;\n      border-bottom: 1px solid var(--border-color);\n    }\n\n    .chart-section {\n      background: var(--bg-surface);\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius-md);\n      padding: 16px;\n    }\n\n    .chart-controls {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 12px;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n\n    .range-pills {\n      display: flex;\n      gap: 6px;\n    }\n\n    .range-pill {\n      background: #21262d;\n      border: 1px solid var(--border-color);\n      color: var(--text-muted);\n      padding: 4px 10px;\n      border-radius: 12px;\n      font-size: 11px;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    .range-pill.active {\n      background: var(--accent-blue);\n      color: #000;\n      border-color: var(--accent-blue);\n    }\n\n    .canvas-container {\n      position: relative;\n      width: 100%;\n      height: 200px;\n      background: #151515;\n      border-radius: var(--radius-sm);\n      border: 1px solid var(--border-color);\n    }\n    canvas#perfChart {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    .proc-section {\n      background: var(--bg-surface);\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius-md);\n      padding: 16px;\n    }\n\n    .proc-controls {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 12px;\n      gap: 10px;\n    }\n\n    .proc-search {\n      flex: 1;\n      max-width: 320px;\n      background: #151515;\n      border: 1px solid var(--border-color);\n      padding: 6px 12px;\n      border-radius: var(--radius-sm);\n      color: #fff;\n      font-size: 12px;\n      outline: none;\n    }\n\n    .proc-table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 11px;\n    }\n\n    .proc-table th {\n      text-align: left;\n      padding: 6px 10px;\n      background: rgba(0, 0, 0, 0.3);\n      color: var(--text-muted);\n      border-bottom: 1px solid var(--border-color);\n    }\n\n    .proc-table td {\n      padding: 6px 10px;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.03);\n    }\n\n    /* Status Bar */\n    .status-bar {\n      height: 26px;\n      background: var(--bg-header);\n      border-top: 1px solid var(--border-color);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 14px;\n      font-size: 11px;\n      color: var(--text-muted);\n      flex-shrink: 0;\n    }\n\n    /* Notepad / Code Preview Modal */\n    .modal-overlay {\n      position: fixed;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background: rgba(0, 0, 0, 0.75);\n      backdrop-filter: blur(8px);\n      z-index: 1000;\n      display: none;\n      align-items: center;\n      justify-content: center;\n      padding: 20px;\n    }\n    .modal-overlay.active { display: flex; }\n\n    .win11-notepad {\n      width: 900px;\n      max-width: 95vw;\n      height: 600px;\n      max-height: 85vh;\n      background: #1e1e1e;\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: var(--radius-lg);\n      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.85);\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n    }\n\n    .notepad-header {\n      height: 38px;\n      background: #252526;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 14px;\n      border-bottom: 1px solid var(--border-color);\n    }\n\n    .notepad-title {\n      font-size: 12px;\n      font-weight: 500;\n      color: #fff;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .notepad-body {\n      flex: 1;\n      padding: 12px;\n      overflow: auto;\n      background: #181818;\n      font-family: 'Consolas', 'Courier New', monospace;\n      font-size: 13px;\n      line-height: 1.5;\n      color: #d4d4d4;\n      white-space: pre-wrap;\n      word-break: break-all;\n    }\n\n    .notepad-footer {\n      height: 36px;\n      background: #252526;\n      border-top: 1px solid var(--border-color);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 14px;\n    }\n\n    .btn-action {\n      background: var(--accent-fill);\n      color: #fff;\n      border: none;\n      border-radius: var(--radius-sm);\n      padding: 5px 12px;\n      font-size: 12px;\n      font-weight: 500;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .btn-action:hover { background: #0078d4; }\n\n    /* Mobile toggle */\n    .mobile-menu-btn {\n      display: none;\n      background: transparent;\n      border: none;\n      color: #fff;\n      cursor: pointer;\n      padding: 4px;\n    }\n\n    @media (max-width: 768px) {\n      .sidebar {\n        position: absolute;\n        top: 0;\n        bottom: 0;\n        left: -260px;\n        z-index: 100;\n        transition: left 0.25s ease;\n      }\n      .sidebar.open { left: 0; }\n      .mobile-menu-btn { display: block; }\n      .search-box { width: 140px; }\n      .drives-grid { grid-template-columns: 1fr; }\n      .perf-grid { grid-template-columns: 1fr; }\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"win11-window\">\n  <!-- Title Bar -->\n  <div class=\"title-bar\">\n    <div class=\"title-left\">\n      <button class=\"mobile-menu-btn\" onclick=\"toggleSidebar()\" title=\"Toggle Sidebar\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z\"/></svg>\n      </button>\n\n      <!-- Windows 11 PC Logo -->\n      <div class=\"my-computer-logo\" onclick=\"openThisPC()\" title=\"This PC / My Computer\">\n        <svg viewBox=\"0 0 48 48\" width=\"24\" height=\"24\">\n          <rect x=\"4\" y=\"6\" width=\"40\" height=\"28\" rx=\"4\" fill=\"#0078d4\"/>\n          <rect x=\"7\" y=\"9\" width=\"34\" height=\"22\" rx=\"2\" fill=\"#1b1b1b\"/>\n          <path d=\"M12 14h10v10H12z\" fill=\"#00adf2\"/>\n          <path d=\"M26 14h10v10H26z\" fill=\"#0078d4\"/>\n          <path d=\"M18 34h12v4H18z\" fill=\"#808080\"/>\n          <path d=\"M14 38h20v3H14z\" fill=\"#a0a0a0\"/>\n        </svg>\n      </div>\n\n      <!-- Main Navigation Tabs -->\n      <div class=\"tab-bar\">\n        <div class=\"win11-tab active\" id=\"tabExplorer\" onclick=\"switchMainTab('explorer')\">\n          <svg viewBox=\"0 0 16 16\" width=\"14\" height=\"14\" fill=\"#0078d4\"><path d=\"M1 2.5A1.5 1.5 0 0 1 2.5 1h3.707a1.5 1.5 0 0 1 1.06.44l1.293 1.293A.5.5 0 0 0 8.914 3H13.5A1.5 1.5 0 0 1 15 4.5v8a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 12.5v-10z\"/></svg>\n          <span id=\"tabTitle\">This PC</span>\n        </div>\n        <div class=\"win11-tab\" id=\"tabTaskMgr\" onclick=\"switchMainTab('taskmgr')\">\n          <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"#f0883e\"><path d=\"M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z\"/></svg>\n          <span>⚡ CPU Activity & Task Manager</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Live Performance Pill in Header -->\n    <div style=\"display:flex; align-items:center;\">\n      <div class=\"header-perf-ticker\" onclick=\"switchMainTab('taskmgr')\" title=\"Click to view CPU & Resource Activity\">\n        <span class=\"perf-pulse\"></span>\n        <span>CPU: <strong id=\"topCpuVal\" style=\"color:var(--yellow);\">--%</strong></span>\n        <span class=\"perf-divider\">|</span>\n        <span>RAM: <strong id=\"topRamVal\" style=\"color:var(--accent-blue);\">-- GB</strong></span>\n      </div>\n\n      <div class=\"title-controls\">\n        <div class=\"win-btn\" title=\"Minimize\">&#8211;</div>\n        <div class=\"win-btn\" title=\"Maximize\">&#9633;</div>\n        <div class=\"win-btn close\" title=\"Close\">&times;</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Command Ribbon -->\n  <div class=\"command-ribbon\">\n    <div class=\"ribbon-btn active\" id=\"btnRibbonThisPC\" onclick=\"openThisPC()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"#0078d4\"><path d=\"M4 6h16v12H4z M2 4v16h20V4H2z\"/></svg>\n      <span>This PC (My Computer)</span>\n    </div>\n    <div class=\"ribbon-btn\" id=\"btnRibbonTaskMgr\" onclick=\"switchMainTab('taskmgr')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"#f0883e\"><path d=\"M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z\"/></svg>\n      <span>⚡ Live CPU Activity</span>\n    </div>\n    <div class=\"ribbon-separator\"></div>\n    <div class=\"ribbon-btn\" onclick=\"openStandaloneMonitor()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"#58a6ff\"><path d=\"M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z\"/></svg>\n      <span>🌐 Full Live Monitor (New Tab)</span>\n    </div>\n    <div class=\"ribbon-separator\"></div>\n    <div class=\"ribbon-btn\" onclick=\"refreshCurrent()\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z\"/></svg>\n      <span>Refresh</span>\n    </div>\n    <div class=\"ribbon-btn\" onclick=\"toggleViewMode()\">\n      <svg id=\"viewModeIcon\" viewBox=\"0 0 24 24\"><path d=\"M4 11h5V5H4v6zm0 7h5v-6H4v6zm6 0h5v-6h-5v6zm6 0h5v-6h-5v6zm-6-7h5V5h-5v6zm6-6v6h5V5h-5z\"/></svg>\n      <span id=\"viewModeText\">Grid View</span>\n    </div>\n    <div class=\"ribbon-separator\"></div>\n    <div class=\"ribbon-btn\" onclick=\"navigateTo('/home/azureuser/IrakIroan')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"#60cdff\"><path d=\"M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z\"/></svg>\n      <span>IrakIroan Workspace</span>\n    </div>\n    <div class=\"ribbon-btn\" onclick=\"navigateTo('/home/azureuser/IrakIroan/Google_Drive_Backup/Extracted files/mdkamruzzamanirak_gmail_com')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"#a6e3a1\"><path d=\"M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z\"/></svg>\n      <span>Google Drive Extracted</span>\n    </div>\n  </div>\n\n  <!-- Address & Search Bar -->\n  <div class=\"address-bar-area\" id=\"addressBarArea\">\n    <button class=\"nav-btn\" id=\"btnBack\" onclick=\"goBack()\" title=\"Back\" disabled>\n      <svg viewBox=\"0 0 24 24\"><path d=\"M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z\"/></svg>\n    </button>\n    <button class=\"nav-btn\" id=\"btnForward\" onclick=\"goForward()\" title=\"Forward\" disabled>\n      <svg viewBox=\"0 0 24 24\"><path d=\"M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z\"/></svg>\n    </button>\n    <button class=\"nav-btn\" id=\"btnUp\" onclick=\"goUp()\" title=\"Up to parent folder\" disabled>\n      <svg viewBox=\"0 0 24 24\"><path d=\"M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z\"/></svg>\n    </button>\n\n    <div class=\"breadcrumbs-box\" id=\"breadcrumbsBox\">\n      <!-- Breadcrumb pills inserted dynamically -->\n    </div>\n\n    <div class=\"search-box\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"#a0a0a0\"><path d=\"M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/></svg>\n      <input type=\"text\" class=\"search-input\" id=\"searchInput\" placeholder=\"Search current folder...\" onkeyup=\"handleSearch(event)\">\n    </div>\n  </div>\n\n  <!-- Workspace Body -->\n  <div class=\"workspace-body\">\n    <!-- Left Navigation Sidebar -->\n    <div class=\"sidebar\" id=\"sidebar\">\n      <div class=\"sidebar-section\">\n        <div class=\"sidebar-title\">System & Monitor</div>\n        <div class=\"sidebar-item\" onclick=\"openThisPC()\">\n          <svg viewBox=\"0 0 48 48\" width=\"16\" height=\"16\">\n            <rect x=\"4\" y=\"6\" width=\"40\" height=\"28\" rx=\"4\" fill=\"#0078d4\"/>\n            <rect x=\"7\" y=\"9\" width=\"34\" height=\"22\" rx=\"2\" fill=\"#1b1b1b\"/>\n            <path d=\"M18 34h12v4H18z\" fill=\"#808080\"/>\n            <path d=\"M14 38h20v3H14z\" fill=\"#a0a0a0\"/>\n          </svg>\n          <span>This PC (My Computer)</span>\n        </div>\n        <div class=\"sidebar-item\" onclick=\"switchMainTab('taskmgr')\">\n          <svg viewBox=\"0 0 24 24\" fill=\"#f0883e\"><path d=\"M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z\"/></svg>\n          <span>⚡ CPU Activity & Monitor</span>\n        </div>\n      </div>\n\n      <div class=\"sidebar-section\">\n        <div class=\"sidebar-title\">Quick Access</div>\n        <div class=\"sidebar-item\" onclick=\"navigateTo('/home/azureuser')\">\n          <svg viewBox=\"0 0 24 24\" fill=\"#60cdff\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"/></svg>\n          <span>Azure User Home</span>\n        </div>\n        <div class=\"sidebar-item\" onclick=\"navigateTo('/home/azureuser/IrakIroan')\">\n          <svg viewBox=\"0 0 24 24\" fill=\"#f9e2af\"><path d=\"M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z\"/></svg>\n          <span>IrakIroan Workspace</span>\n        </div>\n        <div class=\"sidebar-item\" onclick=\"navigateTo('/home/azureuser/GCP_FULL_BACKUP')\">\n          <svg viewBox=\"0 0 24 24\" fill=\"#fab387\"><path d=\"M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z\"/></svg>\n          <span>GCP Backup Vault</span>\n        </div>\n        <div class=\"sidebar-item\" onclick=\"navigateTo('/home/azureuser/AGY-MASTER')\">\n          <svg viewBox=\"0 0 24 24\" fill=\"#cba6f7\"><path d=\"M12 2L1 21h22L12 2zm0 3.5L19.5 19h-15L12 5.5z\"/></svg>\n          <span>AGY-MASTER Architecture</span>\n        </div>\n      </div>\n\n      <div class=\"sidebar-section\">\n        <div class=\"sidebar-title\">Devices & Drives</div>\n        <div class=\"sidebar-item\" onclick=\"navigateTo('/')\">\n          <svg viewBox=\"0 0 24 24\" fill=\"#89b4fa\"><path d=\"M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z\"/></svg>\n          <span>Local Disk (C:)</span>\n        </div>\n        <div class=\"sidebar-item\" onclick=\"navigateTo('/home')\">\n          <svg viewBox=\"0 0 24 24\" fill=\"#a6e3a1\"><path d=\"M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z\"/></svg>\n          <span>Data Disk (D:)</span>\n        </div>\n      </div>\n\n      <div class=\"sidebar-section\">\n        <div class=\"sidebar-title\">Server Host</div>\n        <div class=\"sidebar-item\" style=\"cursor:default;\">\n          <svg viewBox=\"0 0 24 24\" fill=\"#f38ba8\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"/></svg>\n          <span>Azure VM: FatehAli</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content Area (File Explorer) -->\n    <div class=\"content-area\" id=\"explorerArea\">\n      <!-- Drives & Live CPU Activity (Visible on \"This PC\") -->\n      <div id=\"drivesView\" style=\"display:none; overflow-y:auto;\">\n        \n        <!-- Live CPU & RAM Performance Card on This PC -->\n        <div class=\"perf-card-container\">\n          <div class=\"section-header\" style=\"margin-bottom:8px;\">\n            <div style=\"display:flex; align-items:center; gap:8px;\">\n              <span class=\"perf-pulse\"></span>\n              <span style=\"font-weight:600; color:var(--text-main);\">লাইভ CPU Activity ও রিসোর্স মনিটর · Azure VM (FatehAli)</span>\n            </div>\n            <div style=\"display:flex; align-items:center; gap:10px;\">\n              <span style=\"font-size:11px; color:#2ea043; font-weight:600;\" id=\"liveHeartbeat\">● LIVE</span>\n              <button class=\"mini-btn\" onclick=\"switchMainTab('taskmgr')\">সম্পূর্ণ Task Manager খুলুন &#8594;</button>\n            </div>\n          </div>\n\n          <div class=\"perf-grid\">\n            <!-- CPU Activity Card -->\n            <div class=\"perf-box\">\n              <div class=\"perf-box-header\">\n                <span class=\"perf-box-title\">⚡ সার্বিক CPU লোড</span>\n                <span class=\"perf-box-tag\" id=\"cpuCoresLabel\">4 vCPUs</span>\n              </div>\n              <div class=\"perf-box-value\" id=\"pcpuOverall\" style=\"color:var(--yellow);\">0.0%</div>\n              <div class=\"progress-bar-container\" style=\"height:7px; margin:8px 0 10px 0;\">\n                <div id=\"pcpuBar\" class=\"progress-fill warning\" style=\"width:0%;\"></div>\n              </div>\n              <div class=\"core-mini-grid\" id=\"coreMiniGrid\">\n                <!-- Rendered dynamically -->\n              </div>\n            </div>\n\n            <!-- RAM Activity Card -->\n            <div class=\"perf-box\">\n              <div class=\"perf-box-header\">\n                <span class=\"perf-box-title\">🧠 সার্বিক RAM ব্যবহার</span>\n                <span class=\"perf-box-tag\" id=\"ramAvailLabel\">ফ্রি: 0 GB</span>\n              </div>\n              <div class=\"perf-box-value\" id=\"pramOverall\" style=\"color:var(--accent-blue);\">0.0 GB <span style=\"font-size:12px; font-weight:400; color:var(--text-muted);\">/ 15.6 GB</span></div>\n              <div class=\"progress-bar-container\" style=\"height:7px; margin:8px 0 10px 0;\">\n                <div id=\"pramBar\" class=\"progress-fill\" style=\"width:0%;\"></div>\n              </div>\n              <div style=\"font-size:11px; color:var(--text-muted); display:flex; justify-content:space-between;\">\n                <span id=\"pramPercent\">ব্যবহার: 0%</span>\n                <span>ফিজিক্যাল মেমোরি</span>\n              </div>\n            </div>\n\n            <!-- Top Active Apps Card -->\n            <div class=\"perf-box\">\n              <div class=\"perf-box-header\">\n                <span class=\"perf-box-title\">🚀 সক্রিয় শীর্ষ সার্ভিসসমূহ</span>\n                <span class=\"perf-box-tag\" style=\"background:#21262d; color:#58a6ff;\">Top Apps</span>\n              </div>\n              <div class=\"top-apps-mini-list\" id=\"topAppsMiniList\">\n                <div style=\"font-size:11px; color:#888;\">লোড হচ্ছে...</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"section-header\">\n          <span>Devices and Drives</span>\n          <span style=\"font-size:11px; color:var(--text-muted);\">Azure Virtual Machine FatehAli</span>\n        </div>\n        <div class=\"drives-grid\" id=\"drivesList\">\n          <!-- Drive cards rendered here -->\n        </div>\n\n        <div class=\"section-header\" style=\"margin-top:14px;\">\n          <span>Workspace Directories</span>\n        </div>\n      </div>\n\n      <!-- File Details Table View -->\n      <div class=\"files-container\" id=\"detailsViewContainer\">\n        <table class=\"files-table\">\n          <thead>\n            <tr>\n              <th style=\"width:40%;\">Name</th>\n              <th style=\"width:25%;\">Date modified</th>\n              <th style=\"width:20%;\">Type</th>\n              <th style=\"width:15%; text-align:right;\">Size</th>\n            </tr>\n          </thead>\n          <tbody id=\"filesTableBody\">\n            <!-- Files rendered here -->\n          </tbody>\n        </table>\n      </div>\n\n      <!-- File Grid View -->\n      <div class=\"files-grid-view\" id=\"gridViewContainer\" style=\"display:none;\">\n        <!-- Grid items rendered here -->\n      </div>\n    </div>\n\n    <!-- Task Manager & CPU Monitor Area -->\n    <div class=\"taskmgr-area\" id=\"taskmgrArea\" style=\"display:none;\">\n      <div class=\"taskmgr-header\">\n        <div>\n          <h2 style=\"font-size:16px; font-weight:600; color:#fff; display:flex; align-items:center; gap:8px;\">\n            <span class=\"perf-pulse\"></span>\n            <span>Windows 11 Task Manager · Azure VM (FatehAli)</span>\n          </h2>\n          <div style=\"font-size:11px; color:var(--text-muted); margin-top:2px;\">\n            সার্বিক প্রসেসর, র‍্যাম ও ব্যাকগ্রাউন্ড টাস্কের রিয়েল-টাইম পারফরম্যান্স ট্র্যাকার\n          </div>\n        </div>\n        <div style=\"display:flex; gap:8px;\">\n          <button class=\"mini-btn\" onclick=\"openStandaloneMonitor()\" style=\"padding:6px 12px; font-size:12px;\">🌐 মূল লাইভ মনিটরে যান &#8599;</button>\n          <button class=\"mini-btn\" onclick=\"switchMainTab('explorer')\" style=\"padding:6px 12px; font-size:12px;\">📁 ফাইল এক্সপ্লোরার</button>\n        </div>\n      </div>\n\n      <!-- Live Performance Cards -->\n      <div class=\"perf-grid\">\n        <div class=\"perf-box\">\n          <div class=\"perf-box-header\">\n            <span class=\"perf-box-title\">⚡ CPU Overall Load</span>\n            <span class=\"perf-box-tag\" id=\"tmCpuCores\">4 Cores</span>\n          </div>\n          <div class=\"perf-box-value\" id=\"tmCpuVal\" style=\"color:var(--yellow);\">0.0%</div>\n          <div class=\"progress-bar-container\" style=\"height:8px; margin:8px 0 10px 0;\">\n            <div id=\"tmCpuBar\" class=\"progress-fill warning\" style=\"width:0%;\"></div>\n          </div>\n          <div class=\"core-mini-grid\" id=\"tmCoreGrid\"></div>\n        </div>\n\n        <div class=\"perf-box\">\n          <div class=\"perf-box-header\">\n            <span class=\"perf-box-title\">🧠 Physical Memory (RAM)</span>\n            <span class=\"perf-box-tag\" id=\"tmRamAvail\">ফ্রি: 0 GB</span>\n          </div>\n          <div class=\"perf-box-value\" id=\"tmRamVal\" style=\"color:var(--accent-blue);\">0.0 GB <span style=\"font-size:12px; font-weight:400; color:var(--text-muted);\">/ 15.6 GB</span></div>\n          <div class=\"progress-bar-container\" style=\"height:8px; margin:8px 0 10px 0;\">\n            <div id=\"tmRamBar\" class=\"progress-fill\" style=\"width:0%;\"></div>\n          </div>\n          <div style=\"font-size:11px; color:var(--text-muted); display:flex; justify-content:space-between;\">\n            <span id=\"tmRamPercent\">ব্যবহার: 0%</span>\n            <span>Total: 15.62 GB</span>\n          </div>\n        </div>\n\n        <div class=\"perf-box\">\n          <div class=\"perf-box-header\">\n            <span class=\"perf-box-title\">🔄 Swap & System Load</span>\n            <span class=\"perf-box-tag\">Virtual</span>\n          </div>\n          <div class=\"perf-box-value\" id=\"tmSwapVal\" style=\"color:var(--purple);\">0.0 GB</div>\n          <div class=\"progress-bar-container\" style=\"height:8px; margin:8px 0 10px 0;\">\n            <div id=\"tmSwapBar\" class=\"progress-fill\" style=\"width:0%; background:var(--purple);\"></div>\n          </div>\n          <div style=\"font-size:11px; color:var(--text-muted);\">\n            <span>হোস্ট: Debian 12 (x86_64) · Cloud VM</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Real-time Chart Section -->\n      <div class=\"chart-section\">\n        <div class=\"chart-controls\">\n          <div style=\"font-size:13px; font-weight:600; color:#fff; display:flex; align-items:center; gap:8px;\">\n            <span>📈 রিয়েল-টাইম CPU ও RAM গ্রাফ (Live Activity)</span>\n            <span style=\"font-size:10px; color:#2ea043; background:#1b2d20; padding:2px 6px; border-radius:4px;\">● ৩ সেকেন্ড ব্যবধানে আপডেট</span>\n          </div>\n          <div class=\"range-pills\">\n            <div class=\"range-pill active\" onclick=\"setChartRange('1m', this)\">1m</div>\n            <div class=\"range-pill\" onclick=\"setChartRange('5m', this)\">5m</div>\n            <div class=\"range-pill\" onclick=\"setChartRange('15m', this)\">15m</div>\n            <div class=\"range-pill\" onclick=\"setChartRange('30m', this)\">30m</div>\n            <div class=\"range-pill\" onclick=\"setChartRange('1h', this)\">1h</div>\n          </div>\n        </div>\n        <div class=\"canvas-container\">\n          <canvas id=\"perfChart\"></canvas>\n        </div>\n      </div>\n\n      <!-- Process List Section -->\n      <div class=\"proc-section\">\n        <div class=\"proc-controls\">\n          <div style=\"font-size:13px; font-weight:600; color:#fff;\">\n            <span>সক্রিয় প্রসেস তালিকা (Processes)</span>\n          </div>\n          <input type=\"text\" class=\"proc-search\" id=\"procSearchInput\" placeholder=\"প্রসেস বা সার্ভিস খুঁজুন...\" oninput=\"renderProcessTable()\">\n        </div>\n        <div style=\"overflow-x:auto;\">\n          <table class=\"proc-table\">\n            <thead>\n              <tr>\n                <th style=\"width:80px;\">PID</th>\n                <th style=\"width:160px;\">সার্ভিস / অ্যাপ</th>\n                <th>কমান্ড পাথ</th>\n                <th style=\"width:90px; text-align:right;\">CPU %</th>\n                <th style=\"width:100px; text-align:right;\">RAM (MB)</th>\n              </tr>\n            </thead>\n            <tbody id=\"procTableBody\">\n              <!-- Rendered dynamically -->\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Status Bar -->\n  <div class=\"status-bar\">\n    <div id=\"statusLeft\">Loading...</div>\n    <div id=\"statusRight\">Microsoft Windows 11 · Azure Cloud VM (FatehAli)</div>\n  </div>\n</div>\n\n<!-- Windows 11 Notepad / Preview Modal -->\n<div class=\"modal-overlay\" id=\"notepadModal\">\n  <div class=\"win11-notepad\">\n    <div class=\"notepad-header\">\n      <div class=\"notepad-title\">\n        <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"#60cdff\"><path d=\"M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z\"/></svg>\n        <span id=\"notepadFileName\">file.txt - Notepad</span>\n      </div>\n      <div class=\"win-btn close\" onclick=\"closeNotepad()\">&times;</div>\n    </div>\n    <div class=\"notepad-body\" id=\"notepadContent\"></div>\n    <div class=\"notepad-footer\">\n      <span id=\"notepadFileSize\" style=\"font-size:11px; color:#aaa;\">0 KB</span>\n      <div style=\"display:flex; gap:10px;\">\n        <button class=\"btn-action\" onclick=\"copyNotepadContent()\">Copy Text</button>\n        <button class=\"btn-action\" id=\"btnDownloadFile\" style=\"background:#0078d4;\">Download File</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  let currentPath = \"/home/azureuser\";\n  let historyStack = [];\n  let historyIndex = -1;\n  let viewMode = \"details\"; // \"details\" or \"grid\"\n  let currentItems = [];\n  let currentMainTab = 'explorer'; // 'explorer' or 'taskmgr'\n  let currentStats = null;\n  let historyData = [];\n  let currentChartRange = '5m';\n  let standaloneUrl = \"https://memories-birth-outer-speeches.trycloudflare.com\";\n\n  const icons = {\n    folder: `<svg class=\"file-icon\" viewBox=\"0 0 24 24\"><path fill=\"#f9e2af\" d=\"M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z\"/></svg>`,\n    zip: `<svg class=\"file-icon\" viewBox=\"0 0 24 24\"><path fill=\"#f38ba8\" d=\"M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13h-3v3H9v-3H6v-2h3V8h2v3h3v2z\"/></svg>`,\n    code: `<svg class=\"file-icon\" viewBox=\"0 0 24 24\"><path fill=\"#89b4fa\" d=\"M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z\"/></svg>`,\n    python: `<svg class=\"file-icon\" viewBox=\"0 0 24 24\"><path fill=\"#fab387\" d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93z\"/></svg>`,\n    markdown: `<svg class=\"file-icon\" viewBox=\"0 0 24 24\"><path fill=\"#cba6f7\" d=\"M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z\"/></svg>`,\n    database: `<svg class=\"file-icon\" viewBox=\"0 0 24 24\"><path fill=\"#a6e3a1\" d=\"M12 2C6.48 2 2 4.02 2 6.5s4.48 4.5 10 4.5 10-2.02 10-4.5S17.52 2 12 2zm0 7c-4.41 0-8-1.34-8-2.5S7.59 4 12 4s8 1.34 8 2.5S16.41 9 12 9zm-8 4.5c0 1.16 3.59 2.5 8 2.5s8-1.34 8-2.5V11c-1.78 1.25-4.7 2-8 2s-6.22-.75-8-2v2.5zm0 5c0 1.16 3.59 2.5 8 2.5s8-1.34 8-2.5V16c-1.78 1.25-4.7 2-8 2s-6.22-.75-8-2v2.5z\"/></svg>`,\n    generic: `<svg class=\"file-icon\" viewBox=\"0 0 24 24\"><path fill=\"#bac2de\" d=\"M6 2c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6H6zm7 7V3.5L18.5 9H13z\"/></svg>`\n  };\n\n  function getIcon(item) {\n    if (item.is_dir) return icons.folder;\n    const ext = item.ext.toLowerCase();\n    if (['zip', 'tar', 'gz', 'bz2', 'xz', '7z', 'rar'].includes(ext)) return icons.zip;\n    if (['py'].includes(ext)) return icons.python;\n    if (['js', 'ts', 'jsx', 'tsx', 'rs', 'go', 'java', 'c', 'cpp', 'html', 'css', 'json', 'sh'].includes(ext)) return icons.code;\n    if (['md', 'txt', 'log'].includes(ext)) return icons.markdown;\n    if (['sql', 'db', 'sqlite', 'rdb'].includes(ext)) return icons.database;\n    return icons.generic;\n  }\n\n  function getBarColor(pct) {\n    if (pct < 60) return '#2ea043';\n    if (pct < 85) return '#f0883e';\n    return '#f85149';\n  }\n\n  /* Main Tab Switcher: Explorer vs Task Manager */\n  function switchMainTab(tab) {\n    currentMainTab = tab;\n    const explorerArea = document.getElementById('explorerArea');\n    const taskmgrArea = document.getElementById('taskmgrArea');\n    const addressBarArea = document.getElementById('addressBarArea');\n    const tabExplorer = document.getElementById('tabExplorer');\n    const tabTaskMgr = document.getElementById('tabTaskMgr');\n    const btnThisPC = document.getElementById('btnRibbonThisPC');\n    const btnTaskMgr = document.getElementById('btnRibbonTaskMgr');\n\n    if (tab === 'taskmgr') {\n      explorerArea.style.display = 'none';\n      addressBarArea.style.display = 'none';\n      taskmgrArea.style.display = 'flex';\n      tabExplorer.classList.remove('active');\n      tabTaskMgr.classList.add('active');\n      btnThisPC.classList.remove('active');\n      btnTaskMgr.classList.add('active');\n      document.getElementById('statusLeft').textContent = 'Task Manager Active · Real-time CPU & Resource Telemetry';\n      fetchStats();\n      fetchHistory();\n    } else {\n      taskmgrArea.style.display = 'none';\n      explorerArea.style.display = 'flex';\n      addressBarArea.style.display = 'flex';\n      tabExplorer.classList.add('active');\n      tabTaskMgr.classList.remove('active');\n      btnThisPC.classList.add('active');\n      btnTaskMgr.classList.remove('active');\n      refreshCurrent();\n    }\n  }\n\n  /* Standalone Monitor Opener */\n  async function fetchStandaloneUrl() {\n    try {\n      const res = await fetch('/api/monitor_url');\n      const data = await res.json();\n      if (data.url) standaloneUrl = data.url;\n    } catch (e) {}\n  }\n  function openStandaloneMonitor() {\n    window.open(standaloneUrl, '_blank');\n  }\n\n  /* Live Stats Fetcher */\n  async function fetchStats() {\n    try {\n      const res = await fetch('/api/stats');\n      if (!res.ok) return;\n      const data = await res.json();\n      currentStats = data;\n\n      // Title bar ticker\n      const cpuVal = data.cpu_overall || 0;\n      document.getElementById('topCpuVal').textContent = cpuVal.toFixed(1) + '%';\n      document.getElementById('topCpuVal').style.color = getBarColor(cpuVal);\n\n      if (data.ram) {\n        document.getElementById('topRamVal').textContent = `${data.ram.used_gb} GB`;\n      }\n\n      // This PC Card\n      const pCpu = document.getElementById('pcpuOverall');\n      if (pCpu) {\n        pCpu.textContent = cpuVal.toFixed(1) + '%';\n        pCpu.style.color = getBarColor(cpuVal);\n        const pCpuBar = document.getElementById('pcpuBar');\n        pCpuBar.style.width = Math.min(cpuVal, 100) + '%';\n        pCpuBar.style.background = getBarColor(cpuVal);\n\n        // Cores\n        if (data.cpu_cores) {\n          const coreContainer = document.getElementById('coreMiniGrid');\n          coreContainer.innerHTML = data.cpu_cores.map((c, i) => `\n            <div class=\"core-mini-item\">\n              <div class=\"core-mini-lbl\">C${i+1}</div>\n              <div class=\"core-mini-val\" style=\"color:${getBarColor(c)}\">${c}%</div>\n            </div>\n          `).join('');\n        }\n\n        // RAM\n        if (data.ram) {\n          document.getElementById('pramOverall').innerHTML = `${data.ram.used_gb} GB <span style=\"font-size:12px; font-weight:400; color:var(--text-muted);\">/ ${data.ram.total_gb} GB</span>`;\n          document.getElementById('ramAvailLabel').textContent = `ফ্রি: ${data.ram.avail_gb} GB`;\n          const pramBar = document.getElementById('pramBar');\n          pramBar.style.width = data.ram.percent + '%';\n          pramBar.style.background = getBarColor(data.ram.percent);\n          document.getElementById('pramPercent').textContent = `ব্যবহার: ${data.ram.percent}%`;\n        }\n\n        // Top Apps Mini\n        if (data.apps && data.apps.length > 0) {\n          const topList = document.getElementById('topAppsMiniList');\n          topList.innerHTML = data.apps.slice(0, 4).map(a => `\n            <div class=\"top-app-mini-row\">\n              <span class=\"top-app-mini-name\">${a.app}</span>\n              <div class=\"top-app-mini-stats\">\n                <span style=\"color:${getBarColor(a.cpu)}\">${a.cpu}% CPU</span>\n                <span style=\"color:var(--accent-blue);\">${a.ram_gb >= 1.0 ? a.ram_gb + ' GB' : a.ram_mb + ' MB'}</span>\n              </div>\n            </div>\n          `).join('');\n        }\n      }\n\n      // Task Manager Tab Metrics\n      const tmCpu = document.getElementById('tmCpuVal');\n      if (tmCpu) {\n        tmCpu.textContent = cpuVal.toFixed(1) + '%';\n        tmCpu.style.color = getBarColor(cpuVal);\n        const tmCpuBar = document.getElementById('tmCpuBar');\n        tmCpuBar.style.width = Math.min(cpuVal, 100) + '%';\n        tmCpuBar.style.background = getBarColor(cpuVal);\n\n        if (data.cpu_cores) {\n          document.getElementById('tmCoreGrid').innerHTML = data.cpu_cores.map((c, i) => `\n            <div class=\"core-mini-item\">\n              <div class=\"core-mini-lbl\">C${i+1}</div>\n              <div class=\"core-mini-val\" style=\"color:${getBarColor(c)}\">${c}%</div>\n            </div>\n          `).join('');\n        }\n\n        if (data.ram) {\n          document.getElementById('tmRamVal').innerHTML = `${data.ram.used_gb} GB <span style=\"font-size:12px; font-weight:400; color:var(--text-muted);\">/ ${data.ram.total_gb} GB</span>`;\n          document.getElementById('tmRamAvail').textContent = `ফ্রি: ${data.ram.avail_gb} GB`;\n          const tmRamBar = document.getElementById('tmRamBar');\n          tmRamBar.style.width = data.ram.percent + '%';\n          tmRamBar.style.background = getBarColor(data.ram.percent);\n          document.getElementById('tmRamPercent').textContent = `ব্যবহার: ${data.ram.percent}%`;\n        }\n\n        if (data.swap) {\n          document.getElementById('tmSwapVal').textContent = `${data.swap.used_gb} GB / ${data.swap.total_gb} GB`;\n          document.getElementById('tmSwapBar').style.width = data.swap.percent + '%';\n        }\n\n        renderProcessTable();\n      }\n    } catch (e) {\n      console.error(\"fetchStats error:\", e);\n    }\n  }\n\n  /* Process Table in Task Manager */\n  function renderProcessTable() {\n    if (!currentStats || !currentStats.top_procs) return;\n    const filter = (document.getElementById('procSearchInput')?.value || '').toLowerCase();\n    const tbody = document.getElementById('procTableBody');\n    if (!tbody) return;\n\n    let procs = currentStats.top_procs;\n    if (filter) {\n      procs = procs.filter(p => (p.name && p.name.toLowerCase().includes(filter)) || (p.app && p.app.toLowerCase().includes(filter)) || (p.cmd && p.cmd.toLowerCase().includes(filter)));\n    }\n\n    if (procs.length === 0) {\n      tbody.innerHTML = `<tr><td colspan=\"5\" style=\"text-align:center; padding:16px; color:#888;\">কোনো প্রসেস পাওয়া যায়নি</td></tr>`;\n      return;\n    }\n\n    tbody.innerHTML = procs.slice(0, 30).map(p => `\n      <tr>\n        <td style=\"color:#8b949e; font-family:monospace;\">${p.pid}</td>\n        <td><strong style=\"color:#f0f6fc;\">${p.name || 'proc'}</strong> <span style=\"font-size:10px; color:#bc8cff; background:#21192e; padding:1px 4px; border-radius:3px;\">${p.app}</span></td>\n        <td style=\"color:#8b949e; font-family:monospace; font-size:10px; max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;\" title=\"${p.cmd}\">${p.cmd}</td>\n        <td style=\"text-align:right; font-weight:600; color:${getBarColor(p.cpu)};\">${p.cpu}%</td>\n        <td style=\"text-align:right; font-weight:600; color:var(--accent-blue);\">${p.ram_mb >= 1024 ? (p.ram_mb/1024).toFixed(2) + ' GB' : p.ram_mb + ' MB'}</td>\n      </tr>\n    `).join('');\n  }\n\n  /* History & Canvas Drawing */\n  function setChartRange(range, el) {\n    currentChartRange = range;\n    document.querySelectorAll('.range-pill').forEach(p => p.classList.remove('active'));\n    if (el) el.classList.add('active');\n    fetchHistory();\n  }\n\n  async function fetchHistory() {\n    try {\n      const res = await fetch(`/api/history?range=${currentChartRange}`);\n      if (!res.ok) return;\n      const data = await res.json();\n      if (Array.isArray(data)) {\n        historyData = data;\n        drawPerfChart();\n      }\n    } catch (e) {\n      console.error(\"fetchHistory error:\", e);\n    }\n  }\n\n  function drawPerfChart() {\n    const canvas = document.getElementById('perfChart');\n    if (!canvas) return;\n    const ctx = canvas.getContext('2d');\n    const width = canvas.parentElement.clientWidth;\n    const height = canvas.parentElement.clientHeight;\n    canvas.width = width;\n    canvas.height = height;\n\n    ctx.clearRect(0, 0, width, height);\n\n    // Draw grid\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';\n    ctx.lineWidth = 1;\n    for (let y = 0; y < height; y += 40) {\n      ctx.beginPath();\n      ctx.moveTo(0, y);\n      ctx.lineTo(width, y);\n      ctx.stroke();\n    }\n\n    if (!historyData || historyData.length < 2) {\n      ctx.fillStyle = '#888';\n      ctx.font = '12px Segoe UI';\n      ctx.textAlign = 'center';\n      ctx.fillText('পারফরম্যান্স হিস্ট্রি ডেটা লোড হচ্ছে...', width / 2, height / 2);\n      return;\n    }\n\n    const n = historyData.length;\n    const stepX = width / (n - 1);\n\n    // Draw RAM % line (Blue)\n    ctx.strokeStyle = '#58a6ff';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    historyData.forEach((pt, i) => {\n      const val = pt.ram_pct || 0;\n      const x = i * stepX;\n      const y = height - (val / 100) * height;\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    });\n    ctx.stroke();\n\n    // Draw CPU % line (Orange)\n    ctx.strokeStyle = '#f0883e';\n    ctx.lineWidth = 2.2;\n    ctx.beginPath();\n    historyData.forEach((pt, i) => {\n      const val = pt.cpu || 0;\n      const x = i * stepX;\n      const y = height - (val / 100) * height;\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    });\n    ctx.stroke();\n\n    // Legend\n    ctx.fillStyle = '#f0883e';\n    ctx.fillRect(16, 14, 10, 10);\n    ctx.fillStyle = '#fff';\n    ctx.font = '11px Segoe UI';\n    ctx.textAlign = 'left';\n    ctx.fillText('CPU %', 32, 23);\n\n    ctx.fillStyle = '#58a6ff';\n    ctx.fillRect(90, 14, 10, 10);\n    ctx.fillStyle = '#fff';\n    ctx.fillText('RAM %', 106, 23);\n  }\n\n  /* File Explorer Navigation & Operations */\n  async function loadDrives() {\n    try {\n      const res = await fetch('/api/drives');\n      const data = await res.json();\n      const container = document.getElementById('drivesList');\n      container.innerHTML = '';\n      data.drives.forEach(d => {\n        const card = document.createElement('div');\n        card.className = 'drive-card';\n        card.onclick = () => navigateTo(d.path);\n        \n        let barClass = 'progress-fill';\n        if (d.percent > 90) barClass += ' danger';\n        else if (d.percent > 75) barClass += ' warning';\n\n        card.innerHTML = `\n          <div class=\"drive-icon\">\n            <svg viewBox=\"0 0 48 48\" width=\"44\" height=\"44\">\n              <rect x=\"6\" y=\"10\" width=\"36\" height=\"28\" rx=\"4\" fill=\"#0078d4\"/>\n              <rect x=\"9\" y=\"13\" width=\"30\" height=\"22\" rx=\"2\" fill=\"#202020\"/>\n              <path d=\"M12 30h24v2H12z\" fill=\"#00adf2\"/>\n              <circle cx=\"35\" cy=\"18\" r=\"2\" fill=\"#60cdff\"/>\n            </svg>\n          </div>\n          <div class=\"drive-details\">\n            <div class=\"drive-name\">${d.label}</div>\n            <div class=\"progress-bar-container\">\n              <div class=\"${barClass}\" style=\"width: ${d.percent || 100}%;\"></div>\n            </div>\n            <div class=\"drive-meta\">${d.free_str} free of ${d.total_str}</div>\n          </div>\n        `;\n        container.appendChild(card);\n      });\n    } catch (e) {\n      console.error(e);\n    }\n  }\n\n  async function navigateTo(targetPath, addToHistory = true) {\n    if (currentMainTab === 'taskmgr') {\n      switchMainTab('explorer');\n    }\n\n    if (addToHistory) {\n      if (historyIndex < historyStack.length - 1) {\n        historyStack = historyStack.slice(0, historyIndex + 1);\n      }\n      historyStack.push(targetPath);\n      historyIndex = historyStack.length - 1;\n    }\n    updateNavButtons();\n\n    currentPath = targetPath;\n    document.getElementById('statusLeft').textContent = `Loading ${targetPath}...`;\n\n    const isThisPC = (targetPath === 'THIS_PC');\n    if (isThisPC) {\n      document.getElementById('drivesView').style.display = 'block';\n      document.getElementById('tabTitle').textContent = 'This PC';\n      document.getElementById('breadcrumbsBox').innerHTML = `<div class=\"crumb-pill\" onclick=\"openThisPC()\"><strong>This PC</strong></div>`;\n      await loadDrives();\n      targetPath = '/home/azureuser';\n    } else {\n      document.getElementById('drivesView').style.display = 'none';\n      document.getElementById('tabTitle').textContent = targetPath.split('/').pop() || 'Root';\n    }\n\n    try {\n      const res = await fetch(`/api/browse?path=${encodeURIComponent(targetPath)}`);\n      const data = await res.json();\n\n      if (data.error && !data.items) {\n        alert(\"Error: \" + data.error);\n        return;\n      }\n\n      currentItems = data.items || [];\n      renderBreadcrumbs(data.breadcrumbs || []);\n      renderFiles(currentItems);\n\n      document.getElementById('statusLeft').textContent = `${data.total_items || 0} items | Folders: ${data.total_folders || 0}, Files: ${data.total_files || 0} (${data.total_size_str || '0 B'})`;\n    } catch (err) {\n      document.getElementById('statusLeft').textContent = `Error loading folder`;\n      console.error(err);\n    }\n  }\n\n  function renderBreadcrumbs(crumbs) {\n    const box = document.getElementById('breadcrumbsBox');\n    box.innerHTML = '';\n    crumbs.forEach((c, idx) => {\n      const pill = document.createElement('div');\n      pill.className = 'crumb-pill';\n      pill.textContent = c.name;\n      pill.onclick = () => navigateTo(c.path);\n      box.appendChild(pill);\n\n      if (idx < crumbs.length - 1) {\n        const arrow = document.createElement('span');\n        arrow.className = 'crumb-arrow';\n        arrow.innerHTML = '&#9656;';\n        box.appendChild(arrow);\n      }\n    });\n  }\n\n  function renderFiles(items) {\n    const tableBody = document.getElementById('filesTableBody');\n    const gridView = document.getElementById('gridViewContainer');\n    tableBody.innerHTML = '';\n    gridView.innerHTML = '';\n\n    if (!items || items.length === 0) {\n      tableBody.innerHTML = `<tr><td colspan=\"4\" style=\"text-align:center; padding:20px; color:#888;\">This folder is empty.</td></tr>`;\n      gridView.innerHTML = `<div style=\"grid-column:1/-1; text-align:center; padding:40px; color:#888;\">This folder is empty.</div>`;\n      return;\n    }\n\n    items.forEach(item => {\n      // Details view row\n      const tr = document.createElement('tr');\n      tr.onclick = (e) => handleItemClick(item, e);\n      tr.ondblclick = () => handleItemOpen(item);\n      tr.innerHTML = `\n        <td>\n          <div class=\"col-name\">\n            ${getIcon(item)}\n            <span>${item.name}</span>\n          </div>\n        </td>\n        <td>${item.mtime_str || '-'}</td>\n        <td>${item.type_name || '-'}</td>\n        <td style=\"text-align:right;\">${item.size_str || ''}</td>\n      `;\n      tableBody.appendChild(tr);\n\n      // Grid view card\n      const card = document.createElement('div');\n      card.className = 'grid-item';\n      card.onclick = (e) => handleItemClick(item, e);\n      card.ondblclick = () => handleItemOpen(item);\n      card.innerHTML = `\n        ${getIcon(item)}\n        <div class=\"item-title\" title=\"${item.name}\">${item.name}</div>\n      `;\n      gridView.appendChild(card);\n    });\n  }\n\n  function handleItemClick(item, e) {\n    document.querySelectorAll('.files-table tr, .grid-item').forEach(el => el.classList.remove('selected'));\n    if (e.currentTarget) e.currentTarget.classList.add('selected');\n    document.getElementById('statusLeft').textContent = `Selected: ${item.name} (${item.size_str || 'Folder'})`;\n  }\n\n  function handleItemOpen(item) {\n    if (item.is_dir) {\n      navigateTo(item.path);\n    } else {\n      openFilePreview(item.path, item.name);\n    }\n  }\n\n  async function openFilePreview(filePath, fileName) {\n    const modal = document.getElementById('notepadModal');\n    const title = document.getElementById('notepadFileName');\n    const content = document.getElementById('notepadContent');\n    const size = document.getElementById('notepadFileSize');\n    const downloadBtn = document.getElementById('btnDownloadFile');\n\n    title.textContent = `${fileName} - Notepad`;\n    content.textContent = 'Loading file preview...';\n    modal.classList.add('active');\n\n    downloadBtn.onclick = () => {\n      window.open(`/api/raw?path=${encodeURIComponent(filePath)}&download=1`, '_blank');\n    };\n\n    try {\n      const res = await fetch(`/api/content?path=${encodeURIComponent(filePath)}`);\n      const data = await res.json();\n      if (data.error) {\n        content.textContent = \"Error: \" + data.error;\n      } else {\n        content.textContent = data.content;\n        size.textContent = data.size_str;\n      }\n    } catch (e) {\n      content.textContent = \"Failed to load content: \" + e;\n    }\n  }\n\n  function closeNotepad() {\n    document.getElementById('notepadModal').classList.remove('active');\n  }\n\n  function copyNotepadContent() {\n    const text = document.getElementById('notepadContent').textContent;\n    navigator.clipboard.writeText(text).then(() => {\n      alert(\"File content copied to clipboard!\");\n    });\n  }\n\n  function openThisPC() {\n    navigateTo('THIS_PC');\n  }\n\n  function toggleViewMode() {\n    const detailsContainer = document.getElementById('detailsViewContainer');\n    const gridContainer = document.getElementById('gridViewContainer');\n    const text = document.getElementById('viewModeText');\n\n    if (viewMode === 'details') {\n      viewMode = 'grid';\n      detailsContainer.style.display = 'none';\n      gridContainer.style.display = 'grid';\n      text.textContent = 'Details View';\n    } else {\n      viewMode = 'details';\n      detailsContainer.style.display = 'block';\n      gridContainer.style.display = 'none';\n      text.textContent = 'Grid View';\n    }\n  }\n\n  function refreshCurrent() {\n    navigateTo(currentPath, false);\n    fetchStats();\n  }\n\n  function goBack() {\n    if (historyIndex > 0) {\n      historyIndex--;\n      navigateTo(historyStack[historyIndex], false);\n      updateNavButtons();\n    }\n  }\n\n  function goForward() {\n    if (historyIndex < historyStack.length - 1) {\n      historyIndex++;\n      navigateTo(historyStack[historyIndex], false);\n      updateNavButtons();\n    }\n  }\n\n  function goUp() {\n    if (currentPath === '/' || currentPath === 'THIS_PC') return;\n    const parts = currentPath.split('/').filter(Boolean);\n    parts.pop();\n    const parent = parts.length === 0 ? '/' : '/' + parts.join('/');\n    navigateTo(parent);\n  }\n\n  function updateNavButtons() {\n    document.getElementById('btnBack').disabled = (historyIndex <= 0);\n    document.getElementById('btnForward').disabled = (historyIndex >= historyStack.length - 1);\n    document.getElementById('btnUp').disabled = (currentPath === '/' || currentPath === 'THIS_PC');\n  }\n\n  function toggleSidebar() {\n    document.getElementById('sidebar').classList.toggle('open');\n  }\n\n  function handleSearch(e) {\n    const query = e.target.value.toLowerCase().trim();\n    if (!query) {\n      renderFiles(currentItems);\n      return;\n    }\n    const filtered = currentItems.filter(x => x.name.toLowerCase().includes(query));\n    renderFiles(filtered);\n  }\n\n  // Periodic Telemetry Loop\n  fetchStandaloneUrl();\n  fetchStats();\n  setInterval(fetchStats, 1500);\n  setInterval(() => {\n    if (currentMainTab === 'taskmgr') {\n      fetchHistory();\n    }\n  }, 3000);\n\n  window.addEventListener('resize', () => {\n    if (currentMainTab === 'taskmgr') drawPerfChart();\n  });\n\n  // Initial Load\n  window.addEventListener('DOMContentLoaded', () => {\n    openThisPC();\n  });\n</script>\n\n</body>\n</html>\n","Description":"Update Windows 11 Explorer interface to integrate real-time CPU & RAM activity, task manager, and standalone monitor links","Overwrite":true,"TargetFile":"/home/azureuser/IrakIroan/azure_file_explorer/static/index.html","toolAction":"Updating index.html","toolSummary":"Integrate CPU activity in index.html"}}]}
