{"step_index":11816,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-26T16:31:45Z","content":"Created At: 2026-09-26T16:31:45Z\nCompleted At: 2026-09-26T16:31:45Z\nFile Path: `file:///home/azureuser/AGY-MASTER/POLICIES/delete_guard.py`\nTotal Lines: 250\nTotal Bytes: 10680\nShowing lines 1 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Comprehensive Delete Guard Hook (Iraq Bhai's 40-Point Delete-Proof Architecture Specification)\n4: Intercepts all destructive operations at the PreToolUse stage.\n5: Enforces: Global Delete = PROHIBITED across CLI, Shell, Python, Subprocesses, and Child Agents.\n6: \"\"\"\n7: \n8: import sys\n9: import os\n10: import re\n11: import json\n12: import shlex\n13: import uuid\n14: from datetime import datetime, timezone\n15: from pathlib import Path\n16: \n17: REGISTRY_PATH = \"/home/azureuser/AGY-MASTER/POLICIES/protected_registry.json\"\n18: INCIDENT_DIR = \"/home/azureuser/AGY-MASTER/INCIDENTS/active\"\n19: INCIDENT_LOG = \"/home/azureuser/AGY-MASTER/INCIDENTS/delete_attempts.jsonl\"\n20: ARCHIVE_ROOT = \"/home/azureuser/GLOBAL-ARCHIVE\"\n21: \n22: # Load Protected Registry\n23: PROTECTED_WORKSPACES = [\n24:     \"/home/azureuser/AGY-MASTER\",\n25:     \"/home/azureuser/Frappe-erp-Alco\",\n26:     \"/home/azureuser/Rust_Task_With_Time_Keeping_And_Live_Note\",\n27:     \"/home/azureuser/kids_tube_with_folder_seection\",\n28:     \"/home/azureuser/Article-Publishing-Platform\",\n29:     \"/home/azureuser/3D-Game-Design-Studio\",\n30:     \"/home/azureuser/telegram-bot\",\n31:     \"/home/azureuser/Ask-And-Research\",\n32:     \"/home/azureuser/Reporting-Agent\",\n33:     \"/home/azureuser/Action-Agent\",\n34:     \"/home/azureuser/.openclaw\",\n35:     \"/home/azureuser/GLOBAL-ARCHIVE\"\n36: ]\n37: \n38: PROTECTED_CONFIG_PATTERNS = [\n39:     r\".*\\.gemini/config/hooks\\.json$\",\n40:     r\".*AGY-MASTER/POLICIES/.*\",\n41:     r\".*GLOBAL-ARCHIVE/.*\",\n42:     r\".*\\.config/rclone/rclone\\.conf$\",\n43:     r\"/etc/.*\",\n44:     r\"/bin/.*\",\n45:     r\"/sbin/.*\",\n46:     r\"/usr/.*\",\n47:     r\"/boot/.*\",\n48:     r\"/root/.*\"\n49: ]\n50: \n51: def log_incident(tool_name, details, reason, rule_id):\n52:     os.makedirs(INCIDENT_DIR, exist_ok=True)\n53:     os.makedirs(os.path.dirname(INCIDENT_LOG), exist_ok=True)\n54:     \n55:     now = datetime.now(timezone.utc)\n56:     inc_id = f\"INC-DEL-{now.strftime('%Y%m%d%H%M%S')}-{uuid.uuid4().hex[:6]}\"\n57:     \n58:     incident = {\n59:         \"incident_id\": inc_id,\n60:         \"timestamp\": now.isoformat(),\n61:         \"severity\": \"CRITICAL\",\n62:         \"detector\": \"DELETE_GUARD_PRETOOLUSE\",\n63:         \"tool\": tool_name,\n64:         \"details\": details,\n65:         \"decision\": \"DENIED\",\n66:         \"reason\": reason,\n67:         \"rule_id\": rule_id,\n68:         \"safe_alternative\": f\"Move target to {ARCHIVE_ROOT} using /home/azureuser/AGY-MASTER/POLICIES/safe_archive.py\"\n69:     }\n70: \n71:     try:\n72:         inc_file = os.path.join(INCIDENT_DIR, f\"{inc_id}.json\")\n73:         with open(inc_file, \"w\", encoding=\"utf-8\") as f:\n74:             json.dump(incident, f, indent=2)\n75:         with open(INCIDENT_LOG, \"a\", encoding=\"utf-8\") as f:\n76:             f.write(json.dumps(incident) + \"\\n\")\n77:     except Exception as e:\n78:         sys.stderr.write(f\"Failed to log incident: {e}\\n\")\n79: \n80:     return incident\n81: \n82: def is_path_protected_config(target_path):\n83:     target = os.path.abspath(target_path)\n84:     for pat in PROTECTED_CONFIG_PATTERNS:\n85:         if re.search(pat, target):\n86:             return True\n87:     return False\n88: \n89: def inspect_command(command_str):\n90:     # Rule 5: find ... -delete or find ... -exec/execdir/ok rm (including /bin/rm)\n91:     if re.search(r'find\\b.*(?:\\s+-(?:delete|(?:exec|execdir|ok|okdir)\\s+(?:/[a-zA-Z0-9_\\-\\.]+/)?rm\\b))', command_str):\n92:         return True, \"Indirect deletion via 'find -delete / -exec rm' is prohibited (Rule 4, 5)\", \"RULE_4_5_FIND_DELETE\"\n93: \n94:     # Command substitution attempts: `...rm...` or $(...rm...)\n95:     if re.search(r'[`$]\\(?[^`$)]*\\b(?:rm|unlink|rmdir)\\b', command_str):\n96:         return True, \"Command substitution containing deletion command is prohibited (Rule 1, 2)\", \"RULE_1_2_COMMAND_SUBST\"\n97: \n98:     # Wrapper execution attempts: eval 'rm...', sh -c 'rm...', bash -c 'rm...'\n99:     if re.search(r'(?:eval|sh\\s+-c|bash\\s+-c)\\s+.*?\\b(?:rm|unlink|rmdir)\\b', command_str):\n100:         return True, \"Indirect command wrapper invocation of deletion command is prohibited (Rule 1, 2)\", \"RULE_1_2_WRAPPER_DELETE\"\n101: \n102:     # Rule 10: git clean\n103:     if re.search(r'git\\s+clean\\b', command_str):\n104:         return True, \"Destructive 'git clean' operation is prohibited (Rule 10)\", \"RULE_10_GIT_CLEAN\"\n105: \n106:     # Rule 11: git reset --hard\n107:     if re.search(r'git\\s+reset\\s+--hard\\b', command_str):\n108:         return True, \"Destructive 'git reset --hard' is prohibited in protected workspaces (Rule 11)\", \"RULE_11_GIT_RESET_HARD\"\n109: \n110:     # Rule 12: git checkout -- or git restore\n111:     if re.search(r'git\\s+checkout\\s+--', command_str) or re.search(r'git\\s+restore\\b', command_str):\n112:         return True, \"Destructive 'git checkout --' / 'git restore' is prohibited (Rule 12)\", \"RULE_12_GIT_CHECKOUT_REVERT\"\n113: \n114:     # Rule 13: rsync --delete\n115:     if re.search(r'rsync\\b.*--delete', command_str):\n116:         return True, \"Destructive 'rsync --delete' is prohibited (Rule 13)\", \"RULE_13_RSYNC_DELETE\"\n117: \n118:     # Rule 8 & 9: Redirection file truncation (e.g. > file, >> file if