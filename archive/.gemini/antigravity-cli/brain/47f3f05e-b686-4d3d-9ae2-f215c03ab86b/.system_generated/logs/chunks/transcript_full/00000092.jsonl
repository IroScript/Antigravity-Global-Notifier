base = cmd.split('/')[-1]\n156: \n157:         # Rule 1 & 2: Direct removal\n158:         if cmd_base in ['rm', 'rmdir', 'unlink']:\n159:             return True, f\"Direct deletion command '{cmd_base}' is strictly prohibited. Use safe_archive instead (Rule 1, 2)\", \"RULE_1_2_DIRECT_DELETE\"\n160: \n161:         # Rule 23: Truncation\n162:         if cmd_base in ['truncate', 'fallocate']:\n163:             return True, f\"File truncation command '{cmd_base}' is prohibited (Rule 9, 23)\", \"RULE_9_23_TRUNCATE\"\n164: \n165:         # Rule 26: Privilege escalation\n166:         if cmd_base in ['sudo', 'su', 'pkexec', 'doas']:\n167:             return True, f\"Privilege escalation via '{cmd_base}' is prohibited for AGY (Rule 26, 27)\", \"RULE_26_27_PRIV_ESCALATION\"\n168: \n169:         # Rule 4: xargs rm\n170:         if cmd_base == 'xargs' and any(t.split('/')[-1] == 'rm' for t in tokens):\n171:             return True, \"Indirect deletion via 'xargs rm' is prohibited (Rule 4)\", \"RULE_4_XARGS_RM\"\n172: \n173:         # Rule 15: chmod -R 000 / chmod 000\n174:         if cmd_base == 'chmod' and ('000' in tokens or '-R' in tokens and any(x in tokens for x in ['000', '-w'])):\n175:             return True, \"Destructive chmod permission removal is prohibited (Rule 15)\", \"RULE_15_CHMOD_STRIP\"\n176: \n177:         # Rule 6, 7 & 14: mv / cp overwriting protected path\n178:         if cmd_base == 'mv' and len(tokens) >= 3:\n179:             dest = tokens[-1].strip('\"\\'')\n180:             if os.path.exists(dest) and is_path_protected_config(dest):\n181:                 return True, f\"Destructive mv overwrite targeting protected path '{dest}' is prohibited (Rule 6, 7, 14)\", \"RULE_6_7_14_MV_OVERWRITE\"\n182: \n183:     return False, \"Safe\", \"ALLOW\"\n184: \n185: def main():\n186:     try:\n187:         raw_input = sys.stdin.read()\n188:         if not raw_input.strip():\n189:             print(json.dumps({\"decision\": \"allow\"}))\n190:             return\n191: \n192:         payload = json.loads(raw_input)\n193:     except Exception as e:\n194:         # Fail closed on malformed input (Point 6 of safety principles)\n195:         err_msg = f\"Failed to parse hook payload: {e}\"\n196:         print(json.dumps({\n197:             \"decision\": \"deny\",\n198:             \"reason\": f\"🛑 [DELETE-PROOF FAIL-CLOSED] {err_msg}\"\n199:         }))\n200:         return\n201: \n202:     tool_call = payload.get(\"toolCall\", {})\n203:     tool_name = tool_call.get(\"name\", \"\")\n204:     args = tool_call.get(\"args\", {})\n205: \n206:     # 1. RUN_COMMAND\n207:     if tool_name == \"run_command\":\n208:         cmd_line = args.get(\"CommandLine\", \"\")\n209:         is_dest, reason, rule_id = inspect_command(cmd_line)\n210:         if is_dest:\n211:             inc = log_incident(tool_name, {\"CommandLine\": cmd_line}, reason, rule_id)\n212:             print(json.dumps({\n213:                 \"decision\": \"deny\",\n214:                 \"reason\": f\"🛑 [DELETE-PROOF HARD DENIAL: {rule_id}] {reason}. Inc-ID: {inc['incident_id']}.\"\n215:             }))\n216:             return\n217: \n218:     # 2. WRITE_TO_FILE\n219:     elif tool_name == \"write_to_file\":\n220:         target_file = args.get(\"TargetFile\", \"\")\n221:         overwrite = args.get(\"Overwrite\", False)\n222:         \n223:         # Check against protected configs, policies, and archive (Rule 35, 38)\n224:         if is_path_protected_config(target_file):\n225:             reason = f\"Overwriting protected system/policy/archive target '{target_file}' is strictly prohibited (Rule 35, 38)\"\n226:             inc = log_incident(tool_name, {\"TargetFile\": target_file, \"Overwrite\": overwrite}, reason, \"RULE_38_POLICY_TAMPERING\")\n227:             print(json.dumps({\n228:                 \"decision\": \"deny\",\n229:                 \"reason\": f\"🛑 [DELETE-PROOF HARD DENIAL: RULE_38] {reason}. Inc-ID: {inc['incident_id']}.\"\n230:             }))\n231:             return\n232: \n233:     # 3. REPLACE_FILE_CONTENT\n234:     elif tool_name == \"replace_file_content\":\n235:         target_file = args.get(\"TargetFile\", \"\")\n236:         if is_path_protected_config(target_file):\n237:             reason = f\"Modifying protected system/policy/archive target '{target_file}' via replace_file_content is strictly prohibited (Rule 35, 38)\"\n238:             inc = log_incident(tool_name, {\"TargetFile\": target_file}, reason, \"RULE_38_POLICY_TAMPERING\")\n239:             print(json.dumps({\n240:                 \"decision\": \"deny\",\n241:                 \"reason\": f\"🛑 [DELETE-PROOF HARD DENIAL: RULE_38] {reason}. Inc-ID: {inc['incident_id']}.\"\n242:             }))\n243:             return\n244: \n245:     # Default Allow for verified non-destructive actions\n246:     print(json.dumps({\"decision\": \"allow\"}))\n247: \n248: if __name__ == \"__main__\":\n249:     main()\n250: \nThe above content shows the entire, complete file contents of the requested file.\n"}
