,\n        pointBackgroundColor: '#f0883e',\n        pointBorderColor: '#ffffff',\n        pointBorderWidth: 1.5,\n        pointHoverRadius: 5\n      },\n      {\n        label: 'শীর্ষ ১ অ্যাপ CPU %',\n        data: historyData.map(p => p.app1 ? p.app1.cpu : 0),\n        borderColor: '#58a6ff',\n        borderWidth: 1.6,\n        borderDash: [4, 4],\n        tension: 0.25,\n        pointRadius: pointRadiusFn,\n        pointBackgroundColor: '#58a6ff',\n        pointBorderColor: '#ffffff',\n        pointBorderWidth: 1.5,\n        pointHoverRadius: 4\n      }\n    ];\n  } else if (currentMode === 'ram') {\n    return [\n      {\n        label: 'সার্বিক RAM (GB)',\n        data: historyData.map(p => p.ram_gb),\n        borderColor: '#58a6ff',\n        backgroundColor: 'rgba(88, 166, 255, 0.12)',\n        borderWidth: 2.2,\n        tension: 0.25,\n        fill: true,\n        pointRadius: pointRadiusFn,\n        pointBackgroundColor: '#58a6ff',\n        pointBorderColor: '#ffffff',\n        pointBorderWidth: 1.5,\n        pointHoverRadius: 5\n      }\n    ];\n  } else {\n    return [\n      {\n        label: 'সার্বিক CPU %',\n        data: historyData.map(p => p.cpu),\n        borderColor: '#f0883e',\n        borderWidth: 2,\n        tension: 0.25,\n        pointRadius: pointRadiusFn,\n        pointBackgroundColor: '#f0883e',\n        pointBorderColor: '#ffffff',\n        pointBorderWidth: 1.5,\n        pointHoverRadius: 5\n      },\n      {\n        label: 'সার্বিক RAM %',\n        data: historyData.map(p => p.ram_pct),\n        borderColor: '#58a6ff',\n        borderWidth: 2,\n        tension: 0.25,\n        pointRadius: pointRadiusFn,\n        pointBackgroundColor: '#58a6ff',\n        pointBorderColor: '#ffffff',\n        pointBorderWidth: 1.5,\n        pointHoverRadius: 5\n      }\n    ];\n  }\n}\n\nfunction renderChart() {\n  if (typeof Chart === 'undefined') {\n    setTimeout(renderChart, 300);\n    return;\n  }\n  const chartEl = document.getElementById('resourceChart');\n  if (!chartEl) return;\n  const ctx = chartEl.getContext('2d');\n  if (!historyData || historyData.length === 0) return;\n  const labels = historyData.map(p => p.t);\n  const datasets = getDatasetsForCurrentMode();\n\n  if (chartInstance) {\n    chartInstance.data.labels = labels;\n    chartInstance.data.datasets = datasets;\n    applyMonitorYAxisScale();\n    chartInstance.update('none');\n    return;\n  }\n\n  chartInstance = new Chart(ctx, {\n    type: 'line',\n    data: {\n      labels: labels,\n      datasets: datasets\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      animation: false,\n      animations: {\n        colors: false,\n        x: false\n      },\n      transitions: {\n        active: { animation: { duration: 0 } },\n        resize: { animation: { duration: 0 } }\n      },\n      interaction: {\n        mode: 'index',\n        intersect: false\n      },\n      plugins: {\n        legend: {\n          display: true,\n          position: 'top',\n          labels: {\n            color: '#8b949e',\n            boxWidth: 10,\n            font: { size: 10 }\n          }\n        },\n        tooltip: {\n          enabled: false,\n          external: function(context) {\n            const tooltipModel = context.tooltip;\n            if (!tooltipModel || tooltipModel.opacity === 0) {\n              return;\n            }\n            if (tooltipModel.dataPoints && tooltipModel.dataPoints.length > 0) {\n              const idx = tooltipModel.dataPoints[0].dataIndex;\n              const pt = historyData[idx];\n              if (pt) updateGraphReport(pt, true);\n            }\n          }\n        }\n      },\n      scales: {\n        x: {\n          grid: { color: 'rgba(48, 54, 61, 0.4)' },\n          ticks: {\n            color: '#8b949e',\n            maxTicksLimit: 6,\n            font: { size: 9 }\n          }\n        },\n        y: getMonitorYAxisConfig()\n      },\n      events: ['mousemove', 'mouseout'