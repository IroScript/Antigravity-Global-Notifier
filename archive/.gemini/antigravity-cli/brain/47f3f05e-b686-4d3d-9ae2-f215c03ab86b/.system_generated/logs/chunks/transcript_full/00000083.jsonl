toryData.map(p => p.app2 ? p.app2.ram_gb : 0),\n        borderColor: '#2ea043',\n        borderWidth: 1.4,\n        borderDash: [2, 2],\n        tension: 0.3,\n        pointRadius: 0,\n        pointHoverRadius: 4\n      }\n    ];\n  } else {\n    // Both CPU and RAM\n    return [\n      {\n        label: 'সার্বিক CPU %',\n        data: historyData.map(p => p.cpu),\n        borderColor: '#f0883e',\n        borderWidth: 2,\n        tension: 0.3,\n        pointRadius: 0,\n        pointHoverRadius: 5\n      },\n      {\n        label: 'সার্বিক RAM %',\n        data: historyData.map(p => p.ram_pct),\n        borderColor: '#58a6ff',\n        borderWidth: 2,\n        tension: 0.3,\n        pointRadius: 0,\n        pointHoverRadius: 5\n      }\n    ];\n  }\n}\n\nfunction renderChart() {\n  if (typeof Chart === 'undefined') {\n    setTimeout(renderChart, 300);\n    return;\n  }\n  const chartEl = document.getElementById('resourceChart');\n  if (!chartEl) return;\n  const ctx = chartEl.getContext('2d');\n  if (!historyData || historyData.length === 0) return;\n  const labels = historyData.map(p => p.t);\n  const datasets = getDatasetsForCurrentMode();\n\n  if (chartInstance) {\n    chartInstance.data.labels = labels;\n    chartInstance.data.datasets = datasets;\n    chartInstance.update();\n    return;\n  }\n\n  chartInstance = new Chart(ctx, {\n    type: 'line',\n    data: {\n      labels: labels,\n      datasets: datasets\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      interaction: {\n        mode: 'index',\n        intersect: false\n      },\n      plugins: {\n        legend: {\n          display: true,\n          position: 'top',\n          labels: {\n            color: '#8b949e',\n            boxWidth: 10,\n            font: { size: 10 }\n          }\n        },\n        tooltip: {\n          enabled: false,\n          external: function(context) {\n            const tooltipModel = context.tooltip;\n            if (!tooltipModel