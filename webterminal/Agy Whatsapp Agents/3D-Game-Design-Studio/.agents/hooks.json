{
  "truth-lock": {
    "PreInvocation": [
      { "type": "command", "command": "/usr/bin/python3 /home/azureuser/.agy_truthlock/truthlock.py pre", "timeout": 5 }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "/usr/bin/python3 /home/azureuser/.agy_truthlock/truthlock.py post", "timeout": 5 } ] }
    ],
    "Stop": [
      { "type": "command", "command": "/usr/bin/python3 /home/azureuser/.agy_truthlock/truthlock.py stop", "timeout": 10 }
    ]
  }
}
