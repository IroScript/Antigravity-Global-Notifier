[Unit]
Description=Antigravity WhatsApp Bridge Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/flock -n %h/.webterminal/whatsapp_bridge.lock /usr/bin/node %h/.webterminal/whatsapp_bridge.js
Restart=always
RestartSec=5
StandardOutput=append:%h/.webterminal/whatsapp.log
StandardError=append:%h/.webterminal/whatsapp.log
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/.npm-global/bin
Environment=TMPDIR=%h/tmp
WorkingDirectory=%h

[Install]
WantedBy=default.target
